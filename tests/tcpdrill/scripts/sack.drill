# tcpdrill, RFC 2018 selective acknowledgment, receive side.
#
# The stack generates SACK; it does not process the blocks a peer sends it.
# So every case here is about what leaves: the option on the SYN, the option
# on an acknowledgement that leaves a hole, and the data offset that says
# where each of them ends.
#
# hdrlen IS ASSERTED ON EVERY CASE THAT CHANGES IT.  The data offset field is
# what tells the peer where the payload starts, and it is the one thing a
# capture is worst at catching: a segment with a wrong offset still has a
# valid checksum, still arrives, and is simply read from the wrong byte.
#
# `hdrlen=auto` and not a number.  The option area is what the build and the
# negotiation between them produce, so the number is one too: 20 with no
# options, 28 for a SYN whose area is the fixed two words, 32 for one SACK
# block and 8 more for each after it -- and 12 more again on a connection that
# settled the RFC 7323 timestamp, and 4 more on a SYN that also carried the
# window scale.  Written out, every SYN line here said 28 and went on saying it
# through the day timestamps started shipping and our SYN became 40 bytes.
#
# Sequence numbers in `sack=` are offsets from the ISN this harness chose,
# the same space `ack=` counts in, because the blocks describe data the peer
# sent.  `sack=-` requires no SACK option at all.
#
# ---------------------------------------------------------------------------

# RFC 2018 section 2: SACK-Permitted (kind 4, length 2) goes on the SYN.  It
# replaces padding, so the SYN is the same size it was.
case s01_syn_offers_sack_permitted
socket
connect
tx S seq=0 mss=1460 sackok=1 hdrlen=auto

# RFC 2018 section 2: a SYN+ACK repeats the offer only when the peer's SYN
# made one.  This is the half that must be conditional.
case s02_syn_ack_repeats_the_peers_offer
localport 4714
listen
rx S seq=0 win=8192 mss=1460 sackok=1
tx SA seq=0 ack=1 mss=1460 sackok=1 hdrlen=auto
rx A seq=1 ack=1
accept

# The same, from a peer that said nothing.  A SYN+ACK offering SACK to a peer
# that did not ask for it would have both ends believing different things
# about the option, which RFC 2018 section 2 forbids.
case s03_syn_ack_silent_when_the_peer_was
localport 4715
listen
rx S seq=0 win=8192 mss=1460
tx SA seq=0 ack=1 mss=1460 sackok=0 hdrlen=auto
rx A seq=1 ack=1
accept

# THE OPTION COSTS NOTHING WHEN THERE IS NOTHING TO SAY.  An acknowledgement
# covering everything the socket holds carries no blocks and no option, so an
# in-order stream sends exactly the headers it sent before.
case s04_in_order_acknowledgement_has_no_options
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1 hdrlen=auto
rx PA seq=1 ack=1 len=1460
tx A seq=1 ack=1461 sack=- hdrlen=auto within=400
recv 2000 = 1460

# RFC 2018 section 3, the whole point: one hole, one block.  The
# acknowledgement stays at the left edge of the hole, that part is o01 --
# and the block says what is being held above it, so the peer retransmits
# 100 bytes rather than everything it has sent.
case s05_one_hole_is_one_block
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=101:201 hdrlen=auto within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=201 sack=- hdrlen=auto within=400
recv 400 = 200

# NO PERMISSION, NO BLOCKS.  The same shape as s05 against a peer whose
# SYN+ACK said nothing: the hole is still held and still acknowledged, but
# describing it in an option the peer never agreed to would be a segment it
# is entitled to discard.
case s06_no_blocks_without_permission
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=- hdrlen=auto within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=201 within=400
recv 400 = 200

# Segments that touch are one block, not two.  The receive queue holds them
# separately; the option describes the sequence space, which is contiguous.
case s07_adjacent_segments_are_one_block
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=101:201 hdrlen=auto within=400
rx PA seq=201 ack=1 len=100
tx A seq=1 ack=1 sack=101:301 hdrlen=auto within=400

# RFC 2018 section 4: THE FIRST BLOCK IS THE ONE HOLDING THE SEGMENT THAT
# TRIGGERED THIS ACKNOWLEDGEMENT.  Two holes, the second one higher, so the
# most recent block is also the highest and any ordering that happens to sort
# by sequence number passes this.  s09 is the one that does not.
case s08_two_holes_most_recent_first
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=101:201 within=400
rx PA seq=301 ack=1 len=100
tx A seq=1 ack=1 sack=301:401,101:201 hdrlen=auto within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=201 sack=301:401 hdrlen=auto within=400
rx PA seq=201 ack=1 len=100
tx A seq=1 ack=401 sack=- hdrlen=auto within=400
recv 500 = 400

# THE SAME RULE WHERE SORTING BY SEQUENCE NUMBER GETS IT WRONG.  The higher
# hole is opened first, then a segment lands in the lower one.  The most
# recent block is now the LOWER of the two and must still come first: a
# sender reads the first block as the news, and telling it about the block it
# was told about last time is not news.
case s09_recent_block_first_even_when_lower
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=401 ack=1 len=100
tx A seq=1 ack=1 sack=401:501 within=400
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=101:201,401:501 hdrlen=auto within=400

# THE BOUND.  Four blocks is 36 of the 40 bytes an option area has, so a
# fifth hole cannot be reported and something has to go.  The most recent
# block leads, and the block dropped is the LOWEST: it is the one nearest the
# cumulative acknowledgement, which is about to move over it anyway.
case s10_four_blocks_is_the_bound
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=101:201 hdrlen=auto within=400
rx PA seq=301 ack=1 len=100
tx A seq=1 ack=1 sack=301:401,101:201 hdrlen=auto within=400
rx PA seq=501 ack=1 len=100
tx A seq=1 ack=1 sack=501:601,301:401,101:201 hdrlen=auto within=400
rx PA seq=701 ack=1 len=100
tx A seq=1 ack=1 sack=701:801,501:601,301:401,101:201 hdrlen=auto within=400
rx PA seq=901 ack=1 len=100
tx A seq=1 ack=1 sack=901:1001,701:801,501:601,301:401 hdrlen=auto within=400

# A BLOCK CLOSED BY ARRIVING DATA STOPS BEING A BLOCK.  Filling the hole from
# the left leaves the block whose data is now in sequence out of the option
# entirely, rather than reporting sequence space the cumulative
# acknowledgement already covers, which RFC 2018 section 4 says a block
# must never do.
case s11_filled_hole_leaves_the_option
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=201 ack=1 len=100
tx A seq=1 ack=1 sack=201:301 hdrlen=auto within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=101 sack=201:301 hdrlen=auto within=400
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=301 sack=- hdrlen=auto within=400
recv 400 = 300

# A DUPLICATE SEGMENT ARRIVING BEHIND A HOLE IS STILL ACKNOWLEDGED, AND THE
# ACKNOWLEDGEMENT STILL DESCRIBES THE HOLE.  This is the acknowledgement RFC
# 5681 section 3.2 counts towards fast retransmit, so it is the one that must
# not come out bare.
case s12_duplicate_behind_a_hole_still_reports_it
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=1460 sackok=1
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 sack=101:201 hdrlen=auto within=400
rx PA seq=101 ack=1 len=100
# The second arrival of 101:201 is a duplicate of a range already reported,
# which RFC 2883 section 4 says to lead with as a D-SACK block, so the hole
# is reported twice over, once as the duplicate and once as the block still
# covering it.  dsack.drill d03 is where that pairing is pinned down; what
# this case still asserts is that the ordinary block does not go missing.
tx A seq=1 ack=1 sack=101:201,101:201 hdrlen=auto within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=201 sack=- within=400
recv 400 = 200

# ---------------------------------------------------------------------------
# THE SEND SIDE.  Everything above this line is about the blocks that LEAVE.
#
# The twelve cases above assert what we tell a peer about our own holes, and
# they pass whether or not a block a peer sends is ever read -- which it was
# not, for the whole life of this file.  The SACK-Permitted option went out on
# every SYN and nothing honoured what came back, so a receive recovered from a
# hole in one round trip while a send still did one segment per round trip
# with the peer believing it had said where the holes were.
#
# These two need the harness to SEND blocks, which it could not do until the
# same change added it: `sack=` on an `rx` line is an injection, and the
# blocks count in the space our own `seq=` counts in, because they describe
# data this side sent.
#
# MSS 100 ON THE PEER'S SYN+ACK is what makes each `send 100` exactly one
# segment, so "which segment was skipped" is a question the capture can
# answer.

# RFC 2018 section 4: data a block covers is not retransmitted.  Three
# segments go out, the peer acknowledges none of them and says it holds the
# middle one, and the retransmission must therefore carry the first and the
# third and not the second.
#
# THIS CASE IS RED, DELIBERATELY, AND IT IS THE POINT OF THE FILE'S SECOND
# HALF.  The stack retransmits 1:101 and stops: it never sends 201:301, so
# `tx PA seq=201` times out.  Measured on 2026-08-11 both without the send
# side and with fork branch amiga-tcp-sack-transmit-merged
# (netxduo ec4fd9cc) built in, byte for byte the same both times, with
# _nx_tcp_sack_option_get present in libnetxduo.a on the second.
#
# So the branch does not do what it says on the case that matters, and this
# is the case docs/BACKLOG.md asked for before it could land.  What has NOT
# been established is which of the two is wrong -- the branch, or this case's
# assumption that three duplicate acknowledgments at MSS 100 put the socket
# into fast recovery at all.  Instrumenting the guest to tell them apart
# needs serial output the tcpdrill runs do not currently produce.
#
# Do not delete this case to make the file green.  Its failure is the finding.
case s13_a_block_makes_the_retransmission_skip_that_segment
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=100 sackok=1
tx A seq=1 ack=1
send 100
tx PA seq=1 ack=1 len=100
send 100
tx PA seq=101 ack=1 len=100
send 100
tx PA seq=201 ack=1 len=100
# Three duplicate acknowledgements, each carrying the same block: the peer has
# 101:201 and is missing 1:101.  RFC 5681 section 3.2 counts these.
rx A seq=1 ack=1 win=8192 sack=101:201
rx A seq=1 ack=1 win=8192 sack=101:201
rx A seq=1 ack=1 win=8192 sack=101:201
# The hole first, then past it to the segment the peer never mentioned.
tx PA seq=1 ack=1 len=100 within=4000
tx PA seq=201 ack=1 len=100 within=4000
rx R seq=1 ack=1

# AND THE SKIP IS CONDITIONAL.  The same three segments and the same three
# duplicate acknowledgements with no blocks on them: nothing says which
# segment the peer holds, so the stack may only retransmit the first and must
# not walk the queue.  Without this case the change could retransmit
# everything every time and s13 would still pass.
case s14_no_blocks_still_retransmits_only_the_first
socket
connect
tx S seq=0 mss=1460 sackok=1
rx SA seq=0 ack=1 win=8192 mss=100 sackok=1
tx A seq=1 ack=1
send 100
tx PA seq=1 ack=1 len=100
send 100
tx PA seq=101 ack=1 len=100
rx A seq=1 ack=1 win=8192
rx A seq=1 ack=1 win=8192
rx A seq=1 ack=1 win=8192
tx PA seq=1 ack=1 len=100 within=4000
notx 600
rx R seq=1 ack=1
