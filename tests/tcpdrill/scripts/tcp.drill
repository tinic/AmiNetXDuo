# tcpdrill, the first set of cases.
#
# Read this as a specification, because that is what it is: every line says
# either what the application asked for or what must appear on the wire, and a
# failure prints the line next to what actually happened.
#
# Conventions
#   * seq/ack are OFFSETS.  Ours count from our own initial sequence number,
#     which the harness learns from the first SYN it sees; the peer's count
#     from the ISN the harness chose.  No script contains a number the stack
#     picked, so nothing here is a snapshot of current behaviour.
#   * the advertised window is bounded, never fixed: docs/RESEARCH.md 24 makes
#     it pool-derived and divided by the live socket count, so an exact number
#     would be a test of how many sockets the previous case left behind.
#   * `after`/`within` are milliseconds, measured from the E-Clock reading the
#     device takes inside BeginIO.
#
# ---------------------------------------------------------------------------

# The window first, before any case has left a socket behind.  RESEARCH 24.3:
# a lone socket on the 8 MB profile gets the ceiling, and nothing may ever come
# out below the floor.
#
# The bounds come from the build, not from this file.  $synwin is the ceiling
# capped at 65535, because RFC 7323 2.2 says the window in a SYN is never
# scaled: a build whose ceiling is 98304 correctly puts 65535 here, and the
# 33580 this line used to carry failed on that behaviour rather than on a
# defect.
case w01_advertised_window_in_bounds
socket
connect
tx S seq=0 winmin=$winfloor winmax=$synwin mss=1460

# RFC 793 3.4: three-way handshake, and our ACK carries the peer's ISN + 1.
case c01_active_open
socket
connect
tx S seq=0 mss=1460
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
writable 1
readable 0

# RFC 1122 4.2.2.6: the MSS offered is the interface MTU less 40.  1500 - 40.
case c02_syn_offers_mss
socket
connect
tx S seq=0 mss=1460

# RFC 793 3.5: a close with everything acknowledged is a FIN, not a RESET.
# docs/RESEARCH.md 16.9 observed a RESET here in every capture ever taken, and
# 27.6 put the packet next to it.  The rest of the case is the four-way close
# it opens: our FIN is acknowledged, the peer sends its own, and we acknowledge
# that, which is also what keeps this case from leaving a FIN retransmitting
# into the next one.
case c03_close_sends_fin
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
close
tx FA seq=1 ack=1
rx A seq=1 ack=2
rx FA seq=1 ack=2
tx A seq=2 ack=2

# RFC 1122 4.2.2.13 / POSIX: shutdown(SHUT_WR) is a FIN and nothing else.
case c04_shutdown_wr_sends_fin
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
shutdown wr
tx FA seq=1 ack=1
rx A seq=1 ack=2

# The peer half-closes.  We acknowledge the FIN, recv() reports end of file,
# and the socket stays writable because only one direction shut.
case c05_peer_fin_half_close
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx FA seq=1 ack=1
tx A seq=1 ack=2
recv 100 = EOF
readable 1
writable 1
send 50
tx PA seq=1 ack=2 len=50

# An established connection with nothing in it is NOT readable.  This is the
# defect docs/RESEARCH.md names fourth, stated as an assertion.
case c06_idle_is_not_readable
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
readable 0
recv 100 = AGAIN

# RFC 793 3.4: a SYN to a port nobody listens on is answered RST|ACK.
case r01_syn_to_closed_port
localport 4711
rx S seq=0 win=8192 mss=1460
tx RA seq=0 ack=1

# RFC 793 3.4: a non-SYN segment to a closed port is answered with a bare RST
# whose sequence number is the segment's acknowledgement number.
case r02_data_to_closed_port
localport 4712
rx PA seq=1 ack=1 len=10
tx R seq=1

# RFC 1122 4.2.3.2: acknowledge AT LEAST every second full-sized segment.
# "At least" is a floor, not a schedule, acknowledging both is conformant,
# and is what this stack does, so each segment gets its own expectation and the
# transcript records which of the two behaviours was seen.
case a01_ack_every_second_segment
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PA seq=1 ack=1 len=1460
tx A seq=1 ack=1461 within=400
rx PA seq=1461 ack=1 len=1460
tx A seq=1 ack=2921 within=400
recv 4000 = 2920

# RFC 1122 4.2.3.2: a lone segment is acknowledged by the delayed-ACK timer,
# which docs/RESEARCH.md 16.6 measures at 200 ms on the 50 Hz tick.
case a02_delayed_ack_timer
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=101 after=100 within=400

# RFC 6298 5.5: back off the retransmission timer on every retransmission.
# The connection request is the cheapest place to watch it happen.
case x01_syn_retransmission_backs_off
socket
connect
tx S seq=0 within=200
tx S seq=0 after=700 within=1500
tx S seq=0 after=1500 within=3000

# RFC 793 3.7: UNACKNOWLEDGED DATA IS RETRANSMITTED.  Nothing acknowledges, so
# every segment after the first is a retransmission of it.
#
# This is the case docs/RESEARCH.md 27.4 found sending exactly one segment and
# then nothing, ever, because the driver never handed the packet back and NetX
# Duo will only resend a packet it has been given back.
#
# ONLY THE FIRST INTERVAL IS ASSERTED, and only loosely.  What the intervals
# are, flat, doubling, and how many there are before the socket gives up --
# is the retransmission timer's business and x01 is where it is stated; this
# case is about whether anything comes back at all, so the rest is a count --
# and a wide one: four seconds of a doubling interval is one retransmission and
# four seconds of a flat one is eight, both measured.
case x02_data_is_retransmitted
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
send 100
tx PA seq=1 ack=1 len=100 within=200
tx PA seq=1 ack=1 len=100 after=700 within=1600
idle 4000
txcount 1 12

# RFC 793 3.7 / RFC 1122 4.2.2.17: a zero window stops the sender, and the
# sender must probe it rather than wait for ever.
case z01_zero_window_probe
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
send 100
tx PA seq=1 ack=1 len=100
rx A seq=1 ack=101 win=0
send 100 = AGAIN
notx 300
tx A seq=101 ack=1 len=1 within=6000

# BYTES ON THE WIRE MUST EQUAL BYTES send() ACCEPTED.
#
# nx_tcp_socket_send() is not all-or-nothing.  It segments to the peer's window
# inside its own loop, queues each segment as it goes, and keeps the ones it
# already sent when a later one will not fit, so a window that ends part-way
# through a segment is the one shape where what left and what send() admits to
# can differ.  They did: the sliver went out and only the whole segments before
# it were reported, and a caller doing the correct thing with a short send()
# put the sliver on the wire a second time.  A 512 KB file arrived 3888 bytes
# longer than it was.
#
# 1700 is deliberately not a multiple of the 1460-byte MSS: the first segment
# fills, the second is cut off at 240 bytes with 348 left over.
case z02_short_send_credits_what_left
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=1700 mss=1460
tx A seq=1 ack=1
send 2048 = SHORT
tx PA seq=1 ack=1 len=1460
tx PA seq=1461 ack=1 len=240
wirebytes

# The same fault with nothing in front of it to hide it.  The window is
# narrower than one segment, so every byte that leaves is part of a cut segment
# and there is no completed chunk to report, this is the send() that used to
# answer EWOULDBLOCK having already put 1000 bytes on the wire.
case z03_send_below_one_segment_is_credited
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=1000 mss=1460
tx A seq=1 ack=1
send 2048 = SHORT
tx PA seq=1 ack=1 len=1000
wirebytes

# The mechanism behind x02, stated as the thing that must NOT be true.
#
# It used to take a later transmit on the same interface to release the earlier
# packet, so the retransmission of the first segment arrived 917 ms after a
# send() the application happened to make and never otherwise.  Here nothing
# else is sent: the first segment must come back on its own, and only then does
# a second send() go out, in the right order, behind the retransmission that
# was already due.
case x03_retransmission_needs_no_later_send
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
send 100
tx PA seq=1 ack=1 len=100 within=200
tx PA seq=1 ack=1 len=100 after=700 within=1600
notx 400
send 100
tx PA seq=101 ack=1 len=100 within=400

# ELEVEN SECONDS.  This case used to assert eleven seconds of TOTAL SILENCE
# after one unacknowledged segment, and pass, which docs/RESEARCH.md 27.4
# calls the worst green line in the section.  It now asserts the opposite, over
# the same eleven seconds, and the range is wide on purpose: how many
# retransmissions fit in eleven seconds depends on the interval and the retry
# count, and both of those belong to the retransmission timer rather than here.
# Three is what a doubling interval manages; eleven is what a flat second can.
case x04_eleven_seconds_of_trying
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
send 100
tx PA seq=1 ack=1 len=100 within=200
idle 11000
txcount 3 11

# RFC 793 3.9: an out-of-order segment is held, and the acknowledgement stays
# at the left edge of the hole until the hole is filled.
case o01_out_of_order_fills
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PA seq=101 ack=1 len=100
tx A seq=1 ack=1 within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=201 within=400
recv 400 = 200

# RFC 793 3.9: a segment received twice is acknowledged twice and delivered
# once.
case o02_duplicate_segment
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=101 within=400
rx PA seq=1 ack=1 len=100
tx A seq=1 ack=101 within=400
recv 400 = 100

# RFC 1122 4.2.2.4: the urgent pointer points at the byte AFTER the urgent
# data.  docs/RESEARCH.md 17 records one deliberate divergence here, the
# urgent byte is also delivered in the ordinary stream, so with
# SO_OOBINLINE off the byte count below is what that divergence predicts.
case u01_urgent_inbound
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PAU seq=1 ack=1 len=4 urg=4
tx A seq=1 ack=5 within=400
recv 100 = 4

# RFC 793 3.4: a RESET on an established connection tears it down, and the
# stack must not answer a RESET with anything at all.
case r03_reset_tears_down
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx R seq=1
notx 200
recv 100 = 0

# Passive open: the whole handshake from the other side.
case c07_passive_open
localport 4713
listen
rx S seq=0 win=8192 mss=1460
tx SA seq=0 ack=1 mss=1460
rx A seq=1 ack=1
accept
readable 0
rx PA seq=1 ack=1 len=20
recv 100 = 20

# ---------------------------------------------------------------------------
# CloseSocket(), now that it is a FIN.  docs/RESEARCH.md 27.6 is the defect
# these came in with; c03 above is the headline and these are the corners.
# ---------------------------------------------------------------------------

# One FIN per connection.  A close after shutdown(SHUT_WR) has nothing left to
# send, the FIN already went, and must not send a second one, which would
# be a sequence number the peer has already acknowledged.
case c08_close_after_shutdown_wr_sends_one_fin
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
shutdown wr
tx FA seq=1 ack=1
rx A seq=1 ack=2
close within=200
notx 400
rx FA seq=1 ack=2
tx A seq=2 ack=2

# RFC 1122 4.2.2.13: a close with data still unread is an ABORT, because the
# peer must not be left believing data was delivered that is about to be
# thrown away.  This is the one place a RESET is the right answer, and it is
# what every BSD does.
case c09_close_with_unread_data_resets
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx PA seq=1 ack=1 len=50
tx A seq=1 ack=51 within=400
close within=200
tx R seq=1

# SO_LINGER with a zero timeout is the documented way to ask for an abortive
# close, and the option finally does that rather than choosing between two
# flavours of reset.
case c10_linger_zero_close_resets
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
opt linger 0
close within=200
tx R seq=1

# RFC 793 3.5, the passive close: the peer went first, so our FIN is the last
# one and there is no TIME_WAIT on this side at all.
case c11_close_in_close_wait_is_last_ack
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
rx FA seq=1 ack=1
tx A seq=1 ack=2
recv 100 = EOF
close within=200
tx FA seq=1 ack=2
rx A seq=2 ack=2
notx 400

# THE PEER NEVER ANSWERS.  CloseSocket() must still return at once, a program
# that closes and exits cannot be made to wait on a host that has gone away --
# and the connection, which now outlives the descriptor, retransmits its FIN on
# the stack's own time.
#
# LAST IN THE FILE ON PURPOSE.  It leaves a FIN retrying for about ten seconds,
# and there is nothing after it for those frames to turn up in.
case c12_close_does_not_wait_for_the_peer
socket
connect
tx S seq=0
rx SA seq=0 ack=1 win=8192 mss=1460
tx A seq=1 ack=1
close within=200
tx FA seq=1 ack=1 within=200
tx FA seq=1 ack=1 after=700 within=1600
