#
# DEVS:Internet/services -- standard /etc format, staged onto the test drive
# by tests/conformance/run-conformance.sh and tools/amiberry-run.sh.
#
#   <name>  <port>/<proto>  [alias...]
#
# Present so the on-Amiga netdb tests parse a real file instead of falling
# back to the table compiled into src/config/netdb.c.  Longer than that table
# on purpose -- a lookup that scans 90 entries rather than 30 is the one that
# would show up a bad terminator or an alias pool overrun.
#
# bsdsocktest requires: getservbyname("http","tcp") -> 80 (test 92),
# getservbyname("nonexistent_service_xyz","tcp") -> NULL (93),
# getservbyport(21,"tcp") -> "ftp" (94).
#
# Note the ordering constraint test 94 imposes: ami_netdb_serv_by_port()
# returns the FIRST entry whose port and protocol both match, so ftp-data must
# not be given port 21 and the tcp entry for a name must precede its udp twin
# wherever a reverse lookup is expected to name the tcp service.
#

