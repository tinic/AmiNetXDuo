#!/usr/bin/env bash
# Gate 1 of 4: refuse the commit locally. See tools/check-gates-wired.sh.
# SPDX-License-Identifier: MIT
set -eu
ROOT="$(git rev-parse --show-toplevel)"
# A commit whose whole diff is documentation is bookkeeping, not work.  Put
# the note in the commit that changes what it describes.
if [ -x "$ROOT/tools/check-doc-only.sh" ]; then
    if ! "$ROOT/tools/check-doc-only.sh"; then
        echo
        echo "pre-commit: nothing here but documentation.  Fold it into the"
        echo "commit that changes the code it is about.  A release commit sets"
        echo "AMINETXDUO_RELEASE_COMMIT=1."
        exit 1
    fi
fi

# src/bsdsocket/bsdsocket_vectors.[ch] are OUTPUT.  Editing them by hand still
# compiles, still links and still passes the host tier; the reproduce check
# lives in the cross stage, so the first thing that notices is a twelve minute
# CI cycle.  It costs a second here.
if [ -x "$ROOT/tools/check-generated.sh" ]; then
    if ! "$ROOT/tools/check-generated.sh"; then
        echo
        echo "pre-commit: a generated file was edited by hand.  Change"
        echo "tools/gen_vectors.py and regenerate; the .c and .h are output."
        exit 1
    fi
fi

# A change to the shipping surface states its changelog decision here, not in
# a reconstruction at release time.  0.26.6 was assembled by reading 201
# commits, and an installer that had been lying about DHCP for three weeks is
# what that found.
if [ -x "$ROOT/tools/check-changelog-entry.sh" ]; then
    if ! "$ROOT/tools/check-changelog-entry.sh"; then
        echo
        echo "pre-commit: this commit changes what ships and does not touch"
        echo "CHANGELOG.md.  Add the entry under Unreleased, or say why there"
        echo "is none:"
        echo
        echo "  AMINETXDUO_NO_CHANGELOG=\"refactor, identical objects\" git commit ..."
        exit 1
    fi
fi

[ -x "$ROOT/tools/check-changelog-prose.sh" ] || exit 0
if ! "$ROOT/tools/check-changelog-prose.sh"; then
    echo
    echo "pre-commit: CHANGELOG.md carries prose. Fix it, or state why in the"
    echo "commit and use --no-verify -- which CI and the release job will then"
    echo "both refuse, so it buys nothing."
    exit 1
fi
