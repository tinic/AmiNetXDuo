@node "main" "xircomce2.device Manual"

  @{b}@{u}xircomce2.device 1.1@{uu}@{ub} - A Xircom CreditCard Ethernet PC Card driver


    @{"Introduction" link "intro"}

    @{"Installation and Usage" link "install"}

    @{"Author and Legal Information" link "author-legal"}

