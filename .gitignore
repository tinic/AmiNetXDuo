# Python bytecode from the host-side test servers (tests/tools, tests/tls).
__pycache__/
*.pyc

# Third-party SANA-II drivers, cached under
# ~/.cache/aminetxduo, and a2065.device is brought in by hand; none of them are
# ours to redistribute, so nothing driver-shaped may be committed by accident.
*.device
*.lha
*.lzh
*.dms

# macOS
.DS_Store

# The staged installer drawer, written by dist/make-dist.sh into the tree root.
# Binaries and generated configuration, not sources; install/ holds the sources.
/C/
/Libs/
/Devs/
/Examples/
/Docs.info
/Examples.info
/Developer.info
/Developer/
/AmiNetXDuo.info
/Install-AmiNetXDuo
/Install-AmiNetXDuo.info
/Installer
/ReadMe
/ReadMe.info
docs/ReadMe
docs/ReadMe.info
developer/ReadMe.info
developer/include/aminetxduo/

# Guest scratch: a Workbench boot writes these when a redirect is mistyped
# into the Startup-sequence, and they are AmigaOS device names, not files.
NIL:*

# Generated by -DAMINETXDUO_TLS_LOCAL_ROOT: a lab CA, never shipped.
tests/tls/tls_root_local.h

# The bundler for httpd's terminal page.  package-lock.json IS committed -- it
# is what pins the version the drift check runs -- but what npm unpacks from it
# is not, and it is 10 MB of platform binaries.
tools/web/node_modules/
