Teach curl about a TLS backend called "amitls".

This is everything curl itself has to know; the backend is
clients/curl/amitls.c and clients/curl/amitls.h, which
clients/curl/build.sh -t copies into lib/vtls/ before applying this.
Six hunks in six files, and each is the same shape as the entry the
neighbouring backend already has:

  include/curl/curl.h        a CURLSSLBACKEND_* value
  lib/curl_setup.h           USE_AMITLS implies USE_SSL
  lib/vtls/vtls.c            the include, the default pick, the table
  lib/Makefile.inc           the source and header (CMake reads this)
  lib/curl_config-cmake.h.in the #cmakedefine
  CMakeLists.txt             the CURL_USE_AMITLS option

Nothing here is AmigaOS-specific and nothing here has to change when the
backend does.  Rebase it on the next pinned tag by hand; if a hunk stops
applying, the neighbouring RUSTLS line in the same file is the pattern.

SPDX-License-Identifier: curl
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index e459b3d..31fc578 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -740,13 +740,15 @@ cmake_dependent_option(CURL_USE_MBEDTLS "Enable mbedTLS for SSL/TLS" OFF CURL_EN
 cmake_dependent_option(CURL_USE_WOLFSSL "Enable wolfSSL for SSL/TLS" OFF CURL_ENABLE_SSL OFF)
 cmake_dependent_option(CURL_USE_GNUTLS "Enable GnuTLS for SSL/TLS" OFF CURL_ENABLE_SSL OFF)
 cmake_dependent_option(CURL_USE_RUSTLS "Enable Rustls for SSL/TLS (experimental)" OFF CURL_ENABLE_SSL OFF)
+cmake_dependent_option(CURL_USE_AMITLS "Enable AmiNetXDuo tls.library for SSL/TLS" OFF CURL_ENABLE_SSL OFF)
 
 if(WIN32 OR
    CURL_USE_SCHANNEL OR
    CURL_USE_MBEDTLS OR
    CURL_USE_WOLFSSL OR
    CURL_USE_GNUTLS OR
-   CURL_USE_RUSTLS)
+   CURL_USE_RUSTLS OR
+   CURL_USE_AMITLS)
   set(_openssl_default OFF)
 else()
   set(_openssl_default ON)
@@ -761,6 +763,7 @@ curl_count_true(_enabled_ssl_options_count
   CURL_USE_WOLFSSL
   CURL_USE_GNUTLS
   CURL_USE_RUSTLS
+  CURL_USE_AMITLS
 )
 if(_enabled_ssl_options_count GREATER 1)
   set(CURL_WITH_MULTI_SSL ON)
@@ -946,6 +949,17 @@ if(CURL_USE_GNUTLS)
   endif()
 endif()
 
+if(CURL_USE_AMITLS)
+  # No find_package: tls.library is a shared library opened by name at run
+  # time, so there is nothing to link and nothing to find at configure time.
+  set(_ssl_enabled ON)
+  set(USE_AMITLS ON)
+  # Without this the whole "CA handling" block below is skipped and a
+  # CURL_CA_BUNDLE passed on the command line reaches curl_config.h verbatim
+  # -- including the literal string "none", which curl then tries to open.
+  set(_curl_ca_bundle_supported TRUE)
+endif()
+
 if(CURL_USE_RUSTLS)
   find_package(Rustls MODULE REQUIRED)
   set(_ssl_enabled ON)
@@ -2093,6 +2107,7 @@ curl_add_if("mbedTLS"          _ssl_enabled AND USE_MBEDTLS)
 curl_add_if("wolfSSL"          _ssl_enabled AND USE_WOLFSSL)
 curl_add_if("GnuTLS"           _ssl_enabled AND USE_GNUTLS)
 curl_add_if("Rustls"           _ssl_enabled AND USE_RUSTLS)
+curl_add_if("tls.library"      _ssl_enabled AND USE_AMITLS)
 
 if(_items)
   list(SORT _items CASE INSENSITIVE)
diff --git a/include/curl/curl.h b/include/curl/curl.h
index 7e59e43..474e935 100644
--- a/include/curl/curl.h
+++ b/include/curl/curl.h
@@ -163,7 +163,8 @@ typedef enum {
   CURLSSLBACKEND_MBEDTLS = 11,
   CURLSSLBACKEND_MESALINK               CURL_DEPRECATED(7.82.0, "") = 12,
   CURLSSLBACKEND_BEARSSL                CURL_DEPRECATED(8.15.0, "") = 13,
-  CURLSSLBACKEND_RUSTLS = 14
+  CURLSSLBACKEND_RUSTLS = 14,
+  CURLSSLBACKEND_AMITLS = 15
 } curl_sslbackend;
 
 /* aliases for library clones and renames */
diff --git a/lib/Makefile.inc b/lib/Makefile.inc
index 266ba52..6e7c38b 100644
--- a/lib/Makefile.inc
+++ b/lib/Makefile.inc
@@ -85,6 +85,7 @@ LIB_VAUTH_HFILES =      \
   vauth/vauth.h
 
 LIB_VTLS_CFILES =           \
+  vtls/amitls.c             \
   vtls/apple.c              \
   vtls/cipher_suite.c       \
   vtls/gtls.c               \
@@ -103,6 +104,7 @@ LIB_VTLS_CFILES =           \
   vtls/x509asn1.c
 
 LIB_VTLS_HFILES =           \
+  vtls/amitls.h             \
   vtls/apple.h              \
   vtls/cipher_suite.h       \
   vtls/gtls.h               \
diff --git a/lib/curl_config-cmake.h.in b/lib/curl_config-cmake.h.in
index c38caa2..546eb34 100644
--- a/lib/curl_config-cmake.h.in
+++ b/lib/curl_config-cmake.h.in
@@ -670,6 +670,9 @@ ${SIZEOF_TIME_T_CODE}
 /* if Rustls is enabled */
 #cmakedefine USE_RUSTLS 1
 
+/* if AmiNetXDuo tls.library is in use */
+#cmakedefine USE_AMITLS 1
+
 /* if wolfSSL is enabled */
 #cmakedefine USE_WOLFSSL 1
 
diff --git a/lib/curl_setup.h b/lib/curl_setup.h
index 861e076..078f55f 100644
--- a/lib/curl_setup.h
+++ b/lib/curl_setup.h
@@ -731,7 +731,8 @@
 #endif
 
 #if defined(USE_GNUTLS) || defined(USE_OPENSSL) || defined(USE_MBEDTLS) || \
-  defined(USE_WOLFSSL) || defined(USE_SCHANNEL) || defined(USE_RUSTLS)
+  defined(USE_WOLFSSL) || defined(USE_SCHANNEL) || defined(USE_RUSTLS) || \
+  defined(USE_AMITLS)
 #define USE_SSL    /* SSL support has been enabled */
 #endif
 
diff --git a/lib/vtls/vtls.c b/lib/vtls/vtls.c
index 82ce007..f529d96 100644
--- a/lib/vtls/vtls.c
+++ b/lib/vtls/vtls.c
@@ -58,6 +58,7 @@
 #include "vtls/schannel.h"       /* Schannel SSPI version */
 #include "vtls/mbedtls.h"        /* mbedTLS versions */
 #include "vtls/rustls.h"         /* Rustls versions */
+#include "vtls/amitls.h"         /* AmiNetXDuo tls.library */
 
 #include "slist.h"
 #include "curl_trc.h"
@@ -697,6 +698,8 @@ const struct Curl_ssl *Curl_ssl =
   &Curl_ssl_mbedtls;
 #elif defined(USE_RUSTLS)
   &Curl_ssl_rustls;
+#elif defined(USE_AMITLS)
+  &Curl_ssl_amitls;
 #elif defined(USE_OPENSSL)
   &Curl_ssl_openssl;
 #elif defined(USE_SCHANNEL)
@@ -723,6 +726,9 @@ static const struct Curl_ssl *available_backends[] = {
 #endif
 #ifdef USE_RUSTLS
   &Curl_ssl_rustls,
+#endif
+#ifdef USE_AMITLS
+  &Curl_ssl_amitls,
 #endif
   NULL
 };
