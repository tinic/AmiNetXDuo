{
  "name": "aminetxduo-web",
  "private": true,
  "version": "0.0.0",
  "description": "Bundler for httpd's self-contained browser pages. xterm.js remains vendored under src/tools/web/vendor.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:files": "node build-files.mjs",
    "check": "node build.mjs --check",
    "typecheck": "tsc -p ../../src/tools/web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11"
  }
}
