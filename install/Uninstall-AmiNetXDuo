; ==========================================================================
;
;  AmiNetXDuo -- Commodore Installer script that removes it again
;
;  Install-AmiNetXDuo leaves S:AmiNetXDuo-Files, an AmigaDOS script that
;  deletes what it installed where that is unchanged since, puts back what
;  it replaced of another stack (from the AmiNetXDuo drawer's Backup), and
;  removes that drawer when nothing else is in it.  This script removes the
;  S:User-Startup block and the Wi-Fi and firmware files, runs that record,
;  and says what it kept.
;
;  SPDX-License-Identifier: MIT
;
; ==========================================================================

(set APPNAME "AmiNetXDuo")
(set REC     "S:AmiNetXDuo-Files")
(set WIFIREC "S:AmiNetXDuo-WiFi")
(set FWREC   "S:AmiNetXDuo-Firmware")

(if (NOT (exists REC (noreq)))
    (abort "There is no S:AmiNetXDuo-Files, the record Install-AmiNetXDuo "
           "writes of what it installed.\n\n"
           "Nothing was changed."))

(welcome "Removing AmiNetXDuo.")

; Asked at every level, Novice included.
(user 1)
(set GO
  (askbool
    (prompt "Remove AmiNetXDuo from this Amiga?\n\n"
            "Its files go, and what it replaced of another stack comes back.  "
            "AmiNetXDuo stops at the next reboot.")
    (help (cat "S:User-Startup loses AmiNetXDuo's lines.  The files the "
               "installer wrote are deleted where they are as it left them; "
               "one changed since stays.  Files of another stack that it "
               "replaced are put back from the AmiNetXDuo drawer's Backup "
               "where nothing is in their place, and the drawer is removed "
               "when nothing else is in it.\n\n"
               "Another stack's files come back as they were before "
               "AmiNetXDuo was installed; that stack runs again after the "
               "reboot."))
    (choices "Yes, remove it" "No")
    (default 1)))
(user 0)

(if (= GO 0)
    (abort "AmiNetXDuo is still installed.\n\nNothing was changed."))

(complete 0)

(startup APPNAME
  (prompt "Removing AmiNetXDuo's lines from S:User-Startup.")
  (help   "Only the lines between ;BEGIN AmiNetXDuo and ;END AmiNetXDuo."))

(complete 20)

; WirelessManager and Wireless.prefs, when the installer put them there.
(if (exists WIFIREC (noreq))
  (
    (run ("Execute %s" WIFIREC)
         (prompt "Removing the Wi-Fi files the installer created")
         (help "The AmigaDOS script the installer wrote of what it installed."))
    (delete WIFIREC
            (prompt ("Deleting %s" WIFIREC))
            (help "A file AmiNetXDuo put there.")
            (optional "force" "nofail"))
  ))

; The Wi-Fi firmware files the installer copied, and only those.
(if (exists FWREC (noreq))
  (
    (run ("Execute %s" FWREC)
         (prompt "Removing the Wi-Fi firmware the installer copied")
         (help "The AmigaDOS script the installer wrote of what it installed."))
    (delete FWREC
            (prompt ("Deleting %s" FWREC))
            (help "A file AmiNetXDuo put there.")
            (optional "force" "nofail"))
  ))

(complete 40)

(run ("Execute %s" REC)
     (prompt "Deleting AmiNetXDuo's files and putting back what it replaced")
     (help "The AmigaDOS script the installer wrote of what it installed."))

(set NOT_BACK (exists "T:AmiNetXDuo-NotRestored" (noreq)))
(set KEPT     (exists "T:AmiNetXDuo-Kept" (noreq)))
(set DRAWER   (exists "T:AmiNetXDuo-DrawerKept" (noreq)))

; The record goes with what it records; kept while anything is still to
; be put back, so that running this again finishes the job.
(if (NOT NOT_BACK)
    (delete REC
            (prompt ("Deleting %s" REC))
            (help "A file AmiNetXDuo put there.")
            (optional "force" "nofail")))

(complete 100)

(set DONE "")
(if NOT_BACK
    (set DONE (cat DONE "Some files of the other stack could not be put "
                   "back.  They are still in the AmiNetXDuo drawer's Backup, "
                   "and T:AmiNetXDuo-NotRestored lists them.  "
                   "S:AmiNetXDuo-Files stays, so Uninstall-AmiNetXDuo can "
                   "be run again.\n\n")))
(if KEPT
    (set DONE (cat DONE "Files changed since the installation are kept; "
                   "T:AmiNetXDuo-Kept lists them.\n\n")))
(if DRAWER
    (set DONE (cat DONE "The AmiNetXDuo drawer holds files the installer "
                   "did not put there, and stays.\n\n")))

(if @pretend
    (exit "Nothing was removed: this was a pretend run.")
    (exit (cat DONE "AmiNetXDuo is removed.  Reboot to stop the stack that "
               "is running now.")))
