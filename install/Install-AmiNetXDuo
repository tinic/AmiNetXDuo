           "Nothing was changed."))

; ==========================================================================
;  2.  What is already here?
; ==========================================================================

; Driver files are only a fallback.  A file says that a driver was installed
; at some point, not that its card is in this machine today.  InstallNetProbe
; adds the Zorro boards expansion.library actually enumerated and the Emu68
; devices its tree actually names.  ORing rather than remembering the first
; result is deliberate: the selection page and the configuration both support
; several cards in one Amiga.
(set DRIVER_DEFAULT 0)
(set CARD_DEFAULT   0)
(set DET_N     0)
(set PCM_DEFAULT 0)
(set EMU_DEV "uaenet.device")
(set EMU_FOUND 0)
(set EMU_FILE_DEV "")

; Do not put anxgenet.device or anxwifipi.device in this file fallback.  This
; installer places both in DEVS:Networks on every machine, so their presence
; says only that AmiNetXDuo was installed before.  The Emu68 probe below is
; the authoritative signal for the corresponding hardware.
(while (set DET_TRY (select DET_N
          "ZZ9000Net.device"
          "x-surf-100.device"
          "x-surf-500.device"
          "a2065.device"
          "ariadne.device"
          "ariadne_ii.device"
          "hydra.device"
          "eb920.device"
          "x-surf.device"
          "cnet.device"
          "uaenet.device"
          "etherlink3.device"
          "xircomce2.device"
          ""))
  (
    (if (> (strlen DET_TRY) 0)
      (if (OR (exists (cat "DEVS:" DET_TRY) (noreq))
              (exists (cat "DEVS:Networks/" DET_TRY) (noreq)))
        (set DRIVER_DEFAULT
          (bitor DRIVER_DEFAULT
            (select DET_N 2 4 8 16 32 64 128 256 512 1024 4096
                          1024 1024)))))
    (set DET_N (+ DET_N 1))
  ))

; UAE derivatives share uaenet.device; Amithlon has its own names. Prefer
; a live Exec driver over a disk-only fallback, including stale UAE files.
; The generic DEVICE probe also handles other ROM drivers entered manually.
(set EMU_N 0)
(while (set EMU_TRY (select EMU_N
          "uaenet.device" "amithlon1_net.device" "powerne2k.device" ""))
  (
    (set PROBE_CMD ("\"%s\" DEVICE \"%s\"" S_NETPROBE EMU_TRY))
    (if (AND (= EMU_FOUND 0) (= 0 (run PROBE_CMD (quiet) (safe))))
      (
        (set EMU_DEV EMU_TRY)
        (set EMU_FOUND 1)
      ))
    (if (AND (= (strlen EMU_FILE_DEV) 0)
             (OR (exists (cat "DEVS:" EMU_TRY) (noreq))
                 (exists (cat "DEVS:Networks/" EMU_TRY) (noreq))))
      (set EMU_FILE_DEV EMU_TRY))
    (set EMU_N (+ EMU_N 1))
  ))
(if (> (strlen EMU_FILE_DEV) 0)
  (
    (set DRIVER_DEFAULT (bitor DRIVER_DEFAULT 4096))
    (if (= EMU_FOUND 0) (set EMU_DEV EMU_FILE_DEV))
  ))

(if (OR (exists "DEVS:etherlink3.device" (noreq))
        (exists "DEVS:Networks/etherlink3.device" (noreq)))
    (set PCM_DEFAULT 1))
(if (AND (= PCM_DEFAULT 0)
         (OR (exists "DEVS:xircomce2.device" (noreq))
             (exists "DEVS:Networks/xircomce2.device" (noreq))))
    (set PCM_DEFAULT 4))


; ==========================================================================
;  3.  Welcome
; ==========================================================================

(welcome
  "AmiNetXDuo " VERSION_STR " -- a TCP/IP stack for AmigaOS.\n\n")

(complete 0)

; Emu68 publishes the Pi's device tree as an Exec resource.  Installer has
; no resource primitive, so the tiny companion beside this script asks the
; same read-only device-tree code our GENET driver uses.  It does not open a
; SANA-II device, claim hardware, load Wi-Fi firmware or change the machine.
;
; Three yes/no calls keep the return values in AmigaDOS's conventional
; RETURN_OK/RETURN_WARN range.  A missing or malformed resource simply means
; "not detected" and falls through to the ordinary card page below.
(set PROBE_CMD ("\"%s\" EMU68" S_NETPROBE))
(set AUTO_EMU68
  (if (= 0 (run PROBE_CMD
                (prompt "Checking for Emu68")
                (help "This reads Emu68's device tree.  It does not open or "
                      "reset a network device.")
                (safe))) 1 0))
(set PROBE_CMD ("\"%s\" GENET" S_NETPROBE))
(set AUTO_GENET
  (if (= 0 (run PROBE_CMD
                (prompt "Checking for the Raspberry Pi Ethernet device")
                (help "This reads Emu68's device tree.  It does not open or "
                      "reset the Ethernet device.")
                (safe))) 1 0))
; A GENET the tree names at an address the 68k cannot reach is Emu68 1.0.x,
; which predates the /scb mapping anxgenet.device needs.  Emu68's own
; genet.device, where one is installed, drives it instead; with none, the Pi
; Ethernet is left out, and a machine with nothing else stops below.
(set GENET_OLD 0)
(set GENET_LEGACY 0)
(if AUTO_GENET
  (
    (set PROBE_CMD ("\"%s\" GENETOK" S_NETPROBE))
    (if (= 5 (run PROBE_CMD
                   (prompt "Checking the Emu68 version")
                   (help "This reads Emu68's device tree.  It does not open or "
                         "reset the Ethernet device.")
                   (safe)))
      (
        (set GENET_OLD 1)
        (if (OR (exists "DEVS:Networks/genet.device" (noreq))
                (exists "DEVS:genet.device" (noreq)))
          (set GENET_LEGACY 1))
      ))
  ))
(set PROBE_CMD ("\"%s\" WIFIPI" S_NETPROBE))
(set AUTO_WIFIPI
  (if (= 0 (run PROBE_CMD
                (prompt "Checking for the Raspberry Pi Wi-Fi device")
                (help "This reads Emu68's device tree.  It does not open the "
                      "Wi-Fi device or load its firmware.")
                (safe))) 1 0))

; Zorro Autoconfig is the classic machine's device tree.  These calls inspect
; the ConfigDev list expansion.library already built at boot; they do not open
; a SANA-II driver or touch a board register.  The bit positions are the
; askoptions choices below.
(set PROBE_N 0)
(while (set PROBE_CARD (select PROBE_N
          "xsurf100" "a2065" "ariadne" "ariadne2" "hydra" "lanrover"
          "xsurf" "zz9000" ""))
  (
    (set PROBE_CMD ("\"%s\" CARD %s" S_NETPROBE PROBE_CARD))
    (if (= 0 (run PROBE_CMD (quiet) (safe)))
      (set CARD_DEFAULT
        (bitor CARD_DEFAULT
          (select PROBE_N 4 16 32 64 128 256 512 2))))
    (set PROBE_N (+ PROBE_N 1))
  ))

; A PC Card has no ConfigDev.  InstallNetProbe briefly asks card.resource for
; an available slot and reads only FUNCID/MANFID tuples; an active owner is
; never displaced.  A standard LAN FUNCID selects the family, while the three
; EtherLink III identities also select the exact subtype page default.
(set PROBE_CMD ("\"%s\" CARD pcmcia" S_NETPROBE))
(if (= 0 (run PROBE_CMD (quiet) (safe)))
  (set CARD_DEFAULT (bitor CARD_DEFAULT 1024)))
; An NE2000 card's ID selects it too, over a driver-based default.
; PCM_FOUND: the card named its type, so the PCMCIA page has nothing to ask.
(set PCM_FOUND 0)
(set PROBE_N 0)
(while (set PROBE_CARD
         (select PROBE_N "cnet" "3c589" "3ccfem556" "3cxem556" "xircom" ""))
  (
    (set PROBE_CMD ("\"%s\" CARD %s" S_NETPROBE PROBE_CARD))
    (if (= 0 (run PROBE_CMD (quiet) (safe)))
      (
        (set PCM_DEFAULT PROBE_N)
        (set PCM_FOUND 1)
      ))
    (set PROBE_N (+ PROBE_N 1))
  ))
(if EMU_FOUND
  (set CARD_DEFAULT (bitor CARD_DEFAULT 4096)))
(if (AND AUTO_GENET (OR (NOT GENET_OLD) GENET_LEGACY))
  (set CARD_DEFAULT (bitor CARD_DEFAULT 1)))
(if AUTO_WIFIPI (set CARD_DEFAULT (bitor CARD_DEFAULT 2048)))

; Only the unreachable GENET was found, and no driver file either: nothing
; this installer writes can bring the network up.  Before any question, so
; nothing has been written.  Expert continues to the card page.
(if (AND GENET_OLD (NOT GENET_LEGACY) (< @user-level 2)
         (= (bitor CARD_DEFAULT DRIVER_DEFAULT) 0))
    (abort "anxgenet.device needs Emu68 1.1 alpha.1 or newer.  This Emu68 "
           "does not map the Raspberry Pi Ethernet for the 68k.\n\n"
           "Update Emu68, or install Emu68's genet.device, then run this "
           "installer again.\n\n"
           "Nothing was changed."))

; What the hardware itself answered, before any driver file is added: a
; family page whose variants it settled is not drawn below Expert.
(set PROBE_DEFAULT CARD_DEFAULT)

; If hardware was enumerated, do not also preselect stale Zorro driver files.
; Preserve only the devices that have no safe hardware identity to inspect.
; With no hardware result at all, retain the complete driver-file fallback so
; Novice mode and pre-Autoconfig/third-party adapters continue to work.
(if (> CARD_DEFAULT 0)
  (set CARD_DEFAULT
    (bitor CARD_DEFAULT (bitand DRIVER_DEFAULT 5128)))
  (set CARD_DEFAULT DRIVER_DEFAULT))

; ==========================================================================
;  4.  Questions.  All of them, before anything is written.
; ==========================================================================

; ONE QUESTION, AND IT IS NOT ABOUT THE PROCESSOR.  It used to be: the archive
; carried a library per CPU and this page asked which -- with the detected one
; as the default, because a user who installs on one machine and moves the disk
; to another said so ("I often install things on one machine and then take it
; to another").  Every binary now runs on every 68k, so that question has no
; answer left to get wrong and is gone.
;
; What remains is a real choice between four profiles: full, minimal, micro
; and fat.  The reduced profiles trade features for memory on constrained
; machines; fat trades memory and the 68000 for speed.  The question below
; gives the exact differences.
;
; THE FIGURES ARE MEASURED, THEY GO STALE, AND THEY ARE RAM AND NOT FILES.
; This comment has already said 104 KB, 98 KB, 124 KB and 121 KB, each a build
; behind the library.  The last of those was also the wrong QUANTITY: it was the
; packed file size, and a hunk file carries relocation tables that LoadSeg frees.
; What a machine holds is code, data and BSS plus sizeof(AmiNetStack) -- at
; 0.28.9, full 441,960, minimal 272,148, micro 226,560.  So minimal saves
; 169,812 bytes of RAM and micro 45,588 more.  The question this page asks is
; about memory, so quote memory.  Re-measure at every release; the numbers are
; quoted twice in the help below.
;
; At NOVICE every ask... returns its (default) without showing anything.
; Choose the profile from installed RAM before asking the question.
;
; Fat is preselected on Emu68 only with at least 8 MB, a 68020 or newer
; and Libs/fat in the archive. It stays a visible choice on smaller machines.
(set HAVE_FAT (if (exists (tackon (tackon S_LIBSBASE "fat") "bsdsocket.library") (noreq)) 1 0))
; Installed RAM, rather than memory free while unpacking or running Installer.
; The helper rounds Exec's small boot reservation up to the fitted RAM tier.
; A failed query keeps the conservative minimal recommendation.
(set MINPICK 1)
(if (= 0 (run ("\"%s\" MEMORY 8388608" S_NETPROBE) (quiet) (safe)))
    (set MINPICK 0)
    (if (= 5 (run ("\"%s\" MEMORY 2162688" S_NETPROBE) (quiet) (safe)))
        (set MINPICK 2)))
(if (AND (= MINPICK 0) AUTO_EMU68 CPU020 HAVE_FAT) (set MINPICK 3))

(set STACK_OK 0)
(until STACK_OK
(set MINPICK
  (askchoice
    (prompt "Select the stack to install.\n\nThe recommended choice for this machine is selected.")
    (help "The full, minimal and micro stacks run on every Amiga from a 68000 up.  One binary picks "
          "the code for this processor when the library opens.  Nothing has "
          "to match the machine.  If the disk moves to another machine, "
          "nothing changes.\n\n"
          "The default is micro up to 2 MB, minimal below 8 MB, and full "
          "from 8 MB. PiStorm uses fat from 8 MB. This uses installed RAM, "
          "so programs running during installation do not change the choice. "
          "At Intermediate or Expert you can choose another profile.\n\n"
          "The minimal stack leaves out IPv6, .local name lookups, the packet "
          "filter, encrypted (https:) connections, IPv4 multicast, the ARexx "
          "host and the TCP: handler. It holds about 170 KB less RAM.\n\n"
          "The micro stack leaves out all of that plus getaddrinfo/getnameinfo, "
          "ancillary data and out-of-band TCP, and carries a single interface "
          "with no Roadshow route or address-allocation calls. The classic "
          "resolver, DHCP and raw sockets work, so it can ask a "
          "router for an address. It holds about 29 KB less again. Choose "
          "it if you have one network card and have measured your memory.\n\n"
          "With the full stack, encrypted connections work on any processor. "
          "On a 68000 a first handshake takes a minute or two. A repeat "
          "connection to the same server takes less than a second.\n\n"
          "The fat stack is the full stack compiled for speed, drivers and "
          "commands included. It needs a 68020 or newer and uses more "
          "memory. It is preselected on a PiStorm running Emu68 with "
          "at least 8 MB of installed RAM.")
    ; 22 characters is the limit -- install/tools/checkscript.py enforces it,
    ; because a longer gadget is dropped from the page without a word.
    (choices "Everything"
             "Minimal, no IPv6/TLS"
             "Micro, one interface"
             "Fat, 68020 and up")
    (default MINPICK)))
(set STACK_OK (OR (<> MINPICK 3) CPU020))
; Never reached at NOVICE: the default is fat only when CPU020 is set.
(if (= STACK_OK 0)
    (message (cat "The fat stack needs a 68020 or newer.  This Amiga has a "
                  CPU_NAME ".")
             (help "Select the full, minimal or micro stack.")))
)

; MINPICK 0 is the full stack at the top of Libs:, 1 is the minimal drawer,
; 2 is the micro drawer, 3 the fat one.  THE PAGE HAS FOUR OPTIONS NOW, which is not only a
; user-visible change: install/test/run-workbench.sh identifies this page by
; its option COUNT (DRIVE_PICK_OPTIONS), so its -p specs move with it.
(if (= MINPICK 1) (set S_LIBS (tackon S_LIBSBASE "minimal")))
(if (= MINPICK 2) (set S_LIBS (tackon S_LIBSBASE "micro")))
; Micro's drivers reserve one hardware unit, matching its interface limit.
(if (= MINPICK 2)
  (
    (set S_ANXNET    (tackon (tackon (tackon S_DEVS "Networks") "micro") "anxnet.device"))
    (set S_ANXGENET  (tackon (tackon (tackon S_DEVS "Networks") "micro") "anxgenet.device"))
    (set S_ANXWIFIPI (tackon (tackon (tackon S_DEVS "Networks") "micro") "anxwifipi.device"))
    (set S_ANXZZ9000 (tackon (tackon (tackon S_DEVS "Networks") "micro") "anxzz9000.device"))
    (set HAVE_ANXZZ9000 (if (exists S_ANXZZ9000 (noreq)) 1 0))
    (if (NOT (AND (AND (exists S_ANXNET (noreq)) (exists S_ANXGENET (noreq)))
                  (exists S_ANXWIFIPI (noreq))))
        (abort "This archive has no complete micro drivers.\n\n"
               "The download is incomplete, or was unpacked with a tool that "
               "dropped the subdrawers.\n\n"
               "Nothing was changed."))
  ))
; MINPICK 3, fat: its own drivers and commands as well as its libraries.
(if (= MINPICK 3)
  (
    (set S_LIBS (tackon S_LIBSBASE "fat"))
    (set S_ANXNET    (tackon (tackon (tackon S_DEVS "Networks") "fat") "anxnet.device"))
    (set S_ANXGENET  (tackon (tackon (tackon S_DEVS "Networks") "fat") "anxgenet.device"))
    (set S_ANXWIFIPI (tackon (tackon (tackon S_DEVS "Networks") "fat") "anxwifipi.device"))
    (set S_ANXZZ9000 (tackon (tackon (tackon S_DEVS "Networks") "fat") "anxzz9000.device"))
    (set HAVE_ANXZZ9000 (if (exists S_ANXZZ9000 (noreq)) 1 0))
    (if (NOT (AND (AND (exists S_ANXNET (noreq)) (exists S_ANXGENET (noreq)))
                  (AND (exists S_ANXWIFIPI (noreq))
                       (exists (tackon S_CFAT "AddNetInterface") (noreq)))))
        (abort "This archive has no complete fat stack.\n\n"
               "The download is incomplete, or was unpacked with a tool that "
               "dropped the subdrawers.\n\n"
               "Nothing was changed."))
  ))
; The full feature set: the full stack and the fat one.
(set FULLSET (OR (= MINPICK 0) (= MINPICK 3)))

(if (NOT (exists (tackon S_LIBS "bsdsocket.library") (noreq)))
    (abort "This archive has no " S_LIBS " with a bsdsocket.library in it.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing was changed."))

; --- the driver this project builds --------------------------------------
;
; A QUESTION NOW, AND FOR ELEVEN RELEASES IT WAS NOT EVEN THAT.  The archive
; has always carried anxnet.device in Devs/Networks/ and this script always
; left it there, on the reasoning that a new driver is a deliberate step and
; that the installer is how a WORKING machine gets changed.  The caution was
; right; leaving the file out of the installation entirely was not the way to
; act on it.
;
; What it actually produced was a machine that kept whatever anxnet.device it
; already had through every reinstall -- the one file in the archive a user had
; no way to keep current.  On a real A1200 that cost an evening: reinstall
; after reinstall silently restored a stale driver, and several build verdicts
; were recorded against the wrong binary before the installer was suspected.
;
; The condition the old note set has been met.  anxnet.device has run on that
; A1200 continuously since, it is the driver that machine depends on -- the
; reference 3c589.device will not even open on it -- and the owner has asked
; for the installer to place it.
;
; NOT A QUESTION.  It was a page of its own until train F: the copy is inert
; until an interface file names a driver, and a vendor driver already in DEVS:
; still wins at P_prepare_card, so no answer but yes was ever right.
(set DO_ANXNET 1)

; --- where the drawer of documentation goes ------------------------------
;
; SYS: unless a self-contained installation is already assigned; then the
; drawer that assign names, so a reinstall lands on the installation it
; reinstalls.  Left to the Installer, @default-dest is Work: whenever that
; volume exists: the stack went onto the A1200's data partition (2026-09-19),
; and a reinstall of a drawer install offered a SECOND drawer, whose
; bsdsocket.library was not the one LIBS: already reached through the first,
; so the refusal below fired and no reinstall ever went through.
(set @default-dest "SYS:")
(set HAVE_DRAWER 0)
(if (exists "AmiNetXDuo:Libs/bsdsocket.library" (noreq))
  (
    (set @default-dest (pathonly (expandpath "AmiNetXDuo:")))
    (set HAVE_DRAWER 1)
  ))

; A system installation has no assign, but its record names its drawer:
; a reinstall goes back there, where Backup and Installed already are,
; not into a second SYS:AmiNetXDuo.  InstallSameFile reads the name into
; ENV:AmiNetXDuoDrawer, as the Installer cannot read a file.
(if (AND (= HAVE_DRAWER 0) (exists "S:AmiNetXDuo-Files" (noreq)))
  (if (= 0 (run ("\"%s\" S:AmiNetXDuo-Files AmiNetXDuoDrawer DRAWER" S_SAMEFILE)
                (quiet) (safe)))
    (
      (set REC_DRAWER (getenv "AmiNetXDuoDrawer"))
      (run "Delete >NIL: ENV:AmiNetXDuoDrawer QUIET" (quiet) (safe))
      (if (AND (> (strlen REC_DRAWER) 0) (= (exists REC_DRAWER (noreq)) 2))
          (set @default-dest (pathonly REC_DRAWER)))
    )))

; --- system directories, or a drawer of its own --------------------------
;
; Issue #9 asked for a layout that keeps every file of this stack in one
; drawer.  In drawer mode every file goes below the one documentation drawer
; chosen below, and the managed block ADDs its Libs, C and Devs to LIBS:, C:
; and DEVS: -- LAST, behind everything already there, the way AmiTCP and
; Miami did it.  The drawer answers only for what the system does not have.
; Putting it FIRST was tried (ActivateAmiNetXDuo, 0.26.5 to 0.28.3) and is
; wrong: the head of a multi-assign is where every other installer's
; `Copy foo LIBS:` lands and what `Dir C:` and DEVS:Networks show, so the
; drawer swallowed the system.
;
; Last means a bsdsocket.library already in LIBS: would win, so a machine
; that has one is refused below rather than given a drawer that never runs.
; On a machine that has none, the stack is selected by whoever opens its
; library first: S:Network-Startup runs AmiNetXDuo:C/AddNetInterface, every
; command opens PROGDIR:/Libs/ before LIBS:, and the library reads
; AmiNetXDuo:Devs rather than the DEVS: the assign would hand it
; (src/config/config_file.c).
;
; NOT ASKED AT NOVICE, where the Installer draws no questions at all: that
; level takes the system layout, which is what every install has done so far.
; The drawer needs its assigns in S:User-Startup to work at all, so choosing it
; forces the startup block on rather than leaving a drawer nothing can reach.
; A SCRIPTED INSTALL asks nobody.  S:AmiNetXDuo-drawer existing means the
; drawer layout, chosen before the installer starts, at every user level --
; It remains useful for an unattended caller that chooses the layout before
; starting Installer.  The release harness drives the visible radio page and
; separately covers this sentinel path.
(set FORCE_DRAWER (exists "S:AmiNetXDuo-drawer" (noreq)))
(set DRAWER_LAYOUT 0)

(if FORCE_DRAWER (set DRAWER_LAYOUT 1))

; An installation that already lives in a drawer is reinstalled into that
; drawer, not asked again: the layout question answered "into the system"
; on top of one would leave the drawer's block in S:User-Startup adding a
; second bsdsocket.library to LIBS:.  Leaving the drawer layout means
; removing the drawer and its block first.
(if HAVE_DRAWER (set DRAWER_LAYOUT 1))

(if (AND (= FORCE_DRAWER 0) (AND (= HAVE_DRAWER 0) (>= @user-level 1)))
  (if (= 1 (askchoice
             (prompt "Where should the stack itself go?")
             (help (cat "Into the system is the ordinary answer: "
                        "bsdsocket.library into LIBS:, the commands into C:, "
                        "the driver and the configuration into DEVS:.\n\n"
                        "Into a drawer of its own keeps every file together.  "
                        "The drawer's Libs, C and Devs are added to LIBS:, C: "
                        "and DEVS: after everything already there, and its "
                        "own S:Network-Startup starts its stack.  A machine "
                        "that already has a bsdsocket.library in LIBS: is "
                        "refused: that library would keep answering every "
                        "program, and the drawer's would never run."
                        "\n\n"
                        @askchoice-help))
             ; 22 characters is the ceiling; over it the page silently
             ; drops gadgets, which tools/check-installer refuses.
             (choices "Into the system"
                      "Into its own drawer")
             (default 0)))
    (set DRAWER_LAYOUT 1)))

; Asked at Expert, and of a new drawer install, which is the one layout where
; the drawer holds the stack itself.  Otherwise the existing installation's
; drawer (the assign, or the one its record names), and SYS: only for a
; first installation.
(set DOCPARENT @default-dest)
(if (OR (= @user-level 2) (AND DRAWER_LAYOUT (= HAVE_DRAWER 0)))
  (set DOCPARENT
    (askdir
      (prompt "Select where the \"AmiNetXDuo\" drawer goes.\n\n"
              "It holds the documentation and the examples.")
      (help H_DOCDIR)
      (default @default-dest))))

(set DOCDIR (tackon DOCPARENT "AmiNetXDuo"))

; A DRAWER BESIDE A LIBRARY THAT IS ALREADY IN LIBS: IS REFUSED.  The drawer
; is added to LIBS: last, so a bsdsocket.library the system already has --
; AmiTCP's, Miami's, Roadshow's, an AmiNetXDuo installed into the system --
; would go on answering every program that opens the library by name, and
; the one in the drawer would only ever run for the commands that open it by
; path.  Two stacks on one machine is not a state this installer produces.
; The system layout is the answer: it renames that library to .old.
;
; The one bsdsocket.library that is allowed in LIBS: is the drawer's own,
; which a machine that already has this layout carries there through its
; startup block -- last, so the name reaches it only when nothing earlier
; has one.  SAME OBJECT, not same bytes: a different AmiNetXDuo in SYS:Libs
; can be byte-identical and is exactly the case above.  Installer has no
; SameLock primitive, so InstallSameFile beside this script supplies that one
; answer through dos.library before anything is written.
;
; BEFORE the makedirs: a refused run leaves no drawer behind.
(if DRAWER_LAYOUT
  (
    ; The documentation prompt already selected this exact drawer.  Asking
    ; for a second parent produced two AmiNetXDuo drawers and made the
    ; startup code guess which one held Terminal and which held the stack.
    (set D_ROOT DOCDIR)
    (set D_LIBS (tackon D_ROOT "Libs"))
    (set D_C    (tackon D_ROOT "C"))
    (set D_DEVS (tackon D_ROOT "Devs"))

    (set OWN_BSD (tackon D_LIBS "bsdsocket.library"))
    (set LIBS_BSD_IS_OWN 0)
    (if (AND (exists "LIBS:bsdsocket.library" (noreq))
             (exists OWN_BSD (noreq)))
      (
        (set SAMEFILE_CMD
          ("\"%s\" \"LIBS:bsdsocket.library\" \"%s\""
             S_SAMEFILE OWN_BSD))
        (if (= 0
               (run SAMEFILE_CMD
                    (prompt "Checking which bsdsocket.library LIBS: reaches")
                    (help "A private reinstall may continue only when the "
                          "library found through LIBS: is the same file as "
                          "the one already in this AmiNetXDuo drawer.")
                    (safe)))
            (set LIBS_BSD_IS_OWN 1))
      ))

    (if (AND (exists "LIBS:bsdsocket.library" (noreq))
             (= LIBS_BSD_IS_OWN 0))
      (
        (set LIBS_BSD_RAW (getversion "LIBS:bsdsocket.library"))
        (set LIBS_BSD_VER (/ LIBS_BSD_RAW 65536))
        (set LIBS_BSD_REV (- LIBS_BSD_RAW (* LIBS_BSD_VER 65536)))
        (abort (F_DRAWER_REFUSED LIBS_BSD_VER LIBS_BSD_REV))
      ))

  ))

; How a startup file names one of OUR commands.  C: reaches the drawer LAST,
; so "C:AddNetInterface" is whatever earlier member has one -- another
; stack's leftover commands outlive its library; the drawer's is named
; through the assign the block makes first.  The system layout keeps the
; plain C: that every earlier install wrote.
(set C_PREFIX "C:")
(if DRAWER_LAYOUT (set C_PREFIX "AmiNetXDuo:C/"))

; Everything from here on examines THE CHOSEN DESTINATION.  Before drawer
; mode existed these tests quite reasonably named LIBS: and DEVS: directly;
; leaving them that way made a private install back up another stack's files
; and reuse another stack's configuration.
(set D_BSD (tackon D_LIBS "bsdsocket.library"))
(set D_UG   (tackon D_LIBS "usergroup.library"))
(set D_TLS  (tackon D_LIBS "tls.library"))
(set D_ANX  (tackon (tackon D_DEVS "Networks") "anxnet.device"))
(set D_ANXGENET (tackon (tackon D_DEVS "Networks") "anxgenet.device"))
(set D_ANXWIFIPI (tackon (tackon D_DEVS "Networks") "anxwifipi.device"))
(set D_ANXZZ9000 (tackon (tackon D_DEVS "Networks") "anxzz9000.device"))

; What a DEVICE= line names.  A drawer install names its drivers through the
; AmiNetXDuo: assign, as it names its commands (C_PREFIX): moving the assign
; to another drawer then moves the drivers with the library.  The absolute
; drawer path kept the old drawer's drivers under the new library.
(set W_NETWORKS (tackon D_DEVS "Networks"))
(if DRAWER_LAYOUT (set W_NETWORKS "AmiNetXDuo:Devs/Networks"))
(set W_ANX       (tackon W_NETWORKS "anxnet.device"))
(set W_ANXGENET  (tackon W_NETWORKS "anxgenet.device"))
(set W_ANXWIFIPI (tackon W_NETWORKS "anxwifipi.device"))
(set W_ANXZZ9000 (tackon W_NETWORKS "anxzz9000.device"))
(set D_BSD_OLD (cat D_BSD ".old"))
(set D_UG_OLD  (cat D_UG  ".old"))
(set D_TLS_OLD (cat D_TLS ".old"))
(set D_ANX_OLD (cat D_ANX ".old"))

; The staging names.  See "STAGED, THEN SWAPPED" in section 5.
(set D_BSD_NEW (cat D_BSD ".new"))
(set D_UG_NEW  (cat D_UG  ".new"))
(set D_TLS_NEW (cat D_TLS ".new"))
(set D_ANX_NEW (cat D_ANX ".new"))

(set OLD_BSD (if (exists D_BSD (noreq)) 1 0))
(set OLD_UG  (if (exists D_UG  (noreq)) 1 0))
(set OLD_TLS (if (exists D_TLS (noreq)) 1 0))

; VERSION AND REVISION, NOT VERSION ALONE.  getversion returns
; (version << 16) | revision.  This is asked only for a system install; a
; private reinstall replaces and backs up only its own copy without asking
; permission to touch a file outside the drawer, because it never does.
(set OLD_BSD_VER 0)
(set OLD_BSD_REV 0)
(if (AND OLD_BSD (= DRAWER_LAYOUT 0))
  (
    (set OLD_BSD_RAW (getversion D_BSD))
    (set OLD_BSD_VER (/ OLD_BSD_RAW 65536))
    (set OLD_BSD_REV (- OLD_BSD_RAW (* OLD_BSD_VER 65536)))
  ))

; Resolve a stack conflict before asking how to configure this one.  A user
; who elects to keep Roadshow, AmiTCP or Miami should not have to answer all
; the card and address pages merely to reach an abort at their end.
(set REPLACE_LIB 1)

; WHOSE LIBRARY.  Ours names itself AmiNetXDuo inside; Roadshow's, AmiTCP's
; and Miami's do not.  Replacing our own is an update, not a decision, so
; the page is not drawn for it, and the configuration it left is kept by
; default below.
(set LIB_OURS 0)
(if OLD_BSD
    (if (= 0 (run ("\"%s\" \"%s\" AmiNetXDuo MARK" S_SAMEFILE D_BSD)
                  (quiet) (safe)))
        (set LIB_OURS 1)))

; Another stack is somebody's working network, so this page is drawn at
; every level: (user) lifts Novice to Intermediate for it and back.
(set LEVEL_WAS @user-level)
(if (AND OLD_BSD (= DRAWER_LAYOUT 0) (= LIB_OURS 0))
  (
    (if (= LEVEL_WAS 0) (user 1))
    (set REPLACE_LIB
      (askbool
        (prompt (F_OLDLIB OLD_BSD_VER OLD_BSD_REV))
        (help    H_REPLACELIB)
        (choices "Replace it" "Leave it alone")
        (default 1)))
    (if (= LEVEL_WAS 0) (user 0))
  ))

(if (= REPLACE_LIB 0)
    (abort "LIBS:bsdsocket.library is unchanged, so AmiNetXDuo is not "
           "installed.\n\n"
           "Nothing was changed."))

; Configuration belongs to the same layout as the libraries and commands.
(set OLD_IF "")
(set D_IFDIR (tackon D_DEVS "NetInterfaces"))
(if (= (exists D_IFDIR (noreq)) 2)
    (foreach D_IFDIR "~(#?.info)"
      (if (= (strlen OLD_IF) 0)
          (if (< @each-type 0)
              (set OLD_IF @each-name)))))
(set HAVE_OLD (if (> (strlen OLD_IF) 0) 1 0))

; Ours: our library, or an interface file this installer wrote.
(set CONFIG_OURS LIB_OURS)
(if (AND HAVE_OLD (= CONFIG_OURS 0))
    (if (= 0 (run ("\"%s\" \"%s\" AmiNetXDuo MARK"
                   S_SAMEFILE (tackon D_IFDIR OLD_IF))
                  (quiet) (safe)))
        (set CONFIG_OURS 1)))

; A novice run makes no decisions of its own, so with nothing detected and no
; existing configuration to keep, there is no honest default to fall back on.
;
; AFTER THE WELCOME, and that is the whole point. This used to sit up in the
; detection section, which runs before (welcome) -- so it fired on the level
; the icon happened to default to, the welcome page never appeared, and its own
; advice to "start this installer again and choose Intermediate User" named a
; page the user had never been shown and could not reach. Reported as "the
; warning is the first thing I see and I cannot select mode", with a screenshot
; of exactly that.
;
; Here, @user-level is what the user picked, so a novice who wants the card
; question can simply pick another level on the page they have just seen.

(if (AND (= @user-level 0) (AND (= CARD_DEFAULT 0) (= HAVE_OLD 0)))
    (abort "The installer found no network card and no installed network "
           "driver.  In Novice mode it cannot ask which cards this Amiga "
           "has.\n\n"
           "Start this installer again and choose \"Intermediate User\", "
           "which shows the complete card list.\n\n"
           "Nothing was changed."))

; --- keep or replace an existing configuration ---------------------------

(set KEEP_OLD 0)

; Keep is the default for our own configuration.  Another stack's is set up
; again, its files kept in the AmiNetXDuo drawer's Backup, when there is a
; device to set it up for: with none detected a Novice run has no card to
; write, so it keeps that one.  The default is the page's first button either
; way.  Another stack's configuration is drawn at Novice too, as the
; replace page is.
(set KEEP_DEF (if (OR CONFIG_OURS (= CARD_DEFAULT 0)) 1 0))
(if HAVE_OLD
  (
    (if (AND (= LEVEL_WAS 0) (= CONFIG_OURS 0)) (user 1))
    (set KEEP_OLD
      (if (askbool
            (prompt (F_KEEPOLD OLD_IF))
            (help H_KEEPOLD)
            (choices (if KEEP_DEF "Keep it" "Set them up again")
                     (if KEEP_DEF "Set them up again" "Keep it"))
            (default 1))
          KEEP_DEF (- 1 KEEP_DEF)))
    (if (AND (= LEVEL_WAS 0) (= CONFIG_OURS 0)) (user 0))
  ))

; Kept settings are not checked, and saying so is the only honest option.
;
; Everything below -- the card question, and with it the warning that the named
; driver is not in DEVS: or DEVS:Networks -- is inside (= KEEP_OLD 0). So an
; interface file that survives from an earlier install goes untouched and
; unexamined, and a driver that has since been removed is never noticed.
;
; It cannot be examined: the Installer language cannot read the DEVICE= line
; back out of the file, so there is no name to look for. Reported by a user who
; took the drivers away, installed again and was told nothing.
; Drawn for another stack's configuration, and at Expert; a routine update
; over AmiNetXDuo's own does not need it.
; (user) for Novice, which draws no (message) of its own.
(if (AND HAVE_OLD KEEP_OLD (OR (= @user-level 2) (= CONFIG_OURS 0)))
  (
    (if (= LEVEL_WAS 0) (user 1))
    (message
      "The existing configuration for \"" OLD_IF "\" is kept as it is.\n\n"
      "It is not checked.  If the card or its driver changed since the file "
      "was written, the network does not come up.  Install again and choose "
      "\"Set them up again\" to answer the questions again.")
    (if (= LEVEL_WAS 0) (user 0))
  ))

; --- the card ------------------------------------------------------------

(set IFNAME  "eth0")
(set DEVUNIT 0)
(set USE_CARD 0)
(set CARD_KEY "")
(set USEDHCP 1)
(set WANTMDNS 0)
(set CUSTOM_DEV "mycard.device")
(set PCM_OTHER_DEV "mycard.device")
(set PCM 0)

; The Wi-Fi is the Pi Wi-Fi.
; WIFI_SEL: it is selected, or a kept definition names anxwifipi.device.
; WIFI_PRIMARY: it is the interface S:Network-Startup
; starts first.  WIFI_START: S:Network-Startup starts it too, after the
; primary -- every profile but micro, which brings up one interface.
; WIFI_DEV is what its interface file names.
(set WIFI_SEL 0)
(set WIFI_PRIMARY 0)
(set WIFI_START 0)
(set WIFI_IF "wifipi")
(set WIFI_DEV W_ANXWIFIPI)
(set WIFI_UNIT 0)
(set WIFI_TMP "T:AmiNetXDuo-Wireless.prefs")
; It holds the Wi-Fi passphrase: an installation that stops, for any reason,
; takes it away.
(onerror
  (if (exists WIFI_TMP (noreq))
      (delete WIFI_TMP
              (prompt "Removing T:AmiNetXDuo-Wireless.prefs")
              (help   "It holds the Wi-Fi passphrase.")
              (optional "force" "nofail")
              (safe))))
(set WIFI_NEW_PREFS 0)
(set WIFI_HAVE_PREFS
  (if (OR (exists "ENVARC:Sys/Wireless.prefs" (noreq))
          (exists "ENV:Sys/Wireless.prefs" (noreq))) 1 0))

; WHOSE WirelessManager AND WHOSE Wireless.prefs.  S:AmiNetXDuo-WiFi is the
; record of the Wi-Fi files this installer created -- a script of Delete
; lines, which is also how they are removed again -- so a reinstall can tell
; its own copy from one the user had.  A WirelessManager that is not ours is
; looked for in C:, SYS:C and this layout's own C; it is never replaced, and
; S:Network-Startup starts that one.  Only WirelessManager named in the
; startup files or WBStartup keeps S:Network-Startup from starting it:
; Status recognises a running copy only by its exact command name, and two
; supplicants on one radio fight over it.  A WirelessManager or a
; Wireless.prefs that merely exists starts nothing by itself; treating
; either as "started elsewhere" left the Wi-Fi of a real A1200 unjoined.
(set D_WM (tackon D_C "WirelessManager"))
(set WM_REC (if DRAWER_LAYOUT "AmiNetXDuo:C/WirelessManager" "C:WirelessManager"))
; What finds WM_REC's line in the record.  No volume name the drawer layout
; may not have assigned yet: Search given one never returned.
(set WM_REC_KEY (if DRAWER_LAYOUT "C/WirelessManager QUIET"
                    "Delete C:WirelessManager QUIET"))
(set WIFI_REC "S:AmiNetXDuo-WiFi")
(set WM_OURS 0)
(set PREFS_OURS 0)
(if (exists WIFI_REC (noreq))
  (
    (if (= 0 (run ("Search >NIL: FROM %s SEARCH \"%s\" QUIET"
                   WIFI_REC WM_REC_KEY)
                  (quiet) (safe)))
        (set WM_OURS 1))
    (if (= 0 (run ("Search >NIL: FROM %s SEARCH ENVARC:Sys/Wireless.prefs QUIET"
                   WIFI_REC)
                  (quiet) (safe)))
        (set PREFS_OURS 1))
  ))
(set HAVE_C_WM    (if (exists "C:WirelessManager" (noreq)) 1 0))
(set HAVE_SYSC_WM (if (exists "SYS:C/WirelessManager" (noreq)) 1 0))
(set HAVE_D_WM    (if (exists D_WM (noreq)) 1 0))
(if DRAWER_LAYOUT
    (set WM_USER (if (OR HAVE_SYSC_WM
                         (OR (AND HAVE_C_WM (= HAVE_D_WM 0))
                             (AND HAVE_D_WM (= WM_OURS 0)))) 1 0))
    (set WM_USER (if (AND (OR HAVE_C_WM HAVE_SYSC_WM) (= WM_OURS 0)) 1 0)))
(set WM_ELSEWHERE 0)
(set WM_SCAN_N 0)
(while (set WM_SCAN (select WM_SCAN_N "S:User-Startup" "S:Startup-Sequence"
                                      "SYS:WBStartup" ""))
  (
    (if (exists WM_SCAN (noreq))
        (if (= 0 (run ("Search >NIL: FROM %s SEARCH WirelessManager QUIET"
                       WM_SCAN)
                      (quiet) (safe)))
            (set WM_ELSEWHERE 1)))
    (set WM_SCAN_N (+ WM_SCAN_N 1))
  ))
(set WM_LIVE (if WM_ELSEWHERE 0 1))

(if (= KEEP_OLD 0)
  (
    ; Ten families fit Installer 2.17's standard page.  Fourteen individual
    ; boards do not: layout_box_gads() silently created zero checkboxes in a
    ; real Workbench run.  The three families with variants get compact
    ; follow-up checkmark pages, so no capability is lost and several variants
    ; can still coexist in one machine.  Below Expert a follow-up page is drawn
    ; only when the probe found no variant of its family (PROBE_DEFAULT).
    (set CATEGORY_DEFAULT 0)
    (if (> (bitand CARD_DEFAULT 2049) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 1)))
    (if (> (bitand CARD_DEFAULT 2) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 2)))
    (if (> (bitand CARD_DEFAULT 16) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 4)))
    (if (> (bitand CARD_DEFAULT 96) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 8)))
    (if (> (bitand CARD_DEFAULT 128) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 16)))
    (if (> (bitand CARD_DEFAULT 256) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 32)))
    (if (> (bitand CARD_DEFAULT 524) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 64)))
    (if (> (bitand CARD_DEFAULT 1024) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 128)))
    (if (> (bitand CARD_DEFAULT 4096) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 256)))
    (if (> (bitand CARD_DEFAULT 8192) 0)
      (set CATEGORY_DEFAULT (bitor CATEGORY_DEFAULT 512)))

    (set CATEGORY_MASK 0)
    (until (> CATEGORY_MASK 0)
      (set CATEGORY_MASK
      (askoptions
        (prompt "Which network devices does this Amiga have?")
        (help   H_CARD)
        (choices
          "Raspberry Pi"
          "ZZ9000"
          "A2065"
          "Ariadne"
          "AmigaNet"
          "LAN Rover"
          "X-Surf"
          "PCMCIA"
          "Emulator network"
          "Other driver")
        (default CATEGORY_DEFAULT)))
      (if (= CATEGORY_MASK 0)
        (message "Select at least one network device."
                 (help H_CARD))))

    (set CARD_MASK 0)

    (if (> (bitand CATEGORY_MASK 1) 0)
      (
        (set PI_DEFAULT 0)
        (if (> (bitand CARD_DEFAULT 1) 0)
          (set PI_DEFAULT (bitor PI_DEFAULT 1)))
        (if (> (bitand CARD_DEFAULT 2048) 0)
          (set PI_DEFAULT (bitor PI_DEFAULT 2)))
        (if (= PI_DEFAULT 0) (set PI_DEFAULT 1))
        (set PI_MASK 0)
        ; Only a probed Pi Wi-Fi settles the page: GENET alone leaves open
        ; whether a radio is there to tick.
        (if (AND (< @user-level 2) (> (bitand PROBE_DEFAULT 2048) 0))
          (set PI_MASK PI_DEFAULT))
        (until (> PI_MASK 0)
          (set PI_MASK
            (askoptions
              (prompt "Which Raspberry Pi network devices are present?")
              (help H_CARD)
              (choices "GENET Ethernet" "Pi Wi-Fi")
              (default PI_DEFAULT))))
        (if (> (bitand PI_MASK 1) 0)
          (set CARD_MASK (bitor CARD_MASK 1)))
        (if (> (bitand PI_MASK 2) 0)
          (set CARD_MASK (bitor CARD_MASK 2048)))
      ))

    (if (> (bitand CATEGORY_MASK 2) 0)
      (set CARD_MASK (bitor CARD_MASK 2)))
    (if (> (bitand CATEGORY_MASK 4) 0)
      (set CARD_MASK (bitor CARD_MASK 16)))

    (if (> (bitand CATEGORY_MASK 8) 0)
      (
        (set ARIADNE_DEFAULT 0)
        (if (> (bitand CARD_DEFAULT 32) 0)
          (set ARIADNE_DEFAULT (bitor ARIADNE_DEFAULT 1)))
        (if (> (bitand CARD_DEFAULT 64) 0)
          (set ARIADNE_DEFAULT (bitor ARIADNE_DEFAULT 2)))
        (if (= ARIADNE_DEFAULT 0) (set ARIADNE_DEFAULT 1))
        (set ARIADNE_MASK 0)
        (if (AND (< @user-level 2) (> (bitand PROBE_DEFAULT 96) 0))
          (set ARIADNE_MASK ARIADNE_DEFAULT))
        (until (> ARIADNE_MASK 0)
          (set ARIADNE_MASK
            (askoptions
              (prompt "Which Ariadne cards are present?")
              (help H_CARD)
              (choices "Ariadne" "Ariadne II")
              (default ARIADNE_DEFAULT))))
        (if (> (bitand ARIADNE_MASK 1) 0)
          (set CARD_MASK (bitor CARD_MASK 32)))
        (if (> (bitand ARIADNE_MASK 2) 0)
          (set CARD_MASK (bitor CARD_MASK 64)))
      ))

    (if (> (bitand CATEGORY_MASK 16) 0)
      (set CARD_MASK (bitor CARD_MASK 128)))
    (if (> (bitand CATEGORY_MASK 32) 0)
      (set CARD_MASK (bitor CARD_MASK 256)))

    (if (> (bitand CATEGORY_MASK 64) 0)
      (
        (set XSURF_DEFAULT 0)
        (if (> (bitand CARD_DEFAULT 512) 0)
          (set XSURF_DEFAULT (bitor XSURF_DEFAULT 1)))
        (if (> (bitand CARD_DEFAULT 4) 0)
          (set XSURF_DEFAULT (bitor XSURF_DEFAULT 2)))
        (if (> (bitand CARD_DEFAULT 8) 0)
          (set XSURF_DEFAULT (bitor XSURF_DEFAULT 4)))
        (if (= XSURF_DEFAULT 0) (set XSURF_DEFAULT 1))
        (set XSURF_MASK 0)
        (if (AND (< @user-level 2) (> (bitand PROBE_DEFAULT 524) 0))
          (set XSURF_MASK XSURF_DEFAULT))
        (until (> XSURF_MASK 0)
          (set XSURF_MASK
            (askoptions
              (prompt "Which X-Surf cards are present?")
              (help H_CARD)
              (choices "X-Surf" "X-Surf 100" "X-Surf 500")
              (default XSURF_DEFAULT))))
        (if (> (bitand XSURF_MASK 1) 0)
          (set CARD_MASK (bitor CARD_MASK 512)))
        (if (> (bitand XSURF_MASK 2) 0)
          (set CARD_MASK (bitor CARD_MASK 4)))
        (if (> (bitand XSURF_MASK 4) 0)
          (set CARD_MASK (bitor CARD_MASK 8)))
      ))

    (if (> (bitand CATEGORY_MASK 128) 0)
      (set CARD_MASK (bitor CARD_MASK 1024)))
    (if (> (bitand CATEGORY_MASK 256) 0)
      (set CARD_MASK (bitor CARD_MASK 4096)))
    (if (> (bitand CATEGORY_MASK 512) 0)
      (set CARD_MASK (bitor CARD_MASK 8192)))

    ; PCMCIA is one physical slot, so its family remains a single-choice page,
    ; drawn below Expert only when the card did not name its type.
    (if (> (bitand CARD_MASK 1024) 0)
      (
        (set PCM PCM_DEFAULT)
        (if (OR (= @user-level 2) (= PCM_FOUND 0))
        (set PCM
          (askchoice
            (prompt "Which PCMCIA card is it?")
            (help   H_PCMCIA)
            (choices
              "NE2000 or CNet"
              "3Com 3C589"
              "3Com 3CCFEM556"
              "3Com 3CXEM556"
              "Xircom Ethernet"
              "Something else")
            (default PCM_DEFAULT))))
        (if (= PCM 5)
          (set PCM_OTHER_DEV
            (askstring
              (prompt "Type the PCMCIA card's driver file name.")
              (help H_OTHERDEV)
              (default "mycard.device"))))
      ))

    (if (> (bitand CARD_MASK 8192) 0)
      (set CUSTOM_DEV
        (askstring
            (prompt "Type the file name of the card driver.  The name ends "
                    "in \".device\".")
            (help   H_OTHERDEV)
            (default "mycard.device"))))

    ; The page order is also the deterministic primary order: on-board GENET,
    ; then the fastest wired expansion cards, the older wired cards, PCMCIA,
    ; Wi-Fi and emulator-only devices.  Nothing is opened merely to choose it.
    (set PRIMARY_INDEX 0)
    (until (> (bitand CARD_MASK (shiftleft 1 PRIMARY_INDEX)) 0)
      (set PRIMARY_INDEX (+ PRIMARY_INDEX 1)))

    (set WARN_DRIVER 1)
    (set CARD_INDEX 0)
    (while (< CARD_INDEX 14)
      (
        (if (> (bitand CARD_MASK (shiftleft 1 CARD_INDEX)) 0)
          (P_prepare_card))
        (set CARD_INDEX (+ CARD_INDEX 1))
      ))

    ; The pass above already reported every missing vendor/custom driver.
    ; Preparing the primary again is state setup, not a second warning page.
    (set WARN_DRIVER 0)
    (set CARD_INDEX PRIMARY_INDEX)
    (P_prepare_card)
    (if (= CARD_INDEX 0)
      (set IFNAME "genet")
      (if (= CARD_INDEX 11)
        (set IFNAME "wifipi")
        (set IFNAME "eth0")))

    (if (AND (= MINPICK 2)
             (> (bitand CARD_MASK
                        (bitnot (shiftleft 1 PRIMARY_INDEX))) 0))
      (message
        "Every selected interface will be installed, but the micro stack can "
        "bring only one online at a time.  The highest-priority device is the "
        "one started at boot."
        (help "Micro is intentionally a one-interface build.  Definition "
              "files for the other cards remain available without another "
              "installation.")))

    ; --- unit and interface name: only an expert is asked ---------------

    (if (= @user-level 2)
      (
        (set DEVUNIT
          (asknumber
            (prompt ("Which unit of %s?" DEV_NAME))
            (help   H_UNIT)
            (range 0 15)
            (default 0)))

        (set IF_OK 0)
        (until IF_OK
          (set IFNAME (askstring
            (prompt "Type a name for this interface.")
            (help   H_IFNAME)
            (default "eth0")))
          (set name_in IFNAME)
          (set name_interface 1)
          (P_name_validate)
          (set IF_OK name_ok)
          (if (= IF_OK 0)
              (message "An interface name must be 1 to 15 characters and "
                       "contain only letters, digits, hyphens, underscores "
                       "or full stops.  It cannot begin or end with a hyphen."
                       (help H_IFNAME))))
      ))

    ; --- automatic or manual addressing --------------------------------

    ; Inverted for the reason spelled out at DO_HTTPD below: askbool returns 1
    ; for the first (choices) string.  Written as "No" first with (default 0)
    ; this said MDNS=YES to everyone who clicked "No" and MDNS=NO to everyone
    ; who clicked "Yes"; only a NOVICE run, which takes the (default) and never
    ; draws the page, came out right.
    ; Only the full profile carries mDNS.  Asking this on minimal or micro
    ; offered a setting those stacks could never honor.  The default is the
    ; first button: yes on a 68020 or newer, Emu68 included, no on a 68000.
    ; Derived from the processor, so only Expert is asked.
    (if FULLSET
      (
        (set MDNS_DEF (if CPU020 1 0))
        (set WANTMDNS MDNS_DEF)
        (if (= @user-level 2)
        (set WANTMDNS
          (if (askbool
                (prompt "Answer .local names on the network?")
                (help    H_MDNS)
                (choices (if MDNS_DEF "Yes, answer them" "No .local names")
                         (if MDNS_DEF "No .local names" "Yes, answer them"))
                (default 1))
              MDNS_DEF (- 1 MDNS_DEF))))
      ))

    (set USEDHCP
      (askbool
        (prompt "Does the network hand out addresses automatically?\n\n"
                "If other computers work when they are plugged in, it does.")
        (help    H_DHCP)
        (choices "Yes, use DHCP" "No, I will type them")
        (default 1)))

    ; --- the Wi-Fi ---------------------------------------------------
    (set WIFI_SEL (if (> (bitand CARD_MASK 2048) 0) 1 0))
    (set WIFI_PRIMARY (if (= PRIMARY_INDEX 11) 1 0))
    (if WIFI_PRIMARY
      (
        (set WIFI_IF IFNAME)
        (set WIFI_UNIT DEVUNIT)
      ))
  ))

; A kept configuration is recognised by what its definitions open: the
; definition the startup names (OLD_IF), or the one this installer calls
; wifipi, when its DEVICE= names anxwifipi.device.  WirelessManager is given
; this layout's path for it, or the bare name the file uses.  The search
; strings carry no volume name: on a drawer reinstall before a reboot the
; AmiNetXDuo: assign does not exist yet, and Search given "AmiNetXDuo:..."
; never returned (Amiberry, Workbench 3.1).
(if KEEP_OLD
  (
    (set WIFI_NAME_N 0)
    (while (AND (= WIFI_SEL 0)
                (<> (set WIFI_NAME (select WIFI_NAME_N OLD_IF "wifipi" "")) ""))
      (
        (set KEPT_IF (tackon D_IFDIR WIFI_NAME))
        (if (exists KEPT_IF (noreq))
          (
            (if (= 0 (run ("Search >NIL: FROM \"%s\" SEARCH Networks/anxwifipi.device QUIET"
                           KEPT_IF)
                          (quiet) (safe)))
              (
                (set WIFI_SEL 1)
                (set WIFI_DEV W_ANXWIFIPI)
              )
              (if (= 0 (run ("Search >NIL: FROM \"%s\" SEARCH DEVICE=anxwifipi.device QUIET"
                             KEPT_IF)
                            (quiet) (safe)))
                (
                  (set WIFI_SEL 1)
                  (set WIFI_DEV "anxwifipi.device")
                )
                ))
            (if WIFI_SEL (set WIFI_IF WIFI_NAME))
          ))
        (set WIFI_NAME_N (+ WIFI_NAME_N 1))
      ))
  ))
(if (AND KEEP_OLD WIFI_SEL)
    (set WIFI_PRIMARY (if (= OLD_IF WIFI_IF) 1 0)))
(set WIFI_START (if (AND WIFI_SEL (OR WIFI_PRIMARY (<> MINPICK 2))) 1 0))

; --- the Wi-Fi network ---------------------------------------------------
;
; At every user level: a Pi on Emu68 is found without a question, and Wi-Fi
; with no network named cannot join.  A window of InstallWiFi's own, because
; Installer logs every askstring answer and the passphrase must not reach the
; log.  It writes to T: here, before anything on the disk is changed; the
; file goes to ENVARC:Sys with the rest of the configuration.
(if (AND WIFI_SEL (= WIFI_HAVE_PREFS 0))
  (
    (if (exists WIFI_TMP (noreq))
        (delete WIFI_TMP
                (prompt "Removing a leftover T:AmiNetXDuo-Wireless.prefs")
                (help   H_WIFI)
                (optional "force" "nofail")))
    ; Not in a pretend run: the passphrase would sit in T: for nothing.
    ; The networks in range first, from the driver the interface will name
    ; (the archive's anxwifipi.device, not yet installed): 0 is a network
    ; written, 5 and above (closed, no device) the window below.
    (set WIFI_RC 5)
    (if (AND (= @pretend 0) (exists S_NWPREFS (noreq)))
        (set WIFI_RC (run ("\"%s\" SETUP DEVICE=\"%s\" UNIT=%ld TO %s"
                           (expandpath S_NWPREFS)
                           (if (= WIFI_DEV W_ANXWIFIPI)
                               (expandpath S_ANXWIFIPI) WIFI_DEV)
                           WIFI_UNIT WIFI_TMP)
                          (prompt "Looking for Wi-Fi networks")
                          (help   H_WIFI)
                          (safe))))
    (if (AND (= @pretend 0) (OR (<> WIFI_RC 0) (NOT (exists WIFI_TMP (noreq)))))
      (
        (set WIFI_RC (run ("\"%s\" TO %s" S_INSTWIFI WIFI_TMP)
                          (prompt "Asking for the Wi-Fi network")
                          (help   H_WIFI)
                          (safe)))
        (if (>= WIFI_RC 20)
            (message "The Wi-Fi window could not be opened, so no Wi-Fi "
                     "network is set.  ENVARC:Sys/Wireless.prefs can be "
                     "written later with a text editor; the Manual in "
                     "Aminet's driver/net/prism2v2 describes it."
                     (help H_WIFI)))
      ))
    (set WIFI_NEW_PREFS (if (exists WIFI_TMP (noreq)) 1 0))
  ))

; --- the manual addresses ------------------------------------------------

(set IPADDR "192.168.1.10")
(set IPMASK "255.255.255.0")
(set IPGW   "192.168.1.1")
(set IPDNS  "192.168.1.1")

(if (AND (= KEEP_OLD 0) (= USEDHCP 0))
  (
    (set ask_prompt "Type the Internet address for this Amiga.")
    (set ask_help   H_ADDR)
    (set ask_default IPADDR)
    (P_ask_ip)
    (set IPADDR ask_result)

    (set ask_prompt "What is the netmask for this network?")
    (set ask_help   H_MASK)
    (set ask_default IPMASK)
    (P_ask_ip)
    (set IPMASK ask_result)

    ; the router is nearly always <this network>.1, so offer that
    (set ip_in IPADDR)
    (P_ip_parse)
    (set IPGW ("%ld.%ld.%ld.1" ip_o1 ip_o2 ip_o3))

    (set ask_prompt "What is the address of the router (the gateway)?")
    (set ask_help   H_GW)
    (set ask_default IPGW)
    (P_ask_ip)
    (set IPGW ask_result)

    (set ask_prompt "Type the address of the name server.")
    (set ask_help   H_DNS)
    (set ask_default IPGW)
    (P_ask_ip)
    (set IPDNS ask_result)
  ))

; --- the host name -------------------------------------------------------

; Empty: name_resolution gets the line commented out, and the stack derives
; amiga-<last three address octets> (src/config/config_hostname.c), so two
; machines on one network do not both claim amiga.local.  Expert only.
(set HOSTNAME "")

(if (AND (= KEEP_OLD 0) (= @user-level 2))
  (
    (set HOST_OK 0)
    (until HOST_OK
      (set HOSTNAME
        (askstring
          (prompt "Type the name of this Amiga on the network, or leave it "
                  "empty for amiga- and the card's address.")
          (help   H_HOSTNAME)
          (default "")))
      (set name_in HOSTNAME)
      (set name_interface 0)
      (P_name_validate)
      (set HOST_OK (if (= (strlen HOSTNAME) 0) 1 name_ok))
      (if (= HOST_OK 0)
          (message "A host name must be 1 to 63 characters and contain only "
                   "letters, digits or hyphens.  It cannot begin or end with "
                   "a hyphen."
                   (help H_HOSTNAME))))
  ))

; --- start the network at boot? ------------------------------------------

; Keep scarce RAM available until networking is needed. MEMORY includes used
; RAM and rounds Exec's boot reservation back up to the installed tier.
; The threshold is one byte above 4 MiB: exactly 4 MiB defaults to manual.
; A failed probe also defaults to manual. Micro does so at every RAM size.
(set STARTUP_DEFAULT 0)
(if (AND (<> MINPICK 2)
         (= 0 (run ("\"%s\" MEMORY 4194305" S_NETPROBE) (quiet) (safe))))
    (set STARTUP_DEFAULT 1))
(set DO_STARTUP
  (askbool
    (prompt "Start the network automatically when this Amiga boots?")
    (help    H_STARTUP)
    (choices "Yes, at boot" "No, I will do it")
    (default STARTUP_DEFAULT)))

; KEEP CONFIGURATION MEANS KEEP ITS BOOT POLICY TOO.  S:Network-Startup is a
; user-editable configuration file in both Roadshow and AmiTCP_NG.  Replacing
; it during an ordinary software update changes which of several interfaces
; comes online, even when the user explicitly asked us to keep the setup.  It
; is generated only for a new/reconfigured setup, or when no file existed.
;
; Decided HERE, with the questions, because the SNTP question below is asked
; only when the file is going to be written.  Nothing between here and section
; 8 creates or removes S:Network-Startup, so the answer is the same there.
(set KEEP_NETSTART 0)
(if (AND DO_STARTUP KEEP_OLD
         (exists "S:Network-Startup" (noreq)))
    (set KEEP_NETSTART 1))

; --- serve the volumes, and a Shell in a browser, at boot? ---------------
;
; DEFAULTS TO NO, and that is not timidity.  Every other question here has an
; answer that is right for almost everybody, which is what makes NOVICE mode
; work; this one does not.  Every volume served read-write and a Shell with no
; password is a thing to switch on deliberately and not a thing to hand
; to somebody who pressed Return through an installer, so the default is the
; answer that changes nothing.
;
; Only asked when the network starts at boot.  The lines go into the same
; managed block, immediately after AddNetInterface, and a server started at
; boot on a machine that was told not to bring the network up at boot is a
; contradiction rather than a configuration.  Answering no to the question
; above therefore also takes these lines away, because the whole block is
; rewritten either way.

(set DO_HTTPD   0)
(set HTTPD_PORT 80)

(if DO_STARTUP
  (
    ; askbool returns 1 for the FIRST (choices) string and 0 for the second,
    ; whatever the two say.  A question whose answer is no by default
    ; therefore puts "No" first, defaults to 1, and inverts here -- which also
    ; keeps the property the whole script has and install/test/installdrive.c
    ; relies on: the first button on a page IS that page's default.
    (set DO_HTTPD
      (if (askbool
            (prompt "Serve every volume, an AmigaDOS Shell and this Amiga's "
                    "display in a web browser, "
                    "when this Amiga boots?\n\n"
                    "None has a password: whoever can reach the port gets "
                    "all three.")
            (help    H_HTTPD)
            (choices "No" "Yes, serve them")
            (default 1))
          0 1))

    ; Port 80 unless an Expert names another.
    (if (AND DO_HTTPD (= @user-level 2))
      (
        (set HTTPD_PORT
          (asknumber
            (prompt "Type the port number for httpd.")
            (help    H_HTTPDPORT)
            (range   1 65535)
            (default 80)))
      ))
  ))

; --- set the clock at boot? ----------------------------------------------
;
; DEFAULTS TO YES: most Amigas, a PiStorm's included, have no battery clock
; and boot in 1978.  sntp runs in the background, so a boot without a network
; is not held up.  pool.ntp.org unless an Expert names another server.
;
; Asked only when S:Network-Startup is generated on this run.  A kept file is
; not touched, so a setting asked for there would never be applied.  Asked
; only of an Expert: the yes is right for every machine without a battery
; clock, and harmless on the others.

(set DO_SNTP    0)
(set NTP_SERVER "pool.ntp.org")

(if (AND DO_STARTUP (= KEEP_NETSTART 0))
  (
    (set DO_SNTP 1)
    (if (= @user-level 2)
      (set DO_SNTP
        (askbool
          (prompt "Set the clock from an Internet time server when this "
                  "Amiga boots?")
          (help    H_SNTP)
          (choices "Yes, set the clock" "No")
          (default 1))))

    (if (AND DO_SNTP (= @user-level 2))
      (
        (set ask_prompt "Type the name of the time server.")
        (set ask_help   H_SNTPSERVER)
        (set ask_default NTP_SERVER)
        (P_ask_host)
        (set NTP_SERVER ask_result)
      ))
  ))

(complete 10)

; ==========================================================================
;  5.  Copy the software
; ==========================================================================

(set @default-dest DOCDIR)

; The drawer paths were selected above, but are made only now, after the last
; question.  Cancel from any question therefore leaves a new destination
; untouched, which is the transaction model Commodore Installer users expect.
; textfile does not create intermediate directories, so all three DEVS:
; children must exist before the configuration phase reaches them.
(if DRAWER_LAYOUT
  (
    (makedir D_ROOT (infos))
    (makedir D_LIBS)
    (makedir D_C)
    (makedir D_DEVS)
    (makedir (tackon D_DEVS "Networks"))
    (makedir (tackon D_DEVS "NetInterfaces"))
    (makedir (tackon D_DEVS "Internet"))
  ))

; --- the libraries -------------------------------------------------------
;
; A running stack holds LIBS:bsdsocket.library open and the copy then fails
; with a DOS error that means nothing to a novice.  @special-msg puts the
; explanation in front of it.

(set @special-msg
  (cat "If this failed because the file is in use, the network is already "
       "running.  Reboot, then run this installer again before anything "
       "else.\n"))

; STAGED, THEN SWAPPED.
;
; A library that is open cannot be written over, so the one that is there has
; to be moved aside -- but moving it aside FIRST and copying afterwards leaves
; a window with no bsdsocket.library in LIBS: at all, and anything that ends
; the copy inside that window leaves the machine without the library its
; network IS: a full disk, a media error, or the user answering no to the
; copy's own (confirm) requester.  It is not a disk-full-only hazard; a
; declined requester is one click.
;
; So the new file is copied in beside the live one under a .new name, and only
; then is the swap made.  The space and the user's decision are both committed
; before anything live is touched, and the swap itself is renames: no disk
; space, nothing that can half-finish.  If the copy did not happen, no .new
; exists, the swap is skipped and the library that is there is the library
; that stays.
;
; copylib became copyfiles because the version comparison copylib does was
; already doing nothing here: the old file had been renamed away before it
; ran, so there was never a destination to compare against.

; --- another stack's files, kept --------------------------------------
;
; Everything of another stack that this run will write over is copied first,
; before the first file is replaced: its libraries, and when the network is
; set up again its interface files (every one), routes, name_resolution and
; S:Network-Startup.  A copy that fails stops the installation here, with
; nothing on the disk changed.
;
; Into a drawer of this run's own under the AmiNetXDuo drawer's Backup,
; numbered one above the highest there, made only when there is something to
; keep, so no run writes into what an earlier one kept and the lowest number
; is the other stack as it was first found.  A file is another stack's when
; it names neither AmiNetXDuo nor NetSetup (which writes "Written by
; NetSetup.").  One already kept, byte for byte, in an earlier drawer is not
; kept again.  AmigaDOS Copy CLONE keeps protection bits, date and comment.
; Nothing of this in a pretend run.
(set D_BACKUP_TOP (tackon DOCDIR "Backup"))
; Installed: a copy of each configuration file and icon as this
; installation left it, and the tools the record runs.
(set D_INSTALLED (tackon DOCDIR "Installed"))
(set BK_SUB "")
(set D_BACKUP "")
(set BK_MAX 0)
(if (= (exists D_BACKUP_TOP (noreq)) 2)
    (foreach D_BACKUP_TOP "#?"
      (if (AND (> @each-type 0) (patmatch (cat "#" P_DIGIT) @each-name))
          (if (> (+ @each-name 0) BK_MAX) (set BK_MAX (+ @each-name 0))))))
(set FOREIGN_STACK (if (AND OLD_BSD (= LIB_OURS 0) (= DRAWER_LAYOUT 0)) 1 0))

; IS_OURS: BK_SRC names AmiNetXDuo, NetSetup wrote it, it carries the
; phrase BK_MARK, or it is the archive's BK_ARCH byte for byte (an icon, a
; netdb file, the certificate store).
(set BK_MARK "")
(set BK_ARCH "")
(procedure P_is_ours
  (set IS_OURS 0)
  (if (= 0 (run ("\"%s\" \"%s\" AmiNetXDuo MARK" S_SAMEFILE BK_SRC)
                (quiet) (safe)))
      (set IS_OURS 1))
  (if (= IS_OURS 0)
      (if (= 0 (run ("\"%s\" \"%s\" \"Written by NetSetup\" MARK"
                     S_SAMEFILE BK_SRC)
                    (quiet) (safe)))
          (set IS_OURS 1)))
  (if (AND (= IS_OURS 0) (> (strlen BK_MARK) 0))
      (if (= 0 (run ("\"%s\" \"%s\" \"%s\" MARK" S_SAMEFILE BK_SRC BK_MARK)
                    (quiet) (safe)))
          (set IS_OURS 1)))
  (if (AND (= IS_OURS 0) (> (strlen BK_ARCH) 0))
      (if (exists BK_ARCH (noreq))
          (if (= 0 (run ("\"%s\" \"%s\" \"%s\" BYTES" S_SAMEFILE BK_SRC BK_ARCH)
                        (quiet) (safe)))
              (set IS_OURS 1))))
  ; What an earlier installation left there, unchanged since.
  (if (AND (= IS_OURS 0) (> (strlen BK_SUB) 0))
    (
      (set BK_SNAP (tackon (tackon D_INSTALLED BK_SUB) (fileonly BK_SRC)))
      (if (exists BK_SNAP (noreq))
          (if (= 0 (run ("\"%s\" \"%s\" \"%s\" BYTES" S_SAMEFILE BK_SRC BK_SNAP)
                        (quiet) (safe)))
              (set IS_OURS 1)))
    ))
)

; KEPT: an earlier Backup drawer holds BK_SRC, byte for byte, under its own
; name or, for a .old file, the name it had before it was renamed so.
(procedure P_kept_before
  (set KEPT 0)
  (set KB_NAME (fileonly BK_SRC))
  (set KB_BASE KB_NAME)
  (if (patmatch "#?.old" KB_NAME)
      (set KB_BASE (substr KB_NAME 0 (- (strlen KB_NAME) 4))))
  (set KB_N 1)
  (while (AND (= KEPT 0) (<= KB_N BK_MAX))
    (
      (set KB_DIR (tackon (tackon D_BACKUP_TOP ("%ld" KB_N)) BK_SUB))
      (set KB_DONE (exists (tackon (tackon D_BACKUP_TOP ("%ld" KB_N)) "Restore")
                           (noreq)))
      (set KB_I 0)
      (while (AND (= KEPT 0) (< KB_I 2))
        (
          (set KB_F (tackon KB_DIR (select KB_I KB_NAME KB_BASE)))
          (if (AND KB_DONE (exists KB_F (noreq)))
              (if (= 0 (run ("\"%s\" \"%s\" \"%s\" BYTES" S_SAMEFILE BK_SRC KB_F)
                            (quiet) (safe)))
                  (set KEPT 1)))
          (set KB_I (+ KB_I 1))
        ))
      (set KB_N (+ KB_N 1))
    ))
)

; BK_SRC into this run's Backup drawer/BK_SUB when it is another stack's,
; and into BK_RESTORE the lines that put it back where it was: only where
; nothing is there by then, so a file the user has since changed stays.
(set BK_RESTORE "")
(set BK_PART 0)
(procedure P_backup
  (if (AND (= @pretend 0) (exists BK_SRC (noreq)))
    (
      (P_is_ours)
      (if (= IS_OURS 0) (P_kept_before))
      (if (AND (= IS_OURS 0) (= KEPT 0))
        (
          (if (= (strlen D_BACKUP) 0)
            (
              (set D_BACKUP (tackon D_BACKUP_TOP ("%ld" (+ BK_MAX 1))))
              (makedir DOCDIR (prompt ("Creating %s" DOCDIR)) (help H_DOCDIR))
              (makedir D_BACKUP_TOP (prompt ("Creating %s" D_BACKUP_TOP))
                       (help H_BACKUP))
              (makedir D_BACKUP (prompt ("Creating %s" D_BACKUP)) (help H_BACKUP))
            ))
          (set BK_DIR (tackon D_BACKUP BK_SUB))
          (if (NOT (exists (tackon BK_DIR (fileonly BK_SRC)) (noreq)))
            (
              (if (patmatch "#?/#?" BK_SUB)
                  (makedir (pathonly BK_DIR)
                           (prompt ("Creating %s" (pathonly BK_DIR)))
                           (help H_BACKUP)))
              (makedir BK_DIR (prompt ("Creating %s" BK_DIR)) (help H_BACKUP))
              (set BK_FILE (tackon BK_DIR (fileonly BK_SRC)))
              (if (OR (<> 0 (run ("Copy \"%s\" TO \"%s\" CLONE QUIET" BK_SRC BK_DIR)
                                 (prompt ("Keeping %s in %s" BK_SRC BK_DIR))
                                 (help   H_BACKUP)))
                      (NOT (exists BK_FILE (noreq))))
                (
                  ; A part-copy must not stand in for the file later.
                  (if (exists BK_FILE (noreq))
                      (delete BK_FILE
                              (prompt ("Removing the incomplete %s" BK_FILE))
                              (help   H_BACKUP)
                              (optional "force" "nofail")))
                  ; And this run's drawer: without its Restore it would
                  ; pass for a kept copy in the next run.
                  (run ("Delete \"%s\" ALL QUIET FORCE" D_BACKUP)
                       (prompt ("Removing %s" D_BACKUP))
                       (help   H_BACKUP))
                  (abort (cat "The copy of " BK_SRC " into " BK_DIR " failed.  "
                              "Nothing on the disk has been replaced.\n\n"
                              "Free space on that volume and run the installer "
                              "again."))
                ))
              ; An earlier drawer's copy of the same name goes back first.
              (set BK_LOW "")
              (set BK_N 1)
              (while (AND (= (strlen BK_LOW) 0) (<= BK_N BK_MAX))
                (
                  (set BK_C (tackon (tackon (tackon D_BACKUP_TOP ("%ld" BK_N)) BK_SUB)
                                    (fileonly BK_SRC)))
                  (if (AND (exists BK_C (noreq))
                           (exists (tackon (tackon D_BACKUP_TOP ("%ld" BK_N)) "Restore")
                                   (noreq)))
                      (set BK_LOW BK_C))
                  (set BK_N (+ BK_N 1))
                ))
              ; Something else in its place -- a file of ours changed since
              ; -- is not written over, and Backup stays for it.
              (set BK_SAME (cat "  \"" REC_SF "\" \"" BK_SRC "\" \"" BK_FILE "\" BYTES\n"
                                "  If WARN\n"))
              (set BK_CLASH (cat "    Echo >>T:AmiNetXDuo-NotRestored \"" BK_SRC
                                 " is not the one in " BK_FILE "\"\n"))
              (set BK_ADD
                (cat "If NOT EXISTS \"" BK_SRC "\"\n"
                     "  Copy \"" BK_FILE "\" TO \"" BK_SRC "\" CLONE QUIET\n"
                     "  If ERROR\n"
                     "    Delete \"" BK_SRC "\" QUIET\n"
                     "    Echo >>T:AmiNetXDuo-NotRestored \"" BK_SRC
                     " could not be copied from " BK_FILE "\"\n"
                     "  EndIf\n"
                     "Else\n"
                     BK_SAME
                     (if (> (strlen BK_LOW) 0)
                         (cat "    \"" REC_SF "\" \"" BK_SRC "\" \"" BK_LOW "\" BYTES\n"
                              "    If WARN\n"
                              "  " BK_CLASH
                              "    EndIf\n")
                         BK_CLASH)
                     "  EndIf\n"
                     "EndIf\n"))
              (if (> (+ (strlen BK_RESTORE) (strlen BK_ADD)) 2000)
                (
                  (set BK_PART (+ BK_PART 1))
                  (textfile
                    (prompt "Writing the Backup drawer's Restore script")
                    (help   H_BACKUP)
                    (dest   (tackon D_BACKUP ("RestorePart%ld" BK_PART)))
                    (append BK_RESTORE))
                  (set BK_RESTORE "")
                ))
              (set BK_RESTORE (cat BK_RESTORE BK_ADD))
            ))
        ))
    ))
)

; --- the record Uninstall-AmiNetXDuo runs --------------------------------
;
; S:AmiNetXDuo-Files, an AmigaDOS script, in this order:
;  - Installed/Remove: each configuration file and icon this installation
;    wrote, deleted where it is as it was left, kept and listed in
;    T:AmiNetXDuo-Kept where it has been changed since;
;  - each program that names AmiNetXDuo;
;  - a .old that names AmiNetXDuo, or that is another stack's file a rename
;    left there (the same bytes as its Backup copy);
;  - every Backup drawer's Restore, lowest number first: a file goes back
;    only where nothing is there by then, so the other stack as first found
;    wins and nothing in place is written over;
;  - the drawers this installation made, where they are empty;
;  - Backup and Installed, unless T:AmiNetXDuo-NotRestored lists a file not
;    put back; then the drawer's own files, and the drawer when nothing
;    else is in it.
; Written before the first file is replaced (REC_FINAL 0), so that an
; installation stopped part way can be undone, and again at the end with
; Installed/Remove.
(set REC_SF (tackon D_INSTALLED "InstallSameFile"))

; An Installer string has a length limit, and the record is longer: it is
; written in parts, Installed/Part<n> and Installed/RemovePart<n>, which
; P_rec_join puts together with Type.
(procedure P_rec_flush
  (if (> (strlen REC_TEXT) 0)
    (
      (set REC_PART (+ REC_PART 1))
      (textfile
        (prompt "Writing the record of this installation")
        (help   H_BACKUP)
        (dest   (tackon D_INSTALLED ("Part%ld" REC_PART)))
        (append REC_TEXT))
      (set REC_TEXT "")
    ))
)
(procedure P_rec_add
  (if (> (+ (strlen REC_TEXT) (strlen REC_ADD)) 2000) (P_rec_flush))
  (set REC_TEXT (cat REC_TEXT REC_ADD))
)
(procedure P_rem_flush
  (if (> (strlen REM_TEXT) 0)
    (
      (set REM_PART (+ REM_PART 1))
      (textfile
        (prompt "Writing the record of this installation")
        (help   H_BACKUP)
        (dest   (tackon D_INSTALLED ("RemovePart%ld" REM_PART)))
        (append REM_TEXT))
      (set REM_TEXT "")
    ))
)
; JN_DEST, after its first lines (already written), gets JN_STEM1 ..
; JN_STEM<JN_N>, each deleted after.
(procedure P_rec_join
  (set JN_I 1)
  (while (<= JN_I JN_N)
    (
      (set JN_F (tackon D_INSTALLED ("%s%ld" JN_STEM JN_I)))
      (if (<> 0 (run ("Type >>\"%s\" \"%s\"" JN_DEST JN_F)
                     (prompt "Writing the record of this installation")
                     (help   H_BACKUP)))
          (abort (cat "Writing " JN_DEST " failed: " JN_F " could not be "
                      "added to it.  Free space on that volume and run the "
                      "installer again.")))
      (delete JN_F (optional "force" "nofail"))
      (set JN_I (+ JN_I 1))
    ))
)

; REC_F, a program this installation put there: another stack's or the
; user's file of that name is in Backup, and comes back after.
(procedure P_rec_ours
  ((set REC_ADD (cat "Delete \"" REC_F "\" QUIET\n")) (P_rec_add))
)

; REC_F a .old in REC_SUB, deleted when it is ours, or the other stack's
; renamed by this installation: the lowest Backup copy of its name has its
; bytes, and its Restore, after, puts that copy back.  Before the Restores,
; because a Restore of the other stack's own .old needs the name free; a
; Restore that fails lists the path and Backup keeps the bytes.
(procedure P_rec_old
  (set RO_BASE (fileonly (substr REC_F 0 (- (strlen REC_F) 4))))
  (set RO_LB "")
  (set RO_N 1)
  (while (AND (= (strlen RO_LB) 0) (<= RO_N REC_TOPN))
    (
      (set RO_C (tackon (tackon (tackon D_BACKUP_TOP ("%ld" RO_N)) REC_SUB)
                        RO_BASE))
      (if (AND (exists RO_C (noreq))
               (exists (tackon (tackon D_BACKUP_TOP ("%ld" RO_N)) "Restore") (noreq)))
          (set RO_LB RO_C))
      (set RO_N (+ RO_N 1))
    ))
  (if (exists REC_F (noreq))
    (
      (set BK_SRC REC_F)
      (set RO_SUB BK_SUB)
      (set BK_SUB "")
      (P_is_ours)
      (set BK_SUB RO_SUB)
      (if IS_OURS
          ((set REC_ADD (cat "Delete \"" REC_F "\" QUIET\n")) (P_rec_add))
          ; The other stack's file, renamed: it goes only where the
          ; original's place is free for its Backup copy to come back to.
          (if (> (strlen RO_LB) 0)
              ((set REC_ADD (cat
                     "If NOT EXISTS \"" (substr REC_F 0 (- (strlen REC_F) 4)) "\"\n"
                     "  If EXISTS \"" REC_F "\"\n"
                     "    \"" REC_SF "\" \"" REC_F "\" \"" RO_LB "\" BYTES\n"
                     "    If NOT WARN\n"
                     "      Delete \"" REC_F "\" QUIET\n"
                     "    EndIf\n"
                     "  EndIf\n"
                     "EndIf\n")) (P_rec_add))))
    ))
)

; REC_F, a drawer this installation made (RD_MADE now, or the marker
; RD_KEY in Installed from an earlier run): removed when empty.
(procedure P_rec_dir
  (set RD_MARK (tackon D_INSTALLED RD_KEY))
  (if (OR RD_MADE (exists RD_MARK (noreq)))
    (
      (if (AND REC_FINAL RD_MADE)
          (textfile
            (prompt ("Writing %s" RD_MARK))
            (help   H_BACKUP)
            (dest   RD_MARK)
            (append "; made by the AmiNetXDuo installer\n")))
      ((set REC_ADD (cat "Delete \"" REC_F "\" QUIET\n")) (P_rec_add))
    ))
)

; RT_SRC, an archive drawer copied to RT_DST: each file and one level of
; drawers below, by name, then RT_DST itself when empty.
(procedure P_rec_tree
  (if (= (exists RT_SRC (noreq)) 2)
    (
      (foreach RT_SRC "#?"
        (
          (set RT_NAME @each-name)
          (if (> @each-type 0)
            (
              (set RT_SUBSRC (tackon RT_SRC RT_NAME))
              (set RT_SUBDST (tackon RT_DST RT_NAME))
              (foreach RT_SUBSRC "#?"
                (if (< @each-type 0)
                    (
                      ((set REC_ADD (cat "Delete \""
                             (tackon RT_SUBDST @each-name) "\" QUIET\n")) (P_rec_add))
                    )))
              ((set REC_ADD (cat "Delete \"" RT_SUBDST "\" QUIET\n")) (P_rec_add))
            )
            ((set REC_ADD (cat "Delete \"" (tackon RT_DST RT_NAME) "\" QUIET\n")) (P_rec_add)))
        ))
      (if RT_SELF
          ((set REC_ADD (cat "Delete \"" RT_DST "\" QUIET\n")) (P_rec_add)))
    ))
)

; SN_T, a configuration file or icon in BK_SUB, into Installed/Remove when
; it is ours (P_is_ours with BK_MARK/BK_ARCH, or SN_WROTE: this run copied
; it) or a Backup drawer holds the other stack's copy.  Its copy in
; Installed is taken again when SN_FRESH (this run wrote it) or there is
; none yet, so a change made since an earlier run is still a change.
(procedure P_snap
  (if (= (exists SN_T (noreq)) 1)
    (
      (set BK_SRC SN_T)
      (set SN_SUB BK_SUB)
      (set BK_SUB "")
      (set IS_OURS SN_WROTE)
      (if (= IS_OURS 0) (P_is_ours))
      (set BK_SUB SN_SUB)
      (set SN_BACKED 0)
      (set SN_N 1)
      (while (AND (= SN_BACKED 0) (<= SN_N REC_TOPN))
        (
          (if (exists (tackon (tackon (tackon D_BACKUP_TOP ("%ld" SN_N)) BK_SUB)
                              (fileonly SN_T)) (noreq))
              (set SN_BACKED 1))
          (set SN_N (+ SN_N 1))
        ))
      (if (OR IS_OURS SN_BACKED)
        (
          (set SN_DIR (tackon D_INSTALLED BK_SUB))
          (set SN_COPY (tackon SN_DIR (fileonly SN_T)))
          (if (OR SN_FRESH (NOT (exists SN_COPY (noreq))))
            (
              (if (patmatch "#?/#?" BK_SUB)
                  (makedir (pathonly SN_DIR)
                           (prompt ("Creating %s" (pathonly SN_DIR)))
                           (help H_BACKUP)))
              (makedir SN_DIR (prompt ("Creating %s" SN_DIR)) (help H_BACKUP))
              (run ("Copy \"%s\" TO \"%s\" CLONE QUIET" SN_T SN_DIR)
                   (prompt ("Keeping a copy of %s as it was installed" SN_T))
                   (help   H_BACKUP))
            ))
          (if (exists SN_COPY (noreq))
              (set REM_ADD
                (cat
                     "If EXISTS \"" SN_T "\"\n"
                     "  \"" REC_SF "\" \"" SN_T "\" \"" SN_COPY "\" BYTES\n"
                     "  If WARN\n"
                     "    Echo >>T:AmiNetXDuo-Kept \"" SN_T "\"\n"
                     "  Else\n"
                     "    Delete \"" SN_T "\" QUIET\n"
                     "  EndIf\n"
                     "EndIf\n")))
          (if (exists SN_COPY (noreq))
            (
              (if (> (+ (strlen REM_TEXT) (strlen REM_ADD)) 2000) (P_rem_flush))
              (set REM_TEXT (cat REM_TEXT REM_ADD))
            ))
        ))
    ))
  (set BK_MARK "")
  (set BK_ARCH "")
  (set SN_WROTE 0)
)

(procedure P_write_record
  (if (= @pretend 0)
  (
  (set REC_TOPN (+ BK_MAX (if (> (strlen D_BACKUP) 0) 1 0)))
  (makedir DOCDIR (prompt ("Creating %s" DOCDIR)) (help H_DOCDIR))
  (makedir D_INSTALLED (prompt ("Creating %s" D_INSTALLED)) (help H_BACKUP))
  (copyfiles
    (prompt "Installing InstallSameFile for Uninstall-AmiNetXDuo")
    (help   H_BACKUP)
    (source S_SAMEFILE)
    (dest   D_INSTALLED)
    (optional "force" "nofail"))

  ; Installed/Remove, at the end only: the files are written by then.
  (if REC_FINAL
    (
      (set REM_TEXT "")
      (set REM_PART 0)
      (set SN_WROTE 0)
      (set SN_FRESH (if (= KEEP_OLD 0) 1 0))
      (set BK_SUB "Devs/NetInterfaces")
      (if (= (exists D_IFDIR (noreq)) 2)
          (foreach D_IFDIR "~(#?.info)"
            (if (< @each-type 0)
              (
                (set SN_T (tackon D_IFDIR @each-name))
                (P_snap)
              ))))
      (set BK_SUB "Devs/Internet")
      (set SN_T (tackon D_DEVS "Internet/routes")) (P_snap)
      (set SN_T (tackon D_DEVS "Internet/name_resolution")) (P_snap)
      (set SN_FRESH 0)
      (set BK_MARK "names this machine knows by itself")
      (set SN_T (tackon D_DEVS "Internet/hosts")) (P_snap)
      (set RN_N 0)
      (while (set RN_F (select RN_N "protocols" "services" "networks" ""))
        (
          (set BK_ARCH (tackon (tackon S_DEVS "Internet") RN_F))
          (set SN_T (tackon (tackon D_DEVS "Internet") RN_F)) (P_snap)
          (set RN_N (+ RN_N 1))
        ))
      (set SN_FRESH 1)
      (set BK_ARCH (tackon (tackon S_DEVS "Internet") "certificates"))
      (set SN_T (tackon (tackon D_DEVS "Internet") "certificates")) (P_snap)
      (set BK_SUB "S")
      (set SN_FRESH (if (AND DO_STARTUP (= KEEP_NETSTART 0)) 1 0))
      (set SN_T "S:Network-Startup") (P_snap)
      ; The icons this run copied, as they came out of the copy.
      (set SN_FRESH 1)
      (if (= DRAWER_LAYOUT 0)
        (
          (set BK_SUB "Prefs")
          (set SN_WROTE 1) (set SN_T "SYS:Prefs/NetPrefs.info") (P_snap)
          (set SN_WROTE 1) (set SN_T "SYS:Prefs/NetWirelessPrefs.info") (P_snap)
          (set BK_SUB "Utilities")
          (set SN_WROTE 1) (set SN_T "SYS:Utilities/NetMeter.info") (P_snap)
          (set SN_WROTE 1) (set SN_T "SYS:Utilities/NetSwitch.info") (P_snap)
          (set SN_WROTE 1) (set SN_T "SYS:Utilities/NetSwitch.ilbm") (P_snap)
          (set BK_SUB "Tools/Commodities")
          (set SN_WROTE 1) (set SN_T "SYS:Tools/Commodities/NetWireless.info") (P_snap)
        )
        (
          (set BK_SUB "AmiNetXDuo")
          (set SN_WROTE 1) (set SN_T (tackon D_ROOT "NetSwitch.ilbm")) (P_snap)
        ))
      (set BK_SUB "")
      (P_rem_flush)
      (textfile
        (prompt "Writing the record of the configuration this installation wrote")
        (help   H_BACKUP)
        (dest   (tackon D_INSTALLED "Remove"))
        (append "; Remove -- written by the AmiNetXDuo installer.\n")
        (append "FailAt 21\n"))
      (set JN_DEST (tackon D_INSTALLED "Remove"))
      (set JN_STEM "RemovePart")
      (set JN_N REM_PART)
      (P_rec_join)
    ))

  (set REC_TEXT "")
  (set REC_PART 0)
  (set REC_F (tackon D_INSTALLED "Remove"))
  (set REC_TEXT
    (cat "Delete >NIL: T:AmiNetXDuo-NotRestored QUIET\n"
         "Echo \"record started\"\n"
         "Delete >NIL: T:AmiNetXDuo-Kept QUIET\n"
         "Delete >NIL: T:AmiNetXDuo-DrawerKept QUIET\n"
         "If EXISTS \"" REC_F "\"\n"
         "  Execute \"" REC_F "\"\n"
         "EndIf\n"))
  ; The programs.
  (set REC_F D_BSD) (P_rec_ours)
  (set REC_F D_UG)  (P_rec_ours)
  (set REC_F D_TLS) (P_rec_ours)
  (foreach S_C "~(fat|#?.info)"
    (if (< @each-type 0)
      (
        (set REC_F (tackon D_C @each-name))
        (P_rec_ours)
      )))
  (set REC_F (if DRAWER_LAYOUT (tackon D_ROOT "NetPrefs") "SYS:Prefs/NetPrefs"))
  (P_rec_ours)
  (set REC_F (if DRAWER_LAYOUT (tackon D_ROOT "NetMeter") "SYS:Utilities/NetMeter"))
  (P_rec_ours)
  (set REC_F (if DRAWER_LAYOUT (tackon D_ROOT "NetSwitch") "SYS:Utilities/NetSwitch"))
  (P_rec_ours)
  (set REC_F (if DRAWER_LAYOUT (tackon D_ROOT "NetSwitch.ilbm")
                 "SYS:Utilities/NetSwitch.ilbm"))
  (P_rec_ours)
  (set REC_F (if DRAWER_LAYOUT (tackon D_ROOT "NetWirelessPrefs")
                 "SYS:Prefs/NetWirelessPrefs"))
  (P_rec_ours)
  (set REC_F (if DRAWER_LAYOUT (tackon D_ROOT "NetWireless")
                 "SYS:Tools/Commodities/NetWireless"))
  (P_rec_ours)
  (set REC_N 0)
  (while (set REC_SUB (select REC_N "anxnet.device" "anxgenet.device"
                                    "anxwifipi.device" "anxzz9000.device" ""))
    (
      (set REC_F (tackon (tackon D_DEVS "Networks") REC_SUB)) (P_rec_ours)
      (set REC_F (cat REC_F ".old"))
      (set REC_SUB "Devs/Networks")
      (P_rec_old)
      (set REC_N (+ REC_N 1))
    ))
  ; Retain legacy Prism2/Hermes uninstall records for prior installations;
  ; this version never installs those files.
  ; Only external files this installer added. A user's existing copy never
  ; gets a marker, and a later edited/replaced copy is kept on uninstall.
  (set PC_N 0)
  (while (set PC_REL (select PC_N "Devs/Networks/prism2.device"
                                  "Devs/Networks/xircomce2.device"
                                  "Libs/pccard.library"
                                  "Devs/Firmware/HermesI" "Devs/Firmware/HermesII" ""))
    (
      (set PC_MARK (tackon (tackon D_INSTALLED "PCMCIA") (fileonly PC_REL)))
      (set PC_TARGET (if (= PC_N 2) (tackon D_LIBS "pccard.library")
                      (tackon D_DEVS (substr PC_REL 5 (- (strlen PC_REL) 5)))))
      (if (exists PC_MARK (noreq))
        ((set REC_ADD (cat
          "If EXISTS \"" PC_TARGET "\"\n"
          "  \"" REC_SF "\" \"" PC_TARGET "\" \"" PC_MARK "\" BYTES\n"
          "  If WARN\n"
          "    Echo >>T:AmiNetXDuo-Kept \"" PC_TARGET "\"\n"
          "  Else\n"
          "    Delete \"" PC_TARGET "\" QUIET\n"
          "  EndIf\n"
          "EndIf\n")) (P_rec_add)))
      (set PC_N (+ PC_N 1))
    ))
  ; codesets.library, when this installer put it there and it is unchanged;
  ; Backup's Restore below then puts back the one it replaced.
  (set CS_MARK (tackon (tackon D_INSTALLED "Codesets") "codesets.library"))
  (set CS_TARGET (tackon D_LIBS "codesets.library"))
  (if (exists CS_MARK (noreq))
    ((set REC_ADD (cat
      "If EXISTS \"" CS_TARGET "\"\n"
      "  \"" REC_SF "\" \"" CS_TARGET "\" \"" CS_MARK "\" BYTES\n"
      "  If WARN\n"
      "    Echo >>T:AmiNetXDuo-Kept \"" CS_TARGET "\"\n"
      "  Else\n"
      "    Delete \"" CS_TARGET "\" QUIET\n"
      "  EndIf\n"
      "EndIf\n")) (P_rec_add)))
  ; The .old files.
  (set REC_SUB "Libs")
  (set REC_F D_BSD_OLD) (P_rec_old)
  (set REC_F D_UG_OLD)  (P_rec_old)
  (set REC_F D_TLS_OLD) (P_rec_old)
  (set REC_SUB "S")
  (set REC_F "S:Network-Startup.old") (P_rec_old)
  ; Back from Backup, lowest first.
  (set REC_N 1)
  (while (<= REC_N REC_TOPN)
    (
      (set REC_F (tackon (tackon D_BACKUP_TOP ("%ld" REC_N)) "Restore"))
      ((set REC_ADD (cat
             "If EXISTS \"" REC_F "\"\n"
             "  Execute \"" REC_F "\"\n"
             "EndIf\n")) (P_rec_add))
      (set REC_N (+ REC_N 1))
    ))
  ; The drawers this installation made, empty by now unless somebody else
  ; put something there.
  (set REC_F (tackon D_DEVS "Networks")) (set RD_MADE MADE_NETWORKS)
  (set RD_KEY "Made-Networks") (P_rec_dir)
  (set REC_F (tackon D_DEVS "Firmware")) (set RD_MADE MADE_FIRMWARE)
  (set RD_KEY "Made-Firmware") (P_rec_dir)
  (set REC_F D_IFDIR) (set RD_MADE MADE_IFDIR)
  (set RD_KEY "Made-NetInterfaces") (P_rec_dir)
  (set REC_F (tackon D_DEVS "Internet")) (set RD_MADE MADE_INTERNET)
  (set RD_KEY "Made-Internet") (P_rec_dir)
  (set REC_F "SYS:Tools/Commodities") (set RD_MADE MADE_COMMODITIES)
  (set RD_KEY "Made-Commodities") (P_rec_dir)
  (set REC_F "SYS:Tools") (set RD_MADE MADE_TOOLS)
  (set RD_KEY "Made-Tools") (P_rec_dir)
  ((set REC_ADD (cat
         "If NOT EXISTS T:AmiNetXDuo-NotRestored\n"
         "  Delete \"" D_BACKUP_TOP "\" ALL QUIET\n"
         "  Delete \"" D_INSTALLED "\" ALL QUIET\n"
         "EndIf\n")) (P_rec_add))
  ; The PCMCIA manuals/licences, copied as one small drawer.
  (set REC_F (tackon (tackon DOCDIR "PCMCIA") "README")) (P_rec_ours)
  (set RT_SELF 1)
  (set RT_SRC S_PCMDOCS) (set RT_DST (tackon DOCDIR "PCMCIA")) (P_rec_tree)
  ; codesets.library's source pointer, the same way.
  (set REC_F (tackon (tackon DOCDIR "Codesets") "SOURCE")) (P_rec_ours)
  (set REC_F (tackon DOCDIR "Codesets")) (P_rec_ours)
  ; The drawer's own files, by name.
  (set RT_SELF 0)
  (set RT_SRC S_DOCS) (set RT_DST DOCDIR) (P_rec_tree)
  (set RT_SELF 1)
  (set RT_SRC S_EXAM) (set RT_DST (tackon DOCDIR "Examples")) (P_rec_tree)
  (set RT_SRC S_TERM) (set RT_DST (tackon DOCDIR "Terminal")) (P_rec_tree)
  (set REC_N 0)
  (while (set REC_SUB (select REC_N "Installer" "Uninstall-AmiNetXDuo"
                                    "Uninstall-AmiNetXDuo.info" "ReadMe"
                                    "ReadMe.info" "Examples.info"
                                    "Terminal.info" "WirelessManager-LICENSE" ""))
    (
      ((set REC_ADD (cat "Delete \"" (tackon DOCDIR REC_SUB) "\" QUIET\n")) (P_rec_add))
      (set REC_N (+ REC_N 1))
    ))
  (if DRAWER_LAYOUT
    (
      (set REC_N 0)
      (while (set REC_SUB (select REC_N "NetPrefs.info" "NetMeter.info"
                                        "NetSwitch.info"
                                        "NetWireless.info" "NetWirelessPrefs.info"
                                        "C.info" ""))
        (
          ((set REC_ADD (cat "Delete \"" (tackon D_ROOT REC_SUB) "\" QUIET\n"
                             "Delete \"" (tackon D_C REC_SUB) "\" QUIET\n")) (P_rec_add))
          (set REC_N (+ REC_N 1))
        ))
      (set RT_SELF 0)
      (set RT_SRC S_C) (set RT_DST D_C) (P_rec_tree)
      (set RT_SRC S_FIRMWARE) (set RT_DST (tackon D_DEVS "Firmware")) (P_rec_tree)
      ((set REC_ADD (cat
             "Delete \"" (tackon D_C "fat") "\" QUIET\n"
             "Delete \"" (tackon D_DEVS "Firmware") "\" QUIET\n"
             "Delete \"" (tackon D_DEVS "Networks") "\" QUIET\n"
             "Delete \"" D_IFDIR "\" QUIET\n"
             "Delete \"" (tackon D_DEVS "Internet") "\" QUIET\n"
             "Delete \"" D_DEVS "\" QUIET\n"
             "Delete \"" D_LIBS "\" QUIET\n"
             "Delete \"" D_C "\" QUIET\n")) (P_rec_add))
    ))
  ; Assign EXISTS first: naming an assign that is not there asks for a volume.
  ((set REC_ADD (cat
         "Assign >NIL: AmiNetXDuo: EXISTS\n"
         "If WARN\n"
         "Else\n"
         (if DRAWER_LAYOUT
             (cat "  Assign LIBS: AmiNetXDuo:Libs REMOVE\n"
                  "  Assign C: AmiNetXDuo:C REMOVE\n"
                  "  Assign DEVS: AmiNetXDuo:Devs REMOVE\n")
             "")
         "  Assign AmiNetXDuo:\n"
         "EndIf\n"
         "Delete \"" DOCDIR "\" QUIET\n"
         "If EXISTS \"" DOCDIR "\"\n"
         "  Echo >T:AmiNetXDuo-DrawerKept \"" DOCDIR "\"\n"
         "Else\n"
         "  Delete \"" DOCDIR ".info\" QUIET\n"
         "EndIf\n"
         "Echo >T:AmiNetXDuo-Done \"done\"\n")) (P_rec_add))

  (P_rec_flush)
  (textfile
    (prompt "Writing S:AmiNetXDuo-Files")
    (help   "The record of this installation that Uninstall-AmiNetXDuo, in the "
            "AmiNetXDuo drawer, runs to remove it again.")
    (dest   "S:AmiNetXDuo-Files")
    (append "; S:AmiNetXDuo-Files -- written by the AmiNetXDuo installer.\n")
    (append ";\n")
    (append "; Uninstall-AmiNetXDuo executes this after it has removed the\n")
    (append "; S:User-Startup block and the Wi-Fi and firmware files.\n")
    (append "FailAt 21\n"))
  (set JN_DEST "S:AmiNetXDuo-Files")
  (set JN_STEM "Part")
  (set JN_N REC_PART)
  (P_rec_join)
  ))
)

; codesets.library goes in on 3.0 and up (it needs 3.0), and only over an
; older copy or none: a newer one, or a system one at least as new beside a
; private installation, is kept.  getversion is (version << 16) | revision.
(set CS_DEST (tackon D_LIBS "codesets.library"))
(set D_CS_NEW (cat CS_DEST ".new"))
(set D_CS_OLD (cat CS_DEST ".old"))
(set CS_DO 0)
(if (AND (>= OSVER 39) (exists CS_SRC (noreq)))
  (
    (set CS_NEW (getversion CS_SRC))
    (set CS_HAVE 0)
    (if (exists CS_DEST (noreq)) (set CS_HAVE (getversion CS_DEST)))
    (if (AND DRAWER_LAYOUT (exists "LIBS:codesets.library" (noreq)))
        (if (> (getversion "LIBS:codesets.library") CS_HAVE)
            (set CS_HAVE (getversion "LIBS:codesets.library"))))
    (if (< CS_HAVE CS_NEW) (set CS_DO 1))
  ))

; The libraries, and their .old copies, which the swap deletes: those may
; be another stack's own backups.
(if (= DRAWER_LAYOUT 0)
  (
    (set BK_SUB "Libs")
    ; An older codesets.library, unless it is this archive's own.
    (if CS_DO
      (
        (set BK_ARCH CS_SRC)
        (set BK_SRC CS_DEST) (P_backup)
        (set BK_ARCH "")
      ))
    (set BK_SRC D_BSD) (P_backup)
    (set BK_SRC D_UG)  (P_backup)
    (set BK_SRC D_TLS) (P_backup)
    (set BK_SRC D_BSD_OLD) (P_backup)
    (set BK_SRC D_UG_OLD)  (P_backup)
    (set BK_SRC D_TLS_OLD) (P_backup)
  ))
; Every interface file, kept or not: a kept one can still be edited (the
; PRIORITY line InstallWiFi adds for a Wi-Fi beside it).
(set BK_SUB "Devs/NetInterfaces")
(if (= (exists D_IFDIR (noreq)) 2)
    (foreach D_IFDIR "~(#?.info)"
      (if (< @each-type 0)
        (
          (set BK_SRC (tackon D_IFDIR @each-name))
          (P_backup)
        ))))
(if (= KEEP_OLD 0)
  (
    (set BK_SUB "Devs/Internet")
    (set BK_SRC (tackon D_DEVS "Internet/routes")) (P_backup)
    (set BK_SRC (tackon D_DEVS "Internet/name_resolution")) (P_backup)
  ))
(if (AND DO_STARTUP (= KEEP_NETSTART 0))
  (
    (set BK_SUB "S")
    (set BK_SRC "S:Network-Startup")
    (P_backup)
    (set BK_SRC "S:Network-Startup.old")
    (P_backup)
  ))
; 1.0.0-beta1 to beta8 copied C/ with (infos): their tool icons went into C:,
; and C:.info with them.  Those icons there, byte for byte, say such a copy
; ran; C:.info may still be the user's, so it goes to Backup, then out of C:.
(set CINFO_OLD 0)
(if (= DRAWER_LAYOUT 0)
  (
    (set TL_I 0)
    (while (set TL_N (select TL_I "NetPrefs.info" "NetMeter.info" ""))
      (
        (if (exists (tackon D_C TL_N) (noreq))
            (if (= 0 (run ("\"%s\" \"%s\" \"%s\" BYTES" S_SAMEFILE (tackon D_C TL_N)
                           (tackon S_EARLIER (cat TL_N ".beta8")))
                          (quiet) (safe)))
                (set CINFO_OLD 1)))
        (set TL_I (+ TL_I 1))
      ))
  ))

; With the libraries, before anything is replaced, in every run: a command
; of the same name in C:, the four Workbench tools and their icons, and the
; certificate store, when they are another stack's or the user's.  Every
; command names AmiNetXDuo; an icon or the store is ours when it is the
; archive's own, byte for byte.
(if (= DRAWER_LAYOUT 0)
  (
    (set BK_SUB "Prefs")
    (set BK_ARCH "")
    (set BK_SRC "SYS:Prefs/NetPrefs") (P_backup)
    (set BK_ARCH (tackon S_ICONS "NetPrefs.info"))
    (set BK_SRC "SYS:Prefs/NetPrefs.info") (P_backup)
    (set BK_ARCH "")
    (set BK_SRC "SYS:Prefs/NetWirelessPrefs") (P_backup)
    (set BK_ARCH (tackon S_ICONS "NetWirelessPrefs.info"))
    (set BK_SRC "SYS:Prefs/NetWirelessPrefs.info") (P_backup)
    (set BK_SUB "Utilities")
    (set BK_ARCH "")
    (set BK_SRC "SYS:Utilities/NetMeter") (P_backup)
    (set BK_ARCH (tackon S_ICONS "NetMeter.info"))
    (set BK_SRC "SYS:Utilities/NetMeter.info") (P_backup)
    (set BK_ARCH "")
    (set BK_SRC "SYS:Utilities/NetSwitch") (P_backup)
    (set BK_ARCH (tackon S_ICONS "NetSwitch.info"))
    (set BK_SRC "SYS:Utilities/NetSwitch.info") (P_backup)
    (set BK_ARCH (tackon S_ICONS "NetSwitch.ilbm"))
    (set BK_SRC "SYS:Utilities/NetSwitch.ilbm") (P_backup)
    (set BK_SUB "Tools/Commodities")
    (set BK_ARCH "")
    (set BK_SRC "SYS:Tools/Commodities/NetWireless") (P_backup)
    (set BK_ARCH (tackon S_ICONS "NetWireless.info"))
    (set BK_SRC "SYS:Tools/Commodities/NetWireless.info") (P_backup)
    (set BK_SUB "Devs/Internet")
    (set BK_ARCH (tackon (tackon S_DEVS "Internet") "certificates"))
    (set BK_SRC (tackon (tackon D_DEVS "Internet") "certificates")) (P_backup)
    (set BK_SUB "C")
    (foreach S_C "~(fat)"
      (if (< @each-type 0)
        (
          (set BK_ARCH (if (patmatch "#?.info" @each-name)
                           (tackon S_C @each-name) ""))
          (set BK_SRC (tackon D_C @each-name))
          (P_backup)
        )))
    ; The tool icons C/ no longer carries, which the reinstall removes
    ; from C: below when they are an earlier release's: a user's own goes
    ; to Backup first.
    (set TL_I 0)
    (while (set TL_N (select TL_I "NetPrefs.info" "NetMeter.info"
                                  "NetSwitch.info"
                                  "NetWireless.info" "NetWirelessPrefs.info" ""))
      (
        (set BK_ARCH (if (< TL_I 2) (tackon S_EARLIER (cat TL_N ".beta8")) ""))
        (set BK_SRC (tackon D_C TL_N)) (P_backup)
        (set TL_I (+ TL_I 1))
      ))
    (set BK_ARCH "")
