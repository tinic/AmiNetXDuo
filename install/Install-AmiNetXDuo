; ==========================================================================
;
;  AmiNetXDuo -- Commodore Installer script
;
;  Installs the AmiNetXDuo TCP/IP stack: bsdsocket.library and
;  usergroup.library into LIBS:, the Roadshow-compatible commands into
;  C:, and a working DEVS:NetInterfaces / DEVS:Internet configuration written
;  from the answers the user gives here.
;
;  Language reference: "Documentation for 2.16 Installer" (Commodore, 9 Feb
;  1993) plus the Installer 2.17 sources -- compile.c's symbol tables are the
;  authority for which keywords and parameters exist, and which statements
;  each parameter is legal in.
;
;  Two properties of the Installer shape everything below:
;
;    * At NOVICE level every ask... function returns its (default) WITHOUT
;      showing anything, and (message ...) prints nothing.  So novice mode
;      only works if every default is independently correct -- which is why
;      the card is auto-detected from the machine's read-only hardware lists,
;      with installed drivers as a fallback, and the address mode defaults to
;      DHCP.  It is also why no validation loop may depend on a (message):
;      each one is unconditionally satisfied at user level 0, or it would
;      spin forever with no window on screen.
;
;    * (startup) replaces the ";BEGIN AmiNetXDuo" .. ";END AmiNetXDuo" block
;      in S:User-Startup and leaves every other application's lines alone.
;      That is what makes re-running this script safe.
;
;  SPDX-License-Identifier: MIT
;
; ==========================================================================

(set APPNAME     "AmiNetXDuo")

; dist/make-dist.sh rewrites this line as it copies the script into the
; archive, from tools/version.sh -- so what the installer reports and what the
; .lha is called cannot disagree, and it fails the build if the line is not
; there to stamp.
;
; Deliberately not a real-looking number.  It was "0.1.0" and stayed there for
; eleven releases: harmless, because no archive ever carries it, and it still
; reads as a version rather than as a placeholder to anyone running the script
; straight out of the source tree.
(set VERSION_STR "0.0.0-source")

; --------------------------------------------------------------------------
; Where we are reading from.
;
; @icon is the full path of the icon the user double-clicked, so its
; directory is the archive root.  Started from the Shell @icon is empty and
; the relative names below resolve against the current directory, which is
; the same drawer in practice.
; --------------------------------------------------------------------------

(set SRCDIR (pathonly @icon))

(set S_LIBS  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Libs")     "Libs"))
(set S_LIBSBASE S_LIBS)
(set S_C     (if (> (strlen SRCDIR) 0) (tackon SRCDIR "C")        "C"))
(set S_CFAT  (tackon S_C "fat"))
(set S_DEVS  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Devs")     "Devs"))
(set S_DOCS  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Docs")     "Docs"))
(set S_EXAM  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Examples") "Examples"))

; --- where the installed files GO ----------------------------------------
;
; One name per destination instead of the string spelled at each copy, so a
; layout other than "into the system" is a change to these names and not to
; every copy in the file.  They begin as the system directories; section 4
; replaces them together when the self-contained layout is selected.
;
; D_DEVS is the parent of Networks, NetInterfaces and Internet, so all three
; move together if it moves.
(set D_LIBS "LIBS:")
(set D_C    "C:")
(set D_DEVS "DEVS:")

; D_ROOT empty means the system layout above.  Set, it is a drawer holding
; Libs, C and Devs, reached through assigns written into S:User-Startup.
(set D_ROOT "")
(set S_TERM  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Terminal") "Terminal"))
(set S_README (if (> (strlen SRCDIR) 0) (tackon SRCDIR "ReadMe")   "ReadMe"))
(set S_SAMEFILE (if (> (strlen SRCDIR) 0)
                    (tackon SRCDIR "InstallSameFile") "InstallSameFile"))
(set S_FIRMWARE (tackon S_DEVS "Firmware"))
(set S_NETPROBE (if (> (strlen SRCDIR) 0)
                    (tackon SRCDIR "InstallNetProbe") "InstallNetProbe"))

; A DRAWER'S ICON IS NOT IN THE DRAWER, it is beside it -- Examples.info sits
; next to Examples/, not inside it.  Every copy below that installs a drawer
; copies that drawer's CONTENTS, so `(all)' never saw these two and the
; Examples and Terminal drawers arrived on the user's disk as objects Workbench
; does not draw: real drawers, holding the right files, invisible to anybody
; who does not open a Shell.  Eleven releases.
;
; There is no S_DOCSICON to go with them, and that is a decision rather than an
; omission: Docs/ CONTENTS are copied into the AmiNetXDuo drawer itself, which
; already has AmiNetXDuo.info, so no Docs drawer exists on this side to give an
; icon to.  install/ARCHIVE-MANIFEST carries that reason where the gate reads
; it.
(set S_EXAMICON (if (> (strlen SRCDIR) 0)
                    (tackon SRCDIR "Examples.info") "Examples.info"))
(set S_TERMICON (if (> (strlen SRCDIR) 0)
                    (tackon SRCDIR "Terminal.info") "Terminal.info"))
; The Workbench tools' icons: C/ carries none, so C: gets none.
(set S_ICONS (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Icons") "Icons"))
; The icons 1.0.0-beta1 to beta8 copied into C:, byte for byte.
(set S_EARLIER (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Earlier") "Earlier"))
(set S_UNINSTALL (if (> (strlen SRCDIR) 0)
                     (tackon SRCDIR "Uninstall-AmiNetXDuo") "Uninstall-AmiNetXDuo"))
(set S_UNINSTALLICON (cat S_UNINSTALL ".info"))
(set S_INSTALLER (if (> (strlen SRCDIR) 0)
                     (tackon SRCDIR "Installer") "Installer"))

; WirelessManager and its licence, in a drawer of their own: C/ is copied
; wholesale, and these are copied only when the Wi-Fi is selected.
(set S_WIRELESS (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Wireless") "Wireless"))
(set S_WM    (tackon S_WIRELESS "WirelessManager"))
(set S_WMLIC (tackon S_WIRELESS "WirelessManager-LICENSE"))
(set S_PCMCIA (if (> (strlen SRCDIR) 0) (tackon SRCDIR "PCMCIA") "PCMCIA"))
(set S_PCMDOCS (tackon S_PCMCIA "Docs"))
; codesets.library, its licence and its source pointer.
(set S_CODESETS (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Codesets") "Codesets"))
(set CS_SRC (tackon S_CODESETS "codesets.library"))
(set S_INSTWIFI (if (> (strlen SRCDIR) 0)
                    (tackon SRCDIR "InstallWiFi") "InstallWiFi"))
(set S_NWPREFS (tackon S_C "NetWirelessPrefs"))

; --------------------------------------------------------------------------
; Help texts.  Every ask.../copy... statement is required by the Installer to
; carry both a (prompt) and a (help); a missing one is a script error at the
; moment the statement runs, not at compile time, so they are all spelled out.
; --------------------------------------------------------------------------

(set H_CARD
  (cat "AmiNetXDuo reaches the network card through a SANA-II driver.  The "
       "driver is a file whose name ends in \".device\".\n\n"
       "Select every network device in this Amiga.  Several choices are "
       "allowed.  The highest-priority selected wired device is started at "
       "boot; the other definitions remain ready for Online <name>.\n\n"
       "Zorro cards and Emu68 devices found in hardware are checked already. "
       "Installed drivers are used only as a fallback.  Check or clear any "
       "entry before proceeding.\n\n"
       "Emulator network drivers supplied in ROM need no file in DEVS:.  "
       "They are detected in Exec and used by their bare device name.\n\n"
       "The AmigaNet is Hydra Systems' card and its driver is hydra.device; "
       "the LAN Rover is ASDG's and its driver is eb920.device.  The board "
       "and the file are not named the same thing.\n\n"
       "PCMCIA is asked on the next page because one slot accepts several "
       "unrelated cards.  X-Surf 500 has no Autoconfig identity, and external "
       "SCSI, USB and parallel adapters have no enumerable network identity; "
       "their installed driver is therefore the detection signal.\n\n"
       "For a card that is not listed, select the last entry.  The "
       "installer then asks for the file name of the driver, for example "
       "\"myCard.device\".  The driver comes with the card.  This installer "
       "does not supply it."
       "\n\nA wrong choice is harmless: nothing is damaged, the network "
       "does not come up, and the installer can be run again."))

(set H_PCMCIA
  (cat "PCMCIA (credit-card sized) network cards for the A600 and A1200 use "
       "several different drivers.\n\n"
       "  NE2000 or CNet    cnet.device\n"
       "  3Com 3C589        etherlink3.device\n"
       "  Xircom Ethernet   xircomce2.device\n\n"
       "Most NE2000-compatible Ethernet cards use cnet.device.  The 3Com "
