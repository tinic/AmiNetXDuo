(set H_STARTUP
  (cat "S:User-Startup is the file that the Amiga runs at every boot.  "
       "This line in it starts the network automatically:"
       "\n\n\tExecute S:Network-Startup\n\n"
       "S:Network-Startup is written here too, and is the file to edit "
       "afterwards: it names the interface chosen on the last page, and says "
