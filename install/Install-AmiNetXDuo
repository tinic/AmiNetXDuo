; ==========================================================================
;
;  AmiNetXDuo -- Commodore Installer script
;
;  Installs the AmiNetXDuo TCP/IP stack: bsdsocket.library and
;  usergroup.library into LIBS:, the seven Roadshow-compatible commands into
;  C:, and a working DEVS:NetInterfaces / DEVS:Internet configuration written
;  from the answers the user gives here.
;
;  Language reference: "Documentation for 2.16 Installer" (Commodore, 9 Feb
;  1993) plus the Installer 2.17 sources -- compile.c's symbol tables are the
;  authority for which keywords and parameters exist, and which statements
;  each parameter is legal in.
;
;  Two properties of the Installer shape everything below:
;
;    * At NOVICE level every ask... function returns its (default) WITHOUT
;      showing anything, and (message ...) prints nothing.  So novice mode
;      only works if every default is independently correct -- which is why
;      the card is auto-detected from DEVS: and the address mode defaults to
;      DHCP.  It is also why no validation loop may depend on a (message):
;      each one is unconditionally satisfied at user level 0, or it would
;      spin forever with no window on screen.
;
;    * (startup) replaces the ";BEGIN AmiNetXDuo" .. ";END AmiNetXDuo" block
;      in S:User-Startup and leaves every other application's lines alone.
;      That is what makes re-running this script safe.
;
;  SPDX-License-Identifier: MIT
;
; ==========================================================================

(set APPNAME     "AmiNetXDuo")

; dist/make-dist.sh rewrites this line as it copies the script into the
; archive, from tools/version.sh -- so what the installer tells the user and
; what the .lha is called cannot disagree.  The value here is only what you
; see running the script straight out of the source tree.
(set VERSION_STR "0.1.0")

; --------------------------------------------------------------------------
; Where we are reading from.
;
; @icon is the full path of the icon the user double-clicked, so its
; directory is the archive root.  Started from the Shell @icon is empty and
; the relative names below resolve against the current directory, which is
; the same drawer in practice.
; --------------------------------------------------------------------------

(set SRCDIR (pathonly @icon))

(set S_LIBS  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Libs")     "Libs"))
(set S_C     (if (> (strlen SRCDIR) 0) (tackon SRCDIR "C")        "C"))
(set S_DEVS  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Devs")     "Devs"))
(set S_DOCS  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Docs")     "Docs"))
(set S_EXAM  (if (> (strlen SRCDIR) 0) (tackon SRCDIR "Examples") "Examples"))

