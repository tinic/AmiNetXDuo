; ssh (Dropbear's dbclient) and scp ride into C: with the other network commands
; above -- the argv/stack shim gives them a real argv[] and their own stack,
; so they no longer need the separate drawer and the `stack 200000`
; ritual the ported clients once did.

(complete 90)

; ==========================================================================
;  8.  S:User-Startup
; ==========================================================================

(set START_IF (if KEEP_OLD OLD_IF IFNAME))

; KEEP_NETSTART is decided in section 4, beside DO_STARTUP.

; One string, however many lines are in it.  (startup) replaces everything
; between its two markers, so the block is always written whole and there is
; no case where a second run leaves a line from the first one behind: an httpd
; line appears because DO_HTTPD is true on THIS run, and goes away because it
; is not.
;
; `Run >NIL: <NIL:' and not a bare command: httpd does not return, and a boot
; that reaches it without Run stops there. The redirections detach it from the
; startup Shell's console, which would otherwise keep that Shell alive.
;
; The assign is what lets the httpd line be short enough to be worth reading.
; httpd looks for its pages in AmiNetXDuo:Terminal/, among two other places
; (src/tools/httpd.c), and the drawer this
; installer put the page in is wherever the user said, so the assign is the
; only stable name for it.

; DO_BOOT counts the lines rather than testing BOOT_CMD itself: (if) wants a
; number, and a string that does not begin with a digit is 0 to it, so an (if
; BOOT_CMD) would be false however much was in it.
(set BOOT_CMD "")
(set DO_BOOT 0)

; FIRST in the block, before anything opens a library.  ADD, and LAST: an
; ADD assign appends, so the system's directories keep answering first and
; the drawer answers for what they lack.  Nothing here selects the stack;
; the S:Network-Startup written below does, by naming the drawer's own
; AddNetInterface, which opens the library beside it.  A drawer install
; without the startup is reachable through AmiNetXDuo: and, for whatever
; the system has no copy of, through the three assigns.
(if (> (strlen D_ROOT) 0)
  (
    (set BOOT_CMD
      (cat ("Assign AmiNetXDuo: \"%s\"\n" D_ROOT)
           "Assign LIBS: AmiNetXDuo:Libs ADD\n"
           "Assign C:    AmiNetXDuo:C ADD\n"
           "Assign DEVS: AmiNetXDuo:Devs ADD\n"))
    (set DO_BOOT 1)
  ))

(if DO_STARTUP (set DO_BOOT 1))

; The network starts from a file of its own, the way Roadshow starts it from
; S:Network-Startup, rather than from a line buried in User-Startup among the
; assigns.  A user with a second card edits one obvious file and the managed
; block above it stays the installer's to rewrite.
(if DO_STARTUP
    (set BOOT_CMD
      (cat BOOT_CMD
           "If EXISTS S:Network-Startup\n"
           "  Execute S:Network-Startup\n"
           "EndIf\n")))

; The assign is written here ONLY when the drawer install did not already
; write one.  A drawer install emits `Assign AmiNetXDuo: "<D_ROOT>"` at the top
; of this block, and that name is load-bearing: the three ADD assigns, the
; S:Network-Startup line and the library's own configuration lookup all refer
; to the private installation through it.  A
; second `Assign AmiNetXDuo:` here does not add a name, it REPOINTS the one
; already given, so on a drawer install with httpd the drawer's own name ended
; up meaning the documentation directory instead.
;
; It showed up as two assign lines where one is the only right answer --
; install/test/run-workbench.sh counts them, and -D is the arm that draws both
; halves at once.  httpd still finds its page: the drawer assign names the
; drawer the Terminal directory sits in, and httpd looks in more than one place
; anyway (src/tools/httpd.c httpd_term_places[]).
(if (AND DO_STARTUP DO_HTTPD)
    (
      (if (NOT (> (strlen D_ROOT) 0))
          (set BOOT_CMD
            (cat BOOT_CMD ("Assign AmiNetXDuo: \"%s\"\n" DOCDIR))))
      ; The drawer's httpd by its own name: C: reaches the drawer last, and
      ; a system httpd of any origin would be the one that ran.
      (set BOOT_CMD
        (cat BOOT_CMD
             ("Run >NIL: <NIL: %shttpd PORT %ld -T -F -C\n" C_PREFIX HTTPD_PORT)))
    ))

; Three cases, and (startup) covers all of them because it writes the block
; whole: selection plus network start, selection on its own for a drawer
; install, or no block for a system install that must not start at boot.
(set P_BOOT
  (cat "Adding AmiNetXDuo's drawer assigns to S:User-Startup.  Its files "
       "are reachable at boot, but the network does not start by itself."))

; --------------------------------------------------------------------------
; S:Network-Startup
;
; Roadshow ships this file with a wildcard in it and AmiTCP_NG ships the same
; line, so a user arriving from either already knows where the network starts.
; Ours names the ONE interface that was chosen here, because a definition in
; DEVS:NetInterfaces is not a request to open that card -- which is the whole
; of the 0.27 change.  The wildcard is one edit away and the file says so.
;
; An existing file is somebody's configuration, very possibly the Roadshow one
; this installation is replacing, and it is renamed rather than overwritten.
; Same .old convention as the libraries above.
; Said in the file, for the drawer layout only: the one line in it that
; differs from a system install, and why.
(set NS_DRAWER_NOTE "")
(if DRAWER_LAYOUT
    (set NS_DRAWER_NOTE
      (cat ";\n"
           "; This installation lives in AmiNetXDuo: and is LAST in\n"
           "; C:, LIBS: and DEVS:.  The command is named through the\n"
           "; assign so that this drawer's is the one that runs; to\n"
           "; AmiNetXDuo, DEVS: here means AmiNetXDuo:Devs.\n")))

; After AddNetInterface, so the stack is up when sntp opens it.  Run >NIL:
; <NIL: for httpd's reason and one more: sntp blocks for its whole timeout,
; plus the name lookup, when no server answers, and a boot must not wait on
; that.  Empty unless asked for, so the file is otherwise unchanged.
(set NS_SNTP "")
(if DO_SNTP
    (set NS_SNTP
      ("Run >NIL: <NIL: %ssntp %s QUIET\n" C_PREFIX NTP_SERVER)))

; THE WI-FI IN S:Network-Startup.  Started only when ENV:Sys/Wireless.prefs
; exists, which is also what WirelessManager needs: WirelessManager first,
; so it is joining before DHCP asks, then the interface with the 30 second
; wait; without the file neither starts and nothing waits.  Status finds a
; copy already running under the same command name, and then none is
; started.  Run's `+' continues onto the next line in the background CLI, so
; the larger stack is that CLI's alone.  With WM_LIVE off the lines that
; start WirelessManager are written commented out (see WM_ELSEWHERE).
;
; When the Wi-Fi is not the primary it starts after it, the primary having
; PRIORITY=10.  Micro brings up one interface, so there the block is written
; commented out after the primary, for whoever wants to swap.
(set WM_CMD (if (AND WM_USER (OR HAVE_C_WM HAVE_SYSC_WM))
                "C:WirelessManager" (cat C_PREFIX "WirelessManager")))
(set WIFI_TIMEOUT 30)
(set WM_PFX (if WM_LIVE "" ";"))
; Behind another interface the Wi-Fi starts in the background, so a
; missing network or a wrong key never holds the boot; as the primary, the
; boot waits for it, bounded, so that sntp and httpd after it have a network.
(set WIFI_AN_RUN (if WIFI_PRIMARY "" "Run >NIL: <NIL: "))
(set WIFI_WM_LINES
  (cat "If EXISTS ENV:Sys/Wireless.prefs\n"
       "  " WM_PFX "Status >NIL: COMMAND=" WM_CMD "\n"
       "  " WM_PFX "If WARN\n"
       "  " WM_PFX "  Run >NIL: <NIL: Stack 32768 +\n"
       "  " WM_PFX "  " WM_CMD (" DEVICE=%s UNIT=%ld\n" WIFI_DEV WIFI_UNIT)
       "  " WM_PFX "EndIf\n"))
(set WIFI_LINES
  (cat WIFI_WM_LINES
       "  " WIFI_AN_RUN C_PREFIX "AddNetInterface DEVS:NetInterfaces/" WIFI_IF
       (" QUIET TIMEOUT=%ld\n" WIFI_TIMEOUT)
       "EndIf\n"))
(set WIFI_NOTE
  (cat ";\n"
       "; Wi-Fi: with ENV:Sys/Wireless.prefs, WirelessManager joins that\n"
       (if WIFI_PRIMARY
           (cat "; network, then the interface asks for an address and waits at most\n"
                "; " ("%ld" WIFI_TIMEOUT) " seconds; DHCP goes on asking after the boot continues.\n")
           (cat "; network, then the interface asks for an address in the\n"
                "; background, so the boot does not wait for it.\n"))
       "; Without the file the Wi-Fi does not start.\n"
       "; Status recognises a WirelessManager already running only under\n"
       "; this exact command name.\n"
       (if WM_LIVE ""
           (cat ";\n"
                "; WirelessManager is set up on this machine outside this file,\n"
                "; so the lines that would start it are commented out: two\n"
                "; copies must not share the radio.  Remove those semicolons if\n"
                "; nothing else starts it.\n"))))
(set NS_WIFI "")
(set NS_WIFI_LATER "")
(if WIFI_START
    (set NS_WIFI (cat WIFI_NOTE WIFI_LINES))
    (if WIFI_SEL
        (set NS_WIFI_LATER
          (cat ";\n"
               "; The Wi-Fi is defined as " WIFI_IF " and is not started: this\n"
               "; stack brings up one interface.  To use the Wi-Fi instead,\n"
               "; comment out the line above and remove the first semicolon\n"
               "; from each line below.\n"
               ";\n"
               ";If EXISTS ENV:Sys/Wireless.prefs\n"
               ";  Status >NIL: COMMAND=" WM_CMD "\n"
               ";  If WARN\n"
               ";    Run >NIL: <NIL: Stack 32768 +\n"
               ";    " WM_CMD (" DEVICE=%s UNIT=%ld\n" WIFI_DEV WIFI_UNIT)
               ";  EndIf\n"
               ";  " C_PREFIX "AddNetInterface DEVS:NetInterfaces/" WIFI_IF
               (" QUIET TIMEOUT=%ld\n" WIFI_TIMEOUT)
               ";EndIf\n"))))

(if (AND DO_STARTUP (= KEEP_NETSTART 0))
  (
    (if (exists "S:Network-Startup" (noreq))
      (
        (if (exists "S:Network-Startup.old" (noreq))
            (delete "S:Network-Startup.old"
                    (prompt "Removing the previous S:Network-Startup.old")
                    (help @copyfiles-help)
                    (optional "force" "nofail")))
        (rename "S:Network-Startup" "S:Network-Startup.old"
                (prompt "Renaming the old S:Network-Startup out of the way")
                (help "S:Network-Startup already exists -- Roadshow keeps its "
                      "own there, and so may an earlier AmiNetXDuo.  It is "
                      "renamed to S:Network-Startup.old rather than being "
                      "overwritten, so nothing in it is lost.  To go back to "
                      "it, rename it over the new one from a Shell."))
      ))

    (textfile
      (prompt "Writing S:Network-Startup")
      (help   "This is the file that starts the network at boot.  "
              "S:User-Startup does nothing but Execute it, so this is the one "
              "file to edit when the machine gains a card, loses one, or "
              "should stop bringing the network up by itself.")
      (dest   "S:Network-Startup")
      (append "; S:Network-Startup -- written by the AmiNetXDuo installer.\n")
      (append ";\n")
      (append "; This file starts the network.  S:User-Startup runs it and\n")
      (append "; nothing else, so this is the file to edit.\n")
      (append ";\n")
      (append "; A file in DEVS:NetInterfaces DESCRIBES an interface.  It\n")
      (append "; does not start it.  The line below starts the one chosen\n")
      (append "; when AmiNetXDuo was installed.\n")
      (append ";\n")
      (append "; To start another card as well, add a line for it:\n")
      (append ";\n")
      (append ";     " C_PREFIX
              "AddNetInterface DEVS:NetInterfaces/<name> QUIET\n")
      (append ";\n")
      (append "; To start EVERY definition in the drawer, which is what\n")
      (append "; Roadshow does, use the pattern instead of a name:\n")
      (append ";\n")
      (append ";     " C_PREFIX "AddNetInterface DEVS:NetInterfaces/~(#?.info) QUIET\n")
      (append ";\n")
      (append "; To stop the network starting at boot, comment the line out\n")
      (append "; with a leading semicolon.  Nothing else has to change.\n")
      (append ";\n")
      (append "; QUIET keeps a boot that works silent.  Remove it while the\n")
      (append "; configuration is still being written and the command says\n")
      (append "; what came up.  A boot that FAILS prints why either way.\n")
      (append NS_DRAWER_NOTE)
      (append "\n")
      (append (if (AND WIFI_START WIFI_PRIMARY)
                  ""
                  (cat C_PREFIX "AddNetInterface DEVS:NetInterfaces/" START_IF
                       " QUIET\n")))
      (append NS_WIFI)
      (append NS_SNTP)
      (append NS_WIFI_LATER))
  ))

(if DO_STARTUP
    (set P_BOOT
      (cat "Adding AmiNetXDuo to S:User-Startup, so that the network starts "
           "when the Amiga boots.")))

(if DO_BOOT
    (startup APPNAME
      (prompt P_BOOT)
      (help   H_STARTUP)
      (command BOOT_CMD))
    (startup APPNAME
      (prompt "Removing AmiNetXDuo's lines from S:User-Startup, so that the "
              "network does not start by itself.")
      (help   H_STARTUP)))

; --- the record Uninstall-AmiNetXDuo runs, final -------------------------
(set REC_FINAL 1)
(P_write_record)

(complete 100)

; ==========================================================================
;  9.  Done
; ==========================================================================

; START IT NOW on a first installation: with no bsdsocket.library in LIBS:
; before this run, the startup file this run wrote starts the network, so
; the Wi-Fi and sntp come up as they will at boot.  In the background: the
; Installer waits for no driver, and polls GetNetStatus every 2 seconds for
; an interface and a default route, for at most 40 seconds, or 60 when the
; Wi-Fi is the primary (WirelessManager joins first).
;
; GetNetStatus by the path this run copied it to: AmiNetXDuo: is assigned
; only from the next boot, and naming it now asks for a volume.
(set NET_GNS (cat "\"" (tackon D_C "GetNetStatus") "\""))
(set NET_WAIT (if (AND WIFI_START WIFI_PRIMARY) 60 40))
(set NET_TRIED 0)
(set NET_UP 0)
(set NET_OTHER 0)
(set NET_EARLIER 0)
(if (AND DO_STARTUP (= KEEP_NETSTART 0) (= @pretend 0))
  (
    ; 5 is "not running".  10 is a stack in memory it cannot ask: another
    ; stack (AmiTCP or Miami from their own drawers, with or without its
    ; port), or an earlier AmiNetXDuo, whose library names it (VERSION).
    ; Either way the last page says to reboot.
    ; An update over a running earlier AmiNetXDuo that GetNetStatus can
    ; ask answers 0 or 5: OLD_BSD sends that one to VERSION as well.
    (set NET_RC (run ("%s QUIET" NET_GNS) (quiet) (safe)))
    (if (OR (= NET_RC 10) OLD_BSD)
      (
        (if (= NET_RC 10) (set NET_OTHER 1))
        (if (= 0 (run ("%s VERSION >T:AmiNetXDuo-Stack" NET_GNS) (quiet) (safe)))
            (if (= 0 (run "Search >NIL: FROM T:AmiNetXDuo-Stack SEARCH AmiNetXDuo QUIET"
                          (quiet) (safe)))
                (set NET_EARLIER 1)))
        (delete "T:AmiNetXDuo-Stack" (optional "force" "nofail"))
      ))
    (if (AND (= NET_RC 5) (= OLD_BSD 0) (= DRAWER_LAYOUT 0))
      (
        (working "Starting the network")
        (run "Run >NIL: <NIL: Execute S:Network-Startup"
             (prompt "Starting the network")
             (help   "S:Network-Startup, the file that starts it at every boot."))
        (set NET_TRIED 1)
        (set NET_N 0)
        (while (AND (= NET_UP 0) (< NET_N (/ NET_WAIT 2)))
          (
            (run "C:Wait 2" (quiet))
            (if (= 0 (run ("%s CHECK=INTERFACES,DEFAULTROUTE QUIET" NET_GNS)
                          (quiet)))
                (set NET_UP 1))
            (set NET_N (+ NET_N 1))
          ))
      ))
  ))

(if DO_STARTUP
    (if KEEP_NETSTART
        (set FINAL_START (F_START_KEPT C_PREFIX START_IF))
        (if NET_UP
            (set FINAL_START F_START_NOW)
            (if NET_TRIED
                (set FINAL_START (F_START_TRIED NET_WAIT))
                (if NET_EARLIER
                    (set FINAL_START F_START_EARLIER)
                    (if NET_OTHER
                        (set FINAL_START F_START_OTHER)
                        (if DRAWER_LAYOUT
                            (set FINAL_START F_START_REBOOT)
                            (set FINAL_START (F_START_YES C_PREFIX START_IF))))))))
    (set FINAL_START (F_START_NO  C_PREFIX START_IF)))

(if (AND (= DO_STARTUP 0) DRAWER_LAYOUT)
    (set FINAL_START
      (cat FINAL_START "\nReboot first to make the AmiNetXDuo: assign "
           "available. The network stays offline.\n")))

; Said again on the last page, and deliberately.  The question that turned it
; on was one of a dozen; this is the sentence somebody reads after the fact and
; realises what is now running.
(set FINAL_HTTPD "")

(if DO_HTTPD
    (set FINAL_HTTPD (F_HTTPD HTTPD_PORT)))

(set FINAL_SNTP "")
(if DO_SNTP
    (set FINAL_SNTP (F_SNTP NTP_SERVER)))

; The 68000 https:// notice used to be here, and it is not any more.  A user
; who never types an https: URL was being warned about something that would
; never affect them, on the one page they read once; and the user who DOES
; type one is told by `fetch' itself, at the moment it matters, in words that
; fit their machine.  fetch tests AttnFlags for exactly this.
; The version is on the last screen as well as the first.  The welcome is
; gone by the time anything has been written, and this is the line that stays
; up -- and the one a user quotes when reporting something.  Every installed
; file answers `Version' with the same number, so the two agree.
(exit
  "AmiNetXDuo " VERSION_STR " is installed.\n\n"
  FINAL_START
  FINAL_HTTPD
  FINAL_SNTP
  (if DO_STARTUP
      "\nShowNetStatus reports whether it came up.  The ReadMe in the "
      "\nShowNetStatus reports its status after starting it. The ReadMe in the ")
  "AmiNetXDuo drawer covers the rest.  Version, on any of the installed "
  "files, reports " VERSION_STR " as well.\n")
