; --- tls.library, if this archive has one --------------------------------
;
; Only a build made with -DAMINETXDUO_TLS=ON carries it, so its absence is
; normal rather than an error.  It ships as a PAIR with the bsdsocket.library
; beside it: the two share a private interface, so installing one without the
; other, or mixing versions from different archives, is not supported.

(if (exists (tackon S_LIBS "tls.library") (noreq))
  (
    ; Replace tls.library the same way bsdsocket.library is, and for the same
    ; two reasons.  copylib copies only when the source romtag is NEWER, so an
    ; old tls.library whose version never moved would be left in place beside a
    ; freshly installed bsdsocket.library: exactly the mismatched pair the note
    ; above rules out, and how a stale CBC-only TLS survived a stack upgrade.
    ; Moving the old one aside also lets the copy succeed while the library is
    ; held open -- but it happens AFTER the new file is staged, not before.

    ; Staged, then swapped, for the reason given at the libraries above.
    (if (exists D_TLS_NEW (noreq))
        (delete D_TLS_NEW
                (prompt "Removing a leftover tls.library.new")
                (help @copyfiles-help)
                (optional "force" "nofail")))
    (if (exists D_TLS_NEW (noreq))
        (abort
          (cat "The leftover staging file " D_TLS_NEW " could not be removed. "
               "It might be incomplete, so the installer will not mistake it "
               "for this run's copy. Remove it and run the installer again.")))

    (copyfiles
      (prompt (cat "Installing tls.library into LIBS:\n\n"
                   "This library makes encrypted (https:) connections "
                   "possible.  Only a program that asks for it opens it, so "
                   "it costs nothing until then."))
      (help   @copylib-help)
      (source (tackon S_LIBS "tls.library"))
      (dest   D_LIBS)
      (newname "tls.library.new")
      (confirm)
      (optional "force"))

    (if (exists D_TLS_NEW (noreq))
      (
        (if OLD_TLS
          (
            (if (exists D_TLS_OLD (noreq))
                (delete D_TLS_OLD
                        (prompt "Removing the previous tls.library.old")
                        (help @copyfiles-help)
                        (optional "force" "nofail")))
            (rename D_TLS D_TLS_OLD
                    (prompt "Renaming the old tls.library out of the way")
                    (help H_REPLACELIB))
          ))
        (rename D_TLS_NEW D_TLS
                (prompt "Putting the new tls.library in place")
                (help H_REPLACELIB))
      ))
  ))

; A PROFILE CHANGE HAS TO REMOVE THE OTHER HALF OF THE OLD PAIR.  Installing
; minimal or micro over a full installation used to replace bsdsocket.library
; and leave the old tls.library at its live name.  The two libraries share a
; private interface and the combination is explicitly unsupported above; it
; also made a reduced install continue to advertise TLS.  Keep the previous
; file recoverable under .old, exactly as a replacement does, but take it out
; of the library search path selected by the new profile.
(if (AND (NOT (exists (tackon S_LIBS "tls.library") (noreq))) OLD_TLS)
  (
    (if (exists D_TLS_OLD (noreq))
        (delete D_TLS_OLD
                (prompt "Removing the previous tls.library.old")
                (help @copyfiles-help)
                (optional "force" "nofail")))
    (rename D_TLS D_TLS_OLD
            (prompt "Moving tls.library aside for the reduced stack")
            (help "The minimal and micro stacks do not provide TLS.  The old "
                  "tls.library is kept as tls.library.old, but cannot remain "
                  "live beside a bsdsocket.library with a different private "
                  "interface."))
  ))

; THE ONLY WAY TO END UP WITHOUT ENCRYPTION IS TO HAVE ASKED FOR IT.  It used
; to be the 68000's lot: the archive carried no tls.library for one, because a
; 7 MHz machine's public-key arithmetic took longer than the far end would wait.
; One binary settled that differently -- measured on an A600, a TLS 1.3
; handshake completes in a minute or two and a resumed one in under a second --
; so every processor gets it and only the reduced profiles leave it out.
(if (NOT (exists (tackon S_LIBS "tls.library") (noreq)))
    ; Chosen, not imposed -- and worth restating, because what either reduced
    ; stack leaves out is easy to pick in one screen and be surprised by later.
    (message
      "A reduced-memory stack was chosen, so several things are not installed: "
      "encrypted (https:) connections, IPv6, .local name lookups, the packet "
      "filter, IPv4 multicast, the ARexx host and the TCP: handler.\n\n"
      "The stack, ssh and ordinary IPv4 programs that use the classic resolver "
      "work normally.  The micro stack also supports only one interface and "
      "omits getaddrinfo/getnameinfo, ancillary and out-of-band data, and the "
      "Roadshow routing, address-allocation and interface-administration "
      "calls.  Install again "
      "and choose Everything to add "
      "the rest."))

