; --- the interface file --------------------------------------------------

(procedure P_write_interface
  (textfile
    (prompt ("Writing DEVS:NetInterfaces/%s" IFNAME))
    (help   "This file describes one network card.  It gives the driver "
            "to open, and how the card gets its Internet address.  The "
            "name of the file is the name of the interface.")
    (dest   (tackon (tackon D_DEVS "NetInterfaces") IFNAME))
    (append "; DEVS:NetInterfaces/" IFNAME " -- written by the AmiNetXDuo "
            "installer.\n")
    (append ";\n")
    (append "; The name of this file is the name of the interface.  Use it\n")
    (append "; with the network commands:\n")
    (append ";\n")
    (append ";     Online " IFNAME "\n")
    (append ";     Offline " IFNAME "\n")
    (append ";     ShowNetStatus INTERFACE " IFNAME "\n")
    (append ";\n")
    (append "; DEVICE     the SANA-II driver for the card.  A bare name is\n")
    (append ";            looked up in DEVS:.  A path is used as given.\n")
    (append "; UNIT       which card, when one driver has several.\n")
    (append "; CONFIGURE  how the address is obtained:\n")
    (append ";              DHCP   -- ask the network (the usual choice)\n")
    (append ";              AUTO   -- self-assign 169.254.x.x with no DHCP\n")
    (append ";              STATIC -- use the ADDRESS/NETMASK below\n")
    (append ";              NONE   -- no IPv4 here, IPv6 carries this\n")
    (append ";                        interface\n")
    (append ";            Note this keyword is CONFIGURE, not IPTYPE.  In\n")
    (append ";            Roadshow IPTYPE is the SANA-II packet type, a\n")
    (append ";            number, and defaults to 2048.\n")
    (append ";\n")
    (append "; MDNS=  YES -- answer .local queries on this interface\n")
    (append ";        NO  -- do not, which is the default when the\n")
    (append ";               keyword is absent.  The responder costs\n")
    (append ";               real time on a slow machine, even when\n")
    (append ";               nothing asks it anything.\n")
    (append "; TCPACKMAX= caps received TCP bytes between requested ACKs.\n")
    (append ";             Leave it out for this device's default.\n")
    (append "; TCPGROWRTT= is the handshake round trip in ms at which a\n")
    (append ";             TCP receive window grows.  Leave it out for 10.\n")
    (append "; TCPWANWINDOW= is the TCP receive window in bytes on a path at\n")
    (append ";             or above TCPGROWRTT, for a card whose memory limits\n")
    (append ";             it.  Leave it out for the card's own size.\n")
    (append "; GROFRAMES=  is the most received TCP frames joined into one, 1\n")
    (append ";             to 16.  Leave it out for 16.\n")
    (append "; ACKPACE=    is an experimental TCP acknowledgment pace in kbit/s\n")
    (append ";             for a long path on a card without flow control.\n")
    (append ";\n")
    (append "; An IPv6 build also understands CONFIGURE6 (OFF, LINKLOCAL,\n")
    (append "; AUTO, DHCP or STATIC), ADDRESS6 and GATEWAY6.  A build\n")
    (append "; without IPv6 ignores them, so they are safe to leave in\n")
    (append "; place.  AUTO follows the router, which is what an IPv6-only\n")
    (append "; machine behind a managed router needs; see\n")
    (append "; Examples/NetInterfaces/eth0-ipv6.\n")
    (append ";\n")
    (append "DEVICE=" DEV_WRITE "\n")
    (append (if USE_CARD (cat "CARD=" CARD_KEY "\n") ""))
    (append ("UNIT=%ld\n" DEVUNIT))
    (append (if USEDHCP "CONFIGURE=DHCP\n" "CONFIGURE=STATIC\n"))
    (append (if WANTMDNS "MDNS=YES\n" "MDNS=NO\n"))
    (append (if IF_PRIORITY
                (cat "; PRIORITY=10 puts this interface's routes ahead of the\n"
                     "; Wi-Fi's, which starts too.\n"
                     "PRIORITY=10\n")
                ""))
    (append (if USEDHCP
                (cat ";ADDRESS=192.168.1.10\n;NETMASK=255.255.255.0\n")
                (cat "ADDRESS=" IPADDR "\n" "NETMASK=" IPMASK "\n")))
    (append ";CONFIGURE6=AUTO\n")
    (safe))
)

; Not in a pretend run: these textfiles are (safe), so they would write
; anyway, over another stack's configuration among others.
(if (AND (= KEEP_OLD 0) (= @pretend 0))
  (
    (working "Writing the network configuration")


    (set PRIMARY_IF IFNAME)
    (set PRIMARY_DHCP USEDHCP)
    ; The cable over the air when both start: the primary's default route
    ; wins.  Only the primary carries it.
    (set IF_PRIORITY (if (AND WIFI_START (= WIFI_PRIMARY 0)) 1 0))
    (P_write_interface)
    (set IF_PRIORITY 0)

    ; Write every other checked device as a DHCP definition, but leave IFNAME
    ; on the deterministic primary afterwards: S:Network-Startup deliberately
    ; starts one named interface, never every file in the drawer.  A static
    ; address entered above belongs to the primary only; copying it would put
    ; duplicate addresses on the wire as soon as both cards came online.
    (set WARN_DRIVER 0)
    (set CARD_INDEX 0)
    (while (< CARD_INDEX 14)
      (
        (if (AND (<> CARD_INDEX PRIMARY_INDEX)
                 (> (bitand CARD_MASK (shiftleft 1 CARD_INDEX)) 0))
          (
            (P_prepare_card)
            (set IFNAME DEFAULT_IF)
            (set USEDHCP 1)
            (set WANTMDNS 0)
            ; An Expert may have named the primary like this one: the file
            ; just written stays.
            ; patmatch, not =: AmigaDOS names ignore case.
            (if (NOT (patmatch PRIMARY_IF IFNAME)) (P_write_interface))
          ))
        (set CARD_INDEX (+ CARD_INDEX 1))
      ))
    (set IFNAME PRIMARY_IF)
    (set USEDHCP PRIMARY_DHCP)

    ; --- the default route ---------------------------------------------

    (textfile
      (prompt "Writing DEVS:Internet/routes")
      (help   "This file holds the default route.  The default route is "
              "the address of the router that receives everything that is "
              "not on the local network.")
      (dest   (tackon D_DEVS "Internet/routes"))
      (append "; DEVS:Internet/routes -- written by the AmiNetXDuo installer.\n")
      (append ";\n")
      (append "; DEFAULT=<address>   the router everything else goes through.\n")
      (append "; DST=<net> VIA=<gw>  a route to one particular network.\n")
      (append ";\n")
      (append "; With CONFIGURE=DHCP the router's address arrives with the\n")
      (append "; lease, so no DEFAULT line is needed here.\n")
      (append ";\n")
      (append (if USEDHCP
                  ";DEFAULT=192.168.1.1\n"
                  (cat "DEFAULT=" IPGW "\n")))
      (safe))

    ; --- name resolution ------------------------------------------------
    ;
    ; A name somebody set by hand in the file being replaced is theirs, at
    ; every level: InstallSameFile HOSTLINE writes the name the stack's own
    ; parser takes from the file as a hostname line, and it goes into the new
    ; file.  An Expert who types a
    ; name replaces it.
    (set NR_FILE (tackon D_DEVS "Internet/name_resolution"))
    (set NR_HOST "T:AmiNetXDuo-hostname")
    (set KEEP_HOST 0)
    (if (AND (= (strlen HOSTNAME) 0) (exists NR_FILE (noreq)))
        (if (= 0 (run ("\"%s\" \"%s\" \"%s\" HOSTLINE" S_SAMEFILE NR_FILE NR_HOST)
                      (quiet) (safe)))
            (set KEEP_HOST 1)))

    (textfile
      (prompt "Writing DEVS:Internet/name_resolution")
      (help   "This file gives the name servers to ask when a program "
              "looks up a name such as \"aminet.net\".")
      (dest   (tackon D_DEVS "Internet/name_resolution"))
      (append "; DEVS:Internet/name_resolution -- written by the AmiNetXDuo\n")
      (append "; installer.\n")
      (append ";\n")
      (append "; nameserver <address>   ask this server.  Repeat for more.\n")
      (append "; domain     <name>      added to names with no dots in them.\n")
      (append "; search     <a> <b> ..  several domains to try, in order.\n")
      (append "; hostname   <name>      what this machine calls itself.\n")
      (append ";                        Without it: amiga- and the last\n")
      (append ";                        three octets of the card's address.\n")
      (append ";\n")
      (append "; With CONFIGURE=DHCP the name servers arrive with the lease,\n")
      (append "; so no nameserver line is needed here.\n")
      (append ";\n")
      (append (if USEDHCP
                  ";nameserver 192.168.1.1\n"
                  (cat "nameserver " IPDNS "\n")))
      (append (if (> (strlen HOSTNAME) 0)
                  (cat "hostname " HOSTNAME "\n")
                  (if KEEP_HOST "" ";hostname amiga\n")))
      (safe))
    (if KEEP_HOST
        (run ("Type %s >>\"%s\"" NR_HOST NR_FILE)
             (prompt "Keeping the name set in DEVS:Internet/name_resolution")
             (help   H_HOSTNAME)
             (safe)))
    (if (exists NR_HOST (noreq))
        (delete NR_HOST
                (prompt ("Removing %s" NR_HOST))
                (help   H_HOSTNAME)
                (optional "force" "nofail")
                (safe)))
  ))

