(set OSVER (/ (getversion) 65536))

(if (< OSVER 37)
    (abort "AmiNetXDuo needs AmigaOS 2.04 (Kickstart 37) or newer.\n\n"
           "This machine has Kickstart " OSVER ".\n\n"
           "Nothing was changed."))

; --- one library, every processor -----------------------------------------
;
; THERE IS NOTHING TO PICK HERE ANY MORE, and that is the point.  The archive
; used to carry three builds of bsdsocket.library -- Libs/68000, Libs/68020-40,
; Libs/68060 -- and this is where `database "cpu"` chose between them.  Every
; binary in the archive now runs on every 68k and chooses its own inner loops
; from SysBase->AttnFlags when the library opens, so a 68000 and a 68060 install
; the same file and each gets the code written for it.
;
; What that removes is the failure this section was built around: an owner who
; picked the low drawer to be safe got a library with none of the faster
; assembly in it, and on the encryption that was not a few percent.  Nobody can
; pick wrong now.
;
; Libs/minimal is still a drawer, and still a question further down, because it
; is a FEATURE choice -- no IPv6, no .local names, no packet filter, no
; encryption. MINPICK, not CPUPICK; installed RAM selects its default below.
(set MINPICK 0)

; The fat stack (MINPICK 3) is the one exception: 68020 code.
(set CPU_NAME (database "cpu"))
(set CPU020 (if (OR (= CPU_NAME "68000") (= CPU_NAME "68010")) 0 1))

(if (NOT (exists (tackon S_LIBS "bsdsocket.library") (noreq)))
    (abort "This archive has no Libs/bsdsocket.library.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing was changed."))

; --- and the driver, checked HERE rather than where it is copied ---------
;
; Section 5 offers the three drivers in Devs/Networks.  Whether they go on is a
; QUESTION, below; whether the archive has one is not, and a missing one is the
; same incomplete download as a missing library.  So it is refused in the same
; place and the same way -- before the welcome, before anything on the disk has
; been touched -- rather than halfway through with LIBS: already replaced, and
; rather than quietly turning into "there was nothing to install".
;
; Checked at all because the failure the section below exists for is silence.
; The driver was in every archive and in no installation for eleven releases,
; so a machine kept whatever anxnet.device it already had; an existence test
; that skipped the copy without a word would be the same defect wearing a
; guard.
(set S_ANXNET   (tackon (tackon S_DEVS "Networks") "anxnet.device"))
(set S_ANXGENET (tackon (tackon S_DEVS "Networks") "anxgenet.device"))
(set S_ANXWIFIPI (tackon (tackon S_DEVS "Networks") "anxwifipi.device"))
(set S_ANXZZ9000 (tackon (tackon S_DEVS "Networks") "anxzz9000.device"))

(if (NOT (exists S_ANXNET (noreq)))
    (abort "This archive has no Devs/Networks/anxnet.device.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing was changed."))
(if (NOT (exists S_ANXGENET (noreq)))
    (abort "This archive has no Devs/Networks/anxgenet.device.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing was changed."))
(if (NOT (exists S_ANXWIFIPI (noreq)))
    (abort "This archive has no Devs/Networks/anxwifipi.device.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing was changed."))
(if (NOT (AND (AND (exists S_WM (noreq)) (exists S_WMLIC (noreq)))
              (exists S_INSTWIFI (noreq))))
    (abort "This archive has no Wireless/WirelessManager, its licence or "
           "InstallWiFi.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing was changed."))
; External drivers are complete distributions, including offline source.
(set PC_N 0)
(while (set PC_F (select PC_N "xircomce2.device" "pccard.library"
                            "Docs/GPL" "Docs/LGPL"
                            "Docs/Xircom.guide" "Docs/PCCard.guide"
                            "Sources/xircomce2.lha" "Sources/pccard.lha"
                            "README" ""))
  (
    (if (NOT (exists (tackon S_PCMCIA PC_F) (noreq)))
        (abort (cat "This archive has no PCMCIA/" PC_F ".\n\n"
                    "The driver, its licences and source must travel together. "
                    "Nothing was changed.")))
    (set PC_N (+ PC_N 1))
  ))

; anxzz9000.device is optional: an archive built without
; -DAMINETXDUO_ZZ9000=ON does not carry it (CMakeLists.txt), and a ZZ9000
; is then driven only by MNT's own ZZ9000Net.device.
(set HAVE_ANXZZ9000 (if (exists S_ANXZZ9000 (noreq)) 1 0))
(if (NOT (exists S_NETPROBE (noreq)))
    (abort "This archive has no InstallNetProbe.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
