; Nothing changes for a novice install.  At NOVICE every ask... returns its
; (default) without showing anything, so the detected build is still what
; goes on -- which is why the default has to be independently correct.
(set CPUPICK
  (askchoice
    (prompt "Which build of the network library should be installed?\n\n")
    (help "Every build does the same things at the same time; they differ "
          "only in which processor instructions they were compiled for. The "
          "one for this machine is already selected.\n\n"
          "Pick another when the disk is going into a different machine "
          "than the one it is being installed on.\n\n"
          "The 68000 build runs on every Amiga, including an 020 or better. "
          "It is the safe answer for a disk that moves around.\n\n"
          "The minimal build is the 68000 one with IPv6, .local name "
          "lookups, the packet filter, encrypted connections and IPv4 "
          "multicast left out. It is about 104 KB smaller, which is worth "
          "having on a 1 MB machine and worth nothing on a larger one.\n\n"
          "Encrypted (https:) connections need a 68020 or better whichever "
          "build is chosen: the cryptography takes longer than the other end "
          "will wait on a 68000.")
    ; 22 characters is the limit -- install/tools/checkscript.py enforces it,
    ; because a longer gadget is dropped from the page without a word. So the
    ; two omissions a user is most likely to miss go here and the full list is
    ; in the help above, and in the message after installing.
    (choices "68000, no IPv6/https:"
             "68000, everything"
             "68020 to 68040"
             "68060")
    (default CPUPICK)))

(if (= CPUPICK 0) (set CPUDIR "68000-minimal"))
(if (= CPUPICK 1) (set CPUDIR "68000"))
(if (= CPUPICK 2) (set CPUDIR "68020-40"))
(if (= CPUPICK 3) (set CPUDIR "68060"))

; From the base again, not from the detected path -- the answer above may not
; be the machine's own build, which is the point of asking.  The drawer is
; checked here as well as earlier: the first check was that the archive has
; something for THIS machine, and this one is that it has what was asked for.
(set S_LIBS (tackon S_LIBSBASE CPUDIR))

(if (NOT (exists (tackon S_LIBS "bsdsocket.library") (noreq)))
    (abort "This archive has no Libs/" CPUDIR " drawer.\n\n"
           "The download is incomplete, or was unpacked with a tool that "
           "dropped the subdrawers.\n\n"
           "Nothing has been changed."))

; --- where the drawer of documentation goes ------------------------------

(set DOCPARENT
  (askdir
    (prompt "Where should the \"AmiNetXDuo\" drawer go?\n\n"
            "It holds the documentation and the examples.")
    (help H_DOCDIR)
    (default @default-dest)))

(set DOCDIR (tackon DOCPARENT "AmiNetXDuo"))

; A novice run makes no decisions of its own, so with nothing detected and no
; existing configuration to keep, there is no honest default to fall back on.
;
; AFTER THE WELCOME, and that is the whole point. This used to sit up in the
; detection section, which runs before (welcome) -- so it fired on the level
; the icon happened to default to, the welcome page never appeared, and its own
; advice to "start this installer again and choose Intermediate User" named a
; page the user had never been shown and could not reach. Reported as "the
; warning is the first thing I see and I cannot select mode", with a screenshot
; of exactly that.
;
; Here, @user-level is what the user picked, so a novice who wants the card
; question can simply pick another level on the page they have just seen.

(if (AND (= @user-level 0) (AND (< DET_INDEX 0) (= HAVE_OLD 0)))
    (abort "The installer could not find a network card driver in DEVS: or "
           "DEVS:Networks, and in Novice mode it cannot ask which card is "
           "installed.\n\n"
           "Either copy the card's .device driver into DEVS: first, or start "
           "this installer again and choose \"Intermediate User\", which "
           "lets the card be picked from a list.\n\n"
           "Nothing has been changed."))

; --- keep or replace an existing configuration ---------------------------

(set KEEP_OLD 0)

(if HAVE_OLD
    (set KEEP_OLD
      (askbool
        (prompt (F_KEEPOLD OLD_IF))
        (help H_KEEPOLD)
        (choices "Keep them" "Set them up again")
        (default 1))))

; Kept settings are not checked, and saying so is the only honest option.
;
; Everything below -- the card question, and with it the warning that the named
; driver is not in DEVS: or DEVS:Networks -- is inside (= KEEP_OLD 0). So an
; interface file that survives from an earlier install goes untouched and
; unexamined, and a driver that has since been removed is never noticed.
;
; It cannot be examined: the Installer language cannot read the DEVICE= line
; back out of the file, so there is no name to look for. Reported by a user who
; took the drivers away, installed again and was told nothing.
(if (AND HAVE_OLD KEEP_OLD)
    (message
      "The existing settings for \"" OLD_IF "\" are being kept as they are.\n\n"
      "They are not checked -- if the card or its driver has changed since "
      "they were written, the network will not come up.  Installing again and "
      "choosing \"Set them up again\" asks the questions afresh."))

; --- the card ------------------------------------------------------------

(set IFNAME  "eth0")
(set DEVUNIT 0)
(set USEDHCP 1)
(set WANTMDNS 0)

(if (= KEEP_OLD 0)
  (
    (set CARD
      (askchoice
        (prompt "Which network card does this Amiga have?")
        (help   H_CARD)
        ; Short labels are not a style choice.  The Installer lays a radio
        ; page out into whatever room is left after the prompt and the
        ; buttons, and when the choices do not fit it silently creates
        ; fewer gadgets than there are choices -- after which
        ; default_radio() marks a gadget that is not there, final_radio()
        ; finds nothing selected, and the whole installation dies on
        ; "askchoice: No choices selected".  Two columns of four fit; the
        ; full product names do not.  Keep every label under about 20
        ; characters and put the detail in the help text.
        (choices
          "A2065"
          "Ariadne"
          "Ariadne II"
          "AmigaNet"
          "X-Surf"
          "X-Surf 100"
          "PCMCIA"
          "UAE"
          "Other")
        (default CARD_DEFAULT)))

    (set DEV_NAME
      (select CARD
        "a2065.device"
        "ariadne.device"
        "ariadne2.device"
        "amiganet.device"
        "xsurf.device"
        "xsurf100.device"
        "cnet.device"
        "uaenet.device"
        ""))

    ; PCMCIA: one more question, because the slot takes several kinds of card
    (if (= CARD 6)
      (
        (set PCM
          (askchoice
            (prompt "Which PCMCIA card is it?")
            (help   H_PCMCIA)
            (choices
              "NE2000 or CNet"
              "3Com 3C589"
              "Prism2 wireless"
              "Something else")
            (default 0)))

        (set DEV_NAME
          (select PCM
            "cnet.device"
            "etherlink3.device"
            "prism2.device"
            ""))
      ))

    ; "not in this list", or "something else" above: ask for the name
    (if (= (strlen DEV_NAME) 0)
      (
        (set DEV_OK 0)
        (until DEV_OK
          (set DEV_NAME (askstring
            (prompt "Type the file name of the card's driver, ending "
                    "in \".device\".")
            (help   H_OTHERDEV)
            (default "mycard.device")))
          (set DEV_OK (if (= @user-level 0) 1
                        (if (> (strlen DEV_NAME) 0) 1 0))))
      ))

    (set dev_name DEV_NAME)
    (P_dev_path)
    (set DEV_WRITE dev_write)

    (if (= dev_present 0)
        (message (F_NODEV DEV_NAME)
                 (help H_CARD)))

    ; --- unit and interface name: only an expert is asked ---------------

    (if (= @user-level 2)
      (
        (set DEVUNIT
          (asknumber
            (prompt ("Which unit of %s?" DEV_NAME))
            (help   H_UNIT)
            (range 0 15)
            (default 0)))

        (set IF_OK 0)
        (until IF_OK
          (set IFNAME (askstring
            (prompt "What should this interface be called?")
            (help   H_IFNAME)
            (default "eth0")))
          (set IF_OK (if (AND (> (strlen IFNAME) 0)
                              (<= (strlen IFNAME) 15)) 1 0))
          (if (= IF_OK 0)
              (message "An interface name must be between 1 and 15 "
                       "characters long."
                       (help H_IFNAME))))
      ))

    ; --- automatic or manual addressing --------------------------------

    ; Inverted for the reason spelled out at DO_HTTPD below: askbool returns 1
    ; for the first (choices) string.  Written as "No" first with (default 0)
    ; this said MDNS=YES to everyone who clicked "No" and MDNS=NO to everyone
    ; who clicked "Yes"; only a NOVICE run, which takes the (default) and never
    ; draws the page, came out right.
    (set WANTMDNS
      (if (askbool
            (prompt "Answer .local names on the network?")
            (help    H_MDNS)
            (choices "No" "Yes")
            (default 1))
          0 1))

    (set USEDHCP
      (askbool
        (prompt "Does the network hand out addresses automatically?\n\n"
                "If other computers just plug in and work, it does.")
        (help    H_DHCP)
        (choices "Yes, use DHCP" "No, I will type them")
        (default 1)))
  ))

; --- the manual addresses ------------------------------------------------

(set IPADDR "192.168.1.10")
(set IPMASK "255.255.255.0")
(set IPGW   "192.168.1.1")
(set IPDNS  "192.168.1.1")

(if (AND (= KEEP_OLD 0) (= USEDHCP 0))
  (
    (set ask_prompt "What Internet address should this Amiga use?")
    (set ask_help   H_ADDR)
    (set ask_default IPADDR)
    (P_ask_ip)
    (set IPADDR ask_result)

    (set ask_prompt "What is the netmask for this network?")
    (set ask_help   H_MASK)
    (set ask_default IPMASK)
    (P_ask_ip)
    (set IPMASK ask_result)

    ; the router is nearly always <this network>.1, so offer that
    (set ip_in IPADDR)
    (P_ip_parse)
    (set IPGW ("%ld.%ld.%ld.1" ip_o1 ip_o2 ip_o3))

    (set ask_prompt "What is the address of the router (the gateway)?")
    (set ask_help   H_GW)
    (set ask_default IPGW)
    (P_ask_ip)
    (set IPGW ask_result)

    (set ask_prompt "Which name server should this Amiga use?")
    (set ask_help   H_DNS)
    (set ask_default IPGW)
    (P_ask_ip)
    (set IPDNS ask_result)
  ))

; --- the host name -------------------------------------------------------

(set HOSTNAME "amiga")

(if (= KEEP_OLD 0)
    (set HOSTNAME
      (askstring
        (prompt "What should this Amiga be called on the network?")
        (help   H_HOSTNAME)
        (default "amiga"))))

; --- replacing another stack's library -----------------------------------

(set REPLACE_LIB 1)

(if OLD_BSD
    (set REPLACE_LIB
      (askbool
        (prompt (F_OLDLIB OLD_BSD_VER))
        (help    H_REPLACELIB)
        (choices "Replace it" "Leave it alone")
        (default 1))))

(if (= REPLACE_LIB 0)
    (abort "Left LIBS:bsdsocket.library alone, so AmiNetXDuo has not been "
           "installed.\n\n"
           "Nothing has been changed."))

; --- start the network at boot? ------------------------------------------

(set DO_STARTUP
  (askbool
    (prompt "Start the network automatically when this Amiga boots?")
    (help    H_STARTUP)
    (choices "Yes, at boot" "No, I will do it")
    (default 1)))

; --- serve a drawer, and a Shell in a browser, at boot? ------------------
;
; DEFAULTS TO NO, and that is not timidity.  Every other question here has an
; answer that is right for almost everybody, which is what makes NOVICE mode
; work; this one does not.  A drawer served read-write and a Shell with no
; password are a fine thing to switch on deliberately and not a thing to hand
; to somebody who pressed Return through an installer, so the default is the
; answer that changes nothing.
;
; Only asked when the network starts at boot.  The lines go into the same
; managed block, immediately after AddNetInterface, and a server started at
; boot on a machine that was told not to bring the network up at boot is a
; contradiction rather than a configuration.  Answering no to the question
; above therefore also takes these lines away, because the whole block is
; rewritten either way.

(set DO_HTTPD   0)
(set HTTPD_ROOT "RAM:")
(set HTTPD_PORT 80)

(if DO_STARTUP
  (
    ; askbool returns 1 for the FIRST (choices) string and 0 for the second,
    ; whatever the two say.  A question whose answer is no by default
    ; therefore puts "No" first, defaults to 1, and inverts here -- which also
    ; keeps the property the whole script has and install/test/installdrive.c
    ; relies on: the first button on a page IS that page's default.
    (set DO_HTTPD
      (if (askbool
            (prompt "Serve a drawer, and an AmigaDOS Shell in a web browser, "
                    "when this Amiga boots?\n\n"
                    "Neither has a password: whoever can reach the port gets "
                    "both.")
            (help    H_HTTPD)
            (choices "No" "Yes, serve them")
            (default 1))
          0 1))

    (if DO_HTTPD
      (
        (set HTTPD_ROOT
          (askdir
            (prompt "Which drawer should be served?\n\n"
                    "Everything in it can be read, changed and deleted from "
                    "the network.")
            (help    H_HTTPDROOT)
            (default "RAM:")))

        (set HTTPD_PORT
          (asknumber
            (prompt "Which port should it listen on?")
            (help    H_HTTPDPORT)
            (range   1 65535)
            (default 80)))
      ))
  ))

(complete 10)

; ==========================================================================
;  5.  Copy the software
; ==========================================================================

(set @default-dest DOCDIR)

; --- the libraries -------------------------------------------------------
;
; A running stack holds LIBS:bsdsocket.library open and the copy then fails
; with a DOS error that means nothing to a novice.  @special-msg puts the
; explanation in front of it.

(set @special-msg
  (cat "If this failed because the file is in use, the network is already "
       "running.  Reboot and run this installer again before doing anything "
       "else.\n"))

(if OLD_BSD
  (
    (if (exists "LIBS:bsdsocket.library.old" (noreq))
        (delete "LIBS:bsdsocket.library.old"
                (prompt "Removing the previous LIBS:bsdsocket.library.old")
                (help @copyfiles-help)
                (optional "force" "nofail")))
    (rename "LIBS:bsdsocket.library" "LIBS:bsdsocket.library.old"
            (prompt "Renaming the old LIBS:bsdsocket.library out of the way")
            (help H_REPLACELIB))
  ))

(if OLD_UG
  (
    (if (exists "LIBS:usergroup.library.old" (noreq))
        (delete "LIBS:usergroup.library.old"
                (prompt "Removing the previous LIBS:usergroup.library.old")
                (help @copyfiles-help)
                (optional "force" "nofail")))
    (rename "LIBS:usergroup.library" "LIBS:usergroup.library.old"
            (prompt "Renaming the old LIBS:usergroup.library out of the way")
            (help H_REPLACELIB))
  ))

(working "Installing the libraries")

(copylib
  (prompt (cat "Installing bsdsocket.library into LIBS:\n\n"
               "This is the build for a " CPU "."))
  (help   @copylib-help)
  (source (tackon S_LIBS "bsdsocket.library"))
  (dest   "LIBS:")
  (confirm)
  (optional "force"))

(copylib
  (prompt "Installing usergroup.library into LIBS:")
  (help   @copylib-help)
  (source (tackon S_LIBS "usergroup.library"))
  (dest   "LIBS:")
  (confirm)
  (optional "force"))

; --- tls.library, if this archive has one --------------------------------
;
; Only a build made with -DAMINETXDUO_TLS=ON carries it, so its absence is
; normal rather than an error.  It ships as a PAIR with the bsdsocket.library
; beside it: the two share a private interface, so installing one without the
; other, or mixing versions from different archives, is not supported.

(if (exists (tackon S_LIBS "tls.library") (noreq))
  (
    ; Replace tls.library the same way bsdsocket.library is -- rename the old
    ; one aside first -- rather than leaving it to copylib's version check.
    ; copylib copies only when the source romtag is NEWER, so an old
    ; tls.library whose version never moved would be left in place beside a
    ; freshly installed bsdsocket.library: exactly the mismatched pair the note
    ; above rules out, and how a stale CBC-only TLS survived a stack upgrade.
    ; Renaming aside also lets the copy succeed when the library is held open.
    (if OLD_TLS
      (
        (if (exists "LIBS:tls.library.old" (noreq))
            (delete "LIBS:tls.library.old"
                    (prompt "Removing the previous LIBS:tls.library.old")
                    (help @copyfiles-help)
                    (optional "force" "nofail")))
        (rename "LIBS:tls.library" "LIBS:tls.library.old"
                (prompt "Renaming the old LIBS:tls.library out of the way")
                (help H_REPLACELIB))
      ))
    (copylib
      (prompt (cat "Installing tls.library into LIBS:\n\n"
                   "This lets programs make encrypted (https:) connections.  "
                   "It is used only by programs that ask for it, so it costs "
                   "nothing until something opens it."))
      (help   @copylib-help)
      (source (tackon S_LIBS "tls.library"))
      (dest   "LIBS:")
      (confirm)
      (optional "force"))
  ))

; A 68000 gets no tls.library, and saying nothing would leave the one machine
; that cannot have it wondering why https: does not work.  Not an error, and
; not a question -- the rest of the installation is unaffected.
(if (NOT (exists (tackon S_LIBS "tls.library") (noreq)))
    (if (= CPUDIR "68000-minimal")
        ; Chosen, not imposed -- and worth restating, because what the smallest
        ; build leaves out is easy to pick in one screen and be surprised by
        ; later.
        (message
          "The smallest build was chosen, so several things are not "
          "installed: encrypted (https:) connections, ssh, IPv6, .local name "
          "lookups, the packet filter and IPv4 multicast.\n\n"
          "The stack, the commands and ordinary http: work normally.  "
          "Installing again and choosing another build brings the rest back.")
        (message
          "Encrypted (https:) connections are not installed: this build "
          "carries no tls.library.\n\n"
          "Everything else -- the stack, the commands, ordinary http:, ssh -- "
          "works normally.  Installing again and choosing another build "
          "brings https: back.")))

(set @special-msg "")

(complete 35)

; --- the commands --------------------------------------------------------

(working "Installing the network commands")

(copyfiles
  (prompt "Installing the network commands into C:")
  (help   "AddNetInterface, Online and Offline bring an interface up and "
          "take it down, and NetSetup writes or edits the interface file "
          "instead.  ConfigureNetInterface changes the address, netmask and "
          "gateway of an interface that is already running, and releases or "
          "renews its DHCP lease.  hostname says what this machine calls "
          "itself and which of the four places that can name it did so, and "
          "sets the name.  ShowNetStatus and netstat report what it is "
          "doing, and ShowNetServices lists what else on the local network "
          "is offering something.  ping, host and traceroute are the usual diagnostics, and "
          "nslookup asks the DNS for one kind of record -- an MX, a TXT, an "
          "SRV -- from a named server, and arp lists which "
          "machines on this network have answered.  "
          "fetch retrieves an http:// or https:// URL; nc, telnet and "
          "tftp are netcat and the usual clients; sntp sets the clock from "
          "a time server and whois asks who owns a name.  NetTrace captures "
          "packets to a .pcap file, and CheckNetConfig reads the "
          "configuration back and says what is wrong with it.  httpd serves "
          "a drawer over HTTP and WebDAV to other machines on the network, "
          "and asks for no password, so give it a drawer you are content for "
          "them to read and write.\n\nAll of "
          "them are installed: they are small, and missing the one command "
          "that turns out to be wanted is worse than a few extra files "
          "in C:.  ssh is installed separately, just after these, because "
          "it is the one command with a build per processor.")
  (source S_C)
  (dest   "C:")
  (pattern "~(ssh.#?)")
  (optional "force"))

; Dropbear comes from clients/ rather than the CMake tree, so it is built once
; per architecture: the archive carries ssh.000, ssh.020 and ssh.060 beside
; the other commands and this copies the one for this machine to C:ssh.  The
; pattern above keeps the suffixed set itself out of C:; only the copy under
; the plain name lands.
;
; A 68000 gets one too.  It is slower there, which is not a reason to leave
; it out: the machine that can run it should have it.
(set SSHFILE "")
(if (= CPUDIR "68000")    (set SSHFILE "ssh.000"))
(if (= CPUDIR "68020-40") (set SSHFILE "ssh.020"))
(if (= CPUDIR "68060")    (set SSHFILE "ssh.060"))

(if (> (strlen SSHFILE) 0)
    (if (exists (tackon S_C SSHFILE) (noreq))
        (copyfiles
          (prompt "Installing ssh into C:")
          (help   "Dropbear's dbclient, the SSH client.  It brings its own "
                  "argument handling and its own 256 KB stack, but wants "
                  "mathieeedoubbas.library in LIBS:, which every Workbench "
                  "installation has.  There is one build per processor and "
                  "this is the one for yours.")
          (source  (tackon S_C SSHFILE))
          (dest    "C:")
          (newname "ssh")
          (optional "force" "nofail"))))

(complete 55)

; ==========================================================================
;  6.  Configuration
; ==========================================================================

(makedir "DEVS:NetInterfaces"
  (prompt "Creating DEVS:NetInterfaces, the drawer that describes the "
          "network cards")
  (help   @makedir-help))

(makedir "DEVS:Internet"
  (prompt "Creating DEVS:Internet, the drawer that holds the name server "
          "and routing settings")
  (help   @makedir-help))

; --- the interface file --------------------------------------------------

(if (= KEEP_OLD 0)
  (
    (working "Writing the network configuration")

    (textfile
      (prompt ("Writing DEVS:NetInterfaces/%s" IFNAME))
      (help   "This file describes one network card: which driver to open, "
              "and how the card gets its Internet address.  Its name is the "
              "interface's name.")
      (dest   (tackon "DEVS:NetInterfaces" IFNAME))
      (append "; DEVS:NetInterfaces/" IFNAME " -- written by the AmiNetXDuo "
              "installer.\n")
      (append ";\n")
      (append "; The name of this file is the name of the interface.  Use it\n")
      (append "; with the network commands:\n")
      (append ";\n")
      (append ";     Online " IFNAME "\n")
      (append ";     Offline " IFNAME "\n")
      (append ";     ShowNetStatus INTERFACE " IFNAME "\n")
      (append ";\n")
      (append "; DEVICE     the SANA-II driver for the card.  A bare name is\n")
      (append ";            looked up in DEVS:; a path is used as given.\n")
      (append "; UNIT       which card, when one driver has several.\n")
      (append "; CONFIGURE  how the address is obtained:\n")
      (append ";              DHCP   -- ask the network (what most want)\n")
      (append ";              AUTO   -- self-assign 169.254.x.x if no DHCP\n")
      (append ";              STATIC -- use the ADDRESS/NETMASK below\n")
      (append ";            Note this keyword is CONFIGURE, not IPTYPE.  In\n")
      (append ";            Roadshow IPTYPE is the SANA-II packet type, a\n")
      (append ";            number, and defaults to 2048.\n")
      (append ";\n")
      (append "; MDNS=  YES -- answer .local queries on this interface\n")
      (append ";        NO  -- do not, which is the default when the\n")
      (append ";               keyword is absent.  The responder costs\n")
      (append ";               real time on a slow machine whether or\n")
      (append ";               not anything asks it anything.\n")
      (append ";\n")
      (append "; An IPv6 build also understands CONFIGURE6 (OFF, LINKLOCAL,\n")
      (append "; AUTO or STATIC), ADDRESS6 and GATEWAY6.  A build without\n")
      (append "; IPv6 ignores them, so they are safe to leave in place.\n")
      (append ";\n")
      (append "DEVICE=" DEV_WRITE "\n")
      (append ("UNIT=%ld\n" DEVUNIT))
      (append (if USEDHCP "CONFIGURE=DHCP\n" "CONFIGURE=STATIC\n"))
      (append (if WANTMDNS "MDNS=YES\n" "MDNS=NO\n"))
      (append (if USEDHCP
                  (cat ";ADDRESS=192.168.1.10\n;NETMASK=255.255.255.0\n")
                  (cat "ADDRESS=" IPADDR "\n" "NETMASK=" IPMASK "\n")))
      (append ";CONFIGURE6=AUTO\n")
      (safe))

    ; --- the default route ---------------------------------------------

    (textfile
      (prompt "Writing DEVS:Internet/routes")
      (help   "This file holds the default route -- the address of the "
              "router that everything not on the local network is sent to.")
      (dest   "DEVS:Internet/routes")
      (append "; DEVS:Internet/routes -- written by the AmiNetXDuo installer.\n")
      (append ";\n")
      (append "; DEFAULT=<address>   the router everything else goes through.\n")
      (append "; DST=<net> VIA=<gw>  a route to one particular network.\n")
      (append ";\n")
      (append "; With CONFIGURE=DHCP the router's address arrives with the\n")
      (append "; lease, so no DEFAULT line is needed here.\n")
      (append ";\n")
      (append (if USEDHCP
                  ";DEFAULT=192.168.1.1\n"
                  (cat "DEFAULT=" IPGW "\n")))
      (safe))

    ; --- name resolution ------------------------------------------------

    (textfile
      (prompt "Writing DEVS:Internet/name_resolution")
      (help   "This file says which name servers to ask when a program looks "
              "up a name like \"aminet.net\".")
      (dest   "DEVS:Internet/name_resolution")
      (append "; DEVS:Internet/name_resolution -- written by the AmiNetXDuo\n")
      (append "; installer.\n")
      (append ";\n")
      (append "; nameserver <address>   ask this server; repeat for more.\n")
      (append "; domain     <name>      added to names with no dots in them.\n")
      (append "; search     <a> <b> ..  several domains to try, in order.\n")
      (append "; hostname   <name>      what this machine calls itself.\n")
      (append ";\n")
      (append "; With CONFIGURE=DHCP the name servers arrive with the lease,\n")
      (append "; so no nameserver line is needed here.\n")
      (append ";\n")
      (append (if USEDHCP
                  ";nameserver 192.168.1.1\n"
                  (cat "nameserver " IPDNS "\n")))
      (append "hostname " HOSTNAME "\n")
      (safe))
  ))

; --- the netdb files, only where there is nothing already ----------------
;
; A machine that has had Roadshow or AmiTCP on it already has these, very
; likely edited.  The stack has sane built-in defaults for all four, so
; overwriting somebody's services file to gain nothing would be rude.

(if (exists "DEVS:Internet/hosts" (noreq))
    ""
    (textfile
      (prompt "Writing DEVS:Internet/hosts")
      (help   "Names the Amiga should know without asking a name "
              "server.  One address, then the name, then any nicknames.")
      (dest   "DEVS:Internet/hosts")
      (append "# DEVS:Internet/hosts -- names this machine knows by itself.\n")
      (append "#\n")
      (append "#   <address>  <name>  [nickname ...]\n")
      (append "#\n")
      (append "127.0.0.1\tlocalhost loopback\n")
      (safe)))

(set NDB_N 0)
(while (set NDB_F (select NDB_N "protocols" "services" "networks" ""))
  (
    (if (exists (tackon "DEVS:Internet" NDB_F) (noreq))
        ""
        (copyfiles
          (prompt ("Installing DEVS:Internet/%s" NDB_F))
          (help   @copyfiles-help)
          (source (tackon (tackon S_DEVS "Internet") NDB_F))
          (dest   "DEVS:Internet")
          (optional "nofail")))
    (set NDB_N (+ NDB_N 1))
  ))

; --- the certificate store, if this archive has one ----------------------
;
; tls.library verifies a server's certificate chain against this file, and
; refuses to connect without it.  It is ALWAYS overwritten, unlike the netdb
; files above: this is not a file anybody edits by hand, and an old one means
; sites signed by newer certificate authorities stop working.  Replacing it is
; also the whole of the update story -- the library re-reads it when its
; datestamp changes, so no reboot is needed.

(if (exists (tackon (tackon S_DEVS "Internet") "certificates") (noreq))
    (copyfiles
      (prompt (cat "Installing DEVS:Internet/certificates\n\n"
                   "The list of certificate authorities tls.library trusts.  "
                   "Replace this file with a newer one to "
                   "update them; nothing else has to change."))
      (help   @copyfiles-help)
      (source (tackon (tackon S_DEVS "Internet") "certificates"))
      (dest   "DEVS:Internet")
      (optional "nofail")))

(complete 75)

; ==========================================================================
;  7.  Documentation and examples
; ==========================================================================

; makedir's (infos) parameter deletes the drawer it just made if it cannot
; produce an icon for it, and takes the installation down with it.  Copying a
; real icon of our own is both safer and better looking.

(makedir DOCDIR
  (prompt ("Creating %s" DOCDIR))
  (help   H_DOCDIR))

(if (exists (if (> (strlen SRCDIR) 0)
                (tackon SRCDIR "AmiNetXDuo.info")
                "AmiNetXDuo.info") (noreq))
    (copyfiles
      (prompt "Giving the AmiNetXDuo drawer its icon")
      (help   @copyfiles-help)
      (source (if (> (strlen SRCDIR) 0)
                  (tackon SRCDIR "AmiNetXDuo.info")
                  "AmiNetXDuo.info"))
      (dest    DOCPARENT)
      (newname "AmiNetXDuo.info")
      (optional "nofail")))

(if (exists S_DOCS (noreq))
    (copyfiles
      (prompt "Installing the documentation")
      (help   @copyfiles-help)
      (source S_DOCS)
      (dest   DOCDIR)
      (all)
      (infos)
      (optional "nofail")))

(if (exists S_EXAM (noreq))
    (copyfiles
      (prompt "Installing the example configuration files")
      (help   "These are commented copies of the files this installer just "
              "wrote, one for each kind of card.  Nothing reads them where "
              "they are -- they are there to be read, and copied into DEVS: "
              "by hand where that is the preferred way to configure it.")
      (source S_EXAM)
      (dest   (tackon DOCDIR "Examples"))
      (all)
      (optional "nofail")))

; httpd's terminal page.  It goes beside the examples rather than into C: or
; DEVS: because it is neither a command nor configuration: it is a file the
; server reads and hands to a browser.  A drawer here is somewhere they can
; find it, read it and edit it -- and it is where the AmiNetXDuo: assign
; points, which is how a bare `httpd <drawer> 80 -T' finds it without being
; told.

(if (exists S_TERM (noreq))
    (copyfiles
      (prompt "Installing the terminal page for httpd")
      (help   "httpd can serve an AmigaDOS Shell to a web browser. This is the page it hands that browser: one self-contained HTML file, with nothing to fetch from anywhere else. "
              "Nothing reads it where it is until you ask for it. httpd Work:Public 80 -T is what turns the endpoint on, and without -T there is no terminal at all. "
              "Note what it is when it is on: anyone who can reach that port gets a Shell on this machine, with no password, exactly as the WebDAV write methods on the same port have none.")
      (source S_TERM)
      (dest   (tackon DOCDIR "Terminal"))
      (all)
      (optional "nofail")))

; ssh (Dropbear's dbclient) rides into C: with the other network commands
; above -- the argv/stack shim gives it a real argv[] and its own 256 KB
; stack, so it no longer needs the separate drawer and the `stack 200000`
; ritual the ported clients once did.

(complete 90)

; ==========================================================================
;  8.  S:User-Startup
; ==========================================================================

(set START_IF (if KEEP_OLD OLD_IF IFNAME))

; One string, however many lines are in it.  (startup) replaces everything
; between its two markers, so the block is always written whole and there is
; no case where a second run leaves a line from the first one behind: an httpd
; line appears because DO_HTTPD is true on THIS run, and goes away because it
; is not.
;
; `Run >NIL: <NIL:' and not a bare command: httpd does not return, and a boot
; that reaches it without Run stops there. The redirections detach it from the
; startup Shell's console, which would otherwise keep that Shell alive.
;
; The assign is what lets the httpd line be short enough to be worth reading.
; httpd looks for its page in AmiNetXDuo:Terminal/terminal.html, among two
; other places (src/tools/httpd.c httpd_term_places[]), and the drawer this
; installer put the page in is wherever the user said, so the assign is the
; only stable name for it.

(set BOOT_CMD ("C:AddNetInterface DEVS:NetInterfaces/%s QUIET\n" START_IF))

(if DO_HTTPD
    (set BOOT_CMD
      (cat BOOT_CMD
           ("Assign AmiNetXDuo: \"%s\"\n" DOCDIR)
           ("Run >NIL: <NIL: C:httpd \"%s\" %ld -T\n" HTTPD_ROOT HTTPD_PORT))))

(if DO_STARTUP
    (startup APPNAME
      (prompt "Adding AmiNetXDuo to S:User-Startup, so that the network "
              "starts when the Amiga boots.")
      (help   H_STARTUP)
      (command BOOT_CMD))
    (startup APPNAME
      (prompt "Removing AmiNetXDuo's lines from S:User-Startup, so that the "
              "network does not start by itself.")
      (help   H_STARTUP)))

(complete 100)

; ==========================================================================
;  9.  Done
; ==========================================================================

(if DO_STARTUP
    (set FINAL_START (F_START_YES START_IF))
    (set FINAL_START (F_START_NO  START_IF)))

; Said again on the last page, and deliberately.  The question that turned it
; on was one of a dozen; this is the sentence somebody reads after the fact and
; realises what is now running.
(set FINAL_HTTPD "")

(if DO_HTTPD
    (set FINAL_HTTPD (F_HTTPD HTTPD_ROOT HTTPD_PORT)))

; The 68000 https:// notice used to be here, and it is not any more.  A user
; who never types an https: URL was being warned about something that would
; never affect them, on the one page they read once; and the user who DOES
; type one is told by `fetch' itself, at the moment it matters, in words that
; fit their machine.  fetch tests AttnFlags for exactly this.
; The version is on the last screen as well as the first.  The welcome is
; gone by the time anything has been written, and this is the line that stays
; up -- and the one a user quotes when reporting something.  Every installed
; file answers `Version' with the same number, so the two agree.
(exit
  "AmiNetXDuo " VERSION_STR " is installed.\n\n"
  FINAL_START
  FINAL_HTTPD
  "\nShowNetStatus reports whether it came up.  The ReadMe in the "
  "AmiNetXDuo drawer covers the rest.  Version, on any of the installed "
  "files, reports " VERSION_STR " as well.\n")
