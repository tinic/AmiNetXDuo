;
; DEVS:NetInterfaces/eth0 -- a fixed address, worked through
;
; Use this shape when nothing on the network hands out addresses, or when
; the address is assigned by whoever runs the network and must not change.
;
; Copy this into DEVS:NetInterfaces as "eth0", change the four numbers, and
; read "routes" and "name_resolution" in the Internet drawer next door.
; With a fixed address the router and the name server must be given by
; hand, because there is no DHCP lease to carry them.
;

DEVICE=a2065.device
UNIT=0

CONFIGURE=STATIC

; ADDRESS -- this machine.  It must not be in use by anything else, and it
; must be on the same network as the router.  The three "private" ranges,
; which is what a home network uses, are
;
;     10.x.x.x            192.168.x.x            172.16.x.x - 172.31.x.x
;
; With a router at 192.168.1.1, the address is 192.168.1.<n>, where <n> is
; between 2 and 254 and no other machine already has it.
;
ADDRESS=192.168.1.10

; NETMASK -- which part of the address is the network.  255.255.255.0 says
; "the first three numbers are the network, the last one is the machine",
; which is correct for almost every home network.
;
NETMASK=255.255.255.0

; The router does not go here.  It goes in DEVS:Internet/routes, as
;
;     DEFAULT=192.168.1.1
;
; and the name server goes in DEVS:Internet/name_resolution, as
;
;     nameserver 192.168.1.1
;
; A GATEWAY= line here is accepted as an alternative, but the default route
; belongs in the routes file.
