;
; DEVS:NetInterfaces/eth0 -- PCMCIA Ethernet in an A600 or A1200 card slot
;
; Copy this into DEVS:NetInterfaces and call the copy "eth0", then
; either reboot or type
;
;     C:AddNetInterface DEVS:NetInterfaces/eth0
;
; The file name is the interface name.  There is no NAME= keyword.
; See the file "eth0" in this drawer for every keyword there is.
;
; cnet.device drives NE2000-compatible PCMCIA cards, which is most of
; them.  Two other PCMCIA drivers are in use:
;
;     etherlink3.device   3Com EtherLink III / 3C589
;     prism2.device       Prism2 wireless cards
;
; On some accelerators the PCMCIA slot and an A1200 with more than 4 MB
; of fast RAM contend for the same address space.  That is a hardware
; problem, not a stack problem, and the driver then does not open at
; all.
;

DEVICE=cnet.device
UNIT=0

; Ask the network for an address.  If nothing on the network hands
; out addresses, change this to STATIC and fill in ADDRESS/NETMASK
; below.  See "eth0-static" for a worked example.
CONFIGURE=DHCP

;ADDRESS=192.168.1.10
;NETMASK=255.255.255.0
