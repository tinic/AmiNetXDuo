;
; DEVS:NetInterfaces/eth0 -- PCMCIA Ethernet in an A600 or A1200 card slot
;
; Copy this into DEVS:NetInterfaces and call the copy "eth0", then
; either reboot or type
;
;     C:AddNetInterface DEVS:NetInterfaces/eth0
;
; The file name is the interface name; there is no NAME= keyword.
; See the file "eth0" in this drawer for every keyword there is.
;
; cnet.device drives NE2000-compatible PCMCIA cards, which is most of
; them.  Two other PCMCIA drivers turn up:
; 
;     etherlink3.device   3Com EtherLink III / 3C589
;     prism2.device       Prism2 wireless cards
; 
; Note that the PCMCIA slot and an A1200 with more than 4 MB of fast
; RAM fight over the same address space on some accelerators.  That is
; a hardware problem, not a stack problem, and it shows up as the
; driver failing to open at all.
;

DEVICE=cnet.device
UNIT=0

; Ask the network for an address.  Change to STATIC and fill in
; ADDRESS/NETMASK below if nothing on your network hands out
; addresses -- and see "eth0-static" for a worked example.
CONFIGURE=DHCP

;ADDRESS=192.168.1.10
;NETMASK=255.255.255.0
