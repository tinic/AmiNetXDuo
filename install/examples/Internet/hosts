#
# DEVS:Internet/hosts
#
# Names this Amiga knows without asking a name server.  The standard /etc
# layout: an address, the real name, then any number of nicknames.
#
#     <address>   <name>   [nickname ...]
#
# '#' starts a comment.  Columns are separated by any run of spaces or tabs.
#
# The word HOST in front of the address, as AmiTCP writes it, is accepted
# too, so an AmiTCP netdb-myhost works here unchanged.
#
# If this file is absent, the stack uses a built-in table that holds only
# localhost, so the machine is never completely nameless.
#

127.0.0.1	localhost loopback

# Local machines, so they work without a name server:
#
#192.168.1.1	router gateway
#192.168.1.10	amiga
#192.168.1.20	fileserver nas
